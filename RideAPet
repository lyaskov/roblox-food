local ReplicatedStorage = game:GetService("ReplicatedStorage")

local serverData = ReplicatedStorage:FindFirstChild("ServerData") or ReplicatedStorage
local activeEggs = serverData:WaitForChild("ActiveEggs")

local function PrintAvailableEggs()
	local counts = {}

	for _, eggObject in activeEggs:GetChildren() do
		local eggName = eggObject:GetAttribute("Egg")

		if typeof(eggName) == "string" and eggName ~= "" then
			counts[eggName] = (counts[eggName] or 0) + 1
		end
	end

	print("===== Eggs In World =====")

	local names = {}
	for eggName in counts do
		table.insert(names, eggName)
	end
	table.sort(names)

	if #names == 0 then
		print("No eggs available")
	else
		for _, eggName in names do
			print(string.format("%s x%d", eggName, counts[eggName]))
		end
	end

	print("=========================")
end

local updateQueued = false

local function QueuePrint()
	if updateQueued then
		return
	end

	updateQueued = true
	task.defer(function()
		updateQueued = false
		PrintAvailableEggs()
	end)
end

local function WatchEgg(eggObject)
	eggObject:GetAttributeChangedSignal("Egg"):Connect(QueuePrint)
end

for _, eggObject in activeEggs:GetChildren() do
	WatchEgg(eggObject)
end

-- Первый список выводится сразу после загрузки ActiveEggs.
PrintAvailableEggs()

-- Следующий список выводится после обновления данных с сервера.
activeEggs.ChildAdded:Connect(function(eggObject)
	WatchEgg(eggObject)
	QueuePrint()
end)
activeEggs.ChildRemoved:Connect(QueuePrint)
