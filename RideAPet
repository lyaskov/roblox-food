local ReplicatedStorage = game:GetService("ReplicatedStorage")

local serverData = ReplicatedStorage:FindFirstChild("ServerData") or ReplicatedStorage
local activeEggs = serverData:WaitForChild("ActiveEggs")
local eggCycle = require(ReplicatedStorage:WaitForChild("GameServices"):WaitForChild("EggCycle"))
local gameRemotes = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Game")
local shopStockRemote = gameRemotes:WaitForChild("ShopStock")
local restockRemote = gameRemotes:WaitForChild("Restock")

local function PrintAvailableEggs()
	local counts = {}

	for _, eggObject in activeEggs:GetChildren() do
		local eggName = eggObject:GetAttribute("Egg")

		if typeof(eggName) == "string" and eggName ~= "" then
			counts[eggName] = (counts[eggName] or 0) + 1
		end
	end

	print("===== Eggs In World =====")

	local names = {}
	for eggName in counts do
		table.insert(names, eggName)
	end
	table.sort(names)

	if #names == 0 then
		print("No eggs available")
	else
		for _, eggName in names do
			print(string.format("%s x%d", eggName, counts[eggName]))
		end
	end

	print("=========================")
end

local function PrintFoodStock(foodStock)
	print("========= Food =========")

	if type(foodStock) ~= "table" then
		print("Food stock was not received")
		print("=========================")
		return
	end

	local names = {}
	for foodName in foodStock do
		table.insert(names, foodName)
	end
	table.sort(names)

	for _, foodName in names do
		local data = foodStock[foodName]
		local amount = type(data) == "table" and data.Amount or tonumber(data) or 0
		print(string.format("%s x%d", foodName, amount))
	end

	print("=========================")
end

local function PrintGearStock(gearStock)
	print("========= Gear =========")

	if type(gearStock) ~= "table" then
		print("Gear stock was not received")
		print("=========================")
		return
	end

	local names = {}
	for gearName in gearStock do
		table.insert(names, gearName)
	end
	table.sort(names)

	for _, gearName in names do
		local data = gearStock[gearName]
		local amount = type(data) == "table" and data.Amount or tonumber(data) or 0
		print(string.format("%s x%d", gearName, amount))
	end

	print("=========================")
end

-- Запоминаем изменения репликации, чтобы дождаться окончания обновления списка.
local lastChange = os.clock()

local function MarkChanged()
	lastChange = os.clock()
end

activeEggs.ChildAdded:Connect(MarkChanged)
activeEggs.ChildRemoved:Connect(MarkChanged)

local latestFoodStock
local latestGearStock
local foodStockReceived = false
local gearStockReceived = false
local initialOutputDone = false

local function PrintInitialSnapshot()
	print("========== INITIAL LOAD ==========")
	PrintAvailableEggs()
	PrintFoodStock(latestFoodStock)
	PrintGearStock(latestGearStock)
	print("==================================")
end

local function PrintRestockSnapshot()
	print("============= RESTOCK ============")
	PrintFoodStock(latestFoodStock)
	PrintGearStock(latestGearStock)
	print("==================================")
end

restockRemote.OnClientEvent:Connect(function(_, stock)
	local foodStock = stock and stock.Food
	local gearStock = stock and stock.Gears

	if type(foodStock) == "table" then
		latestFoodStock = foodStock
		foodStockReceived = true
	end

	if type(gearStock) == "table" then
		latestGearStock = gearStock
		gearStockReceived = true
	end

	if initialOutputDone then
		PrintRestockSnapshot()
	end
end)

local function WaitForStableList(minimumWait)
	local startedAt = os.clock()

	while (os.clock() - startedAt < minimumWait or os.clock() - lastChange < 2)
		and os.clock() - startedAt < 30 do
		task.wait(0.25)
	end
end

-- ActiveEggs уже существует, но его дочерние объекты могут прийти позже.
shopStockRemote:FireServer()
WaitForStableList(3)

local stockWaitStarted = os.clock()
while (not foodStockReceived or not gearStockReceived) and os.clock() - stockWaitStarted < 10 do
	task.wait(0.25)
end

PrintInitialSnapshot()
initialOutputDone = true

task.spawn(function()
	local previousCycle = eggCycle.Index()

	while activeEggs.Parent do
		task.wait(1)

		local currentCycle = eggCycle.Index()
		if currentCycle == previousCycle then
			continue
		end

		previousCycle = currentCycle

		-- Даём серверу время отправить весь новый набор яиц.
		WaitForStableList(5)

		print("========== EGG RESET =============")
		PrintAvailableEggs()
		PrintFoodStock(latestFoodStock)
		PrintGearStock(latestGearStock)
		print("==================================")
	end
end)
