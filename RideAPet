-- Ride_A_Pet data collector. Set this to the public Django server URL.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Workspace = game:GetService("Workspace")
print("[RideAPet][INIT] Lua_Scripts started")
local API_BASE_URL = "https://craftsman-pregnant-cupid.ngrok-free.dev"
local httpFunc = request or http_request or (syn and syn.request)
local DEBUG_HTTP = true
local DEBUG_TRACE = true
local RETRY_DELAY_SECONDS = 3
print("[RideAPet][INIT] Finding ServerData and ActiveEggs")
local serverData = ReplicatedStorage:FindFirstChild("ServerData") or ReplicatedStorage
local activeEggs = serverData:WaitForChild("ActiveEggs")
print("[RideAPet][INIT] Loading EggCycle")
local eggCycle = require(ReplicatedStorage:WaitForChild("GameServices"):WaitForChild("EggCycle"))
print("[RideAPet][INIT] Finding game remotes")
local gameRemotes = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Game")
local shopStockRemote = gameRemotes:WaitForChild("ShopStock")
local restockRemote = gameRemotes:WaitForChild("Restock")
local initialFoodReceived = false
local initialGearReceived = false

local function trace(message)
	if DEBUG_TRACE then
		print("[RideAPet][TRACE] " .. tostring(message))
	end
end

trace("Services and modules loaded")

local function getEggPeriodId()
	return "eggs:" .. tostring(eggCycle.Index())
end

local function getShopPeriodId(category)
	local restockTime = serverData:FindFirstChild("LastRestockTime_" .. category)
	if restockTime then
		local value = tonumber(restockTime.Value)
		if value then
			return string.format("%s:%d", string.lower(category), math.floor(value))
		end
	end
	return string.format("%s:%d", string.lower(category), math.floor(workspace:GetServerTimeNow() / 300))
end

local function safe(value, depth, seen)
	depth, seen = depth or 0, seen or {}
	if depth > 8 then return "..." end
	local kind = typeof(value)
	if value == nil or kind == "string" or kind == "number" or kind == "boolean" then return value end
	if kind == "Vector3" then return { type="Vector3", x=value.X, y=value.Y, z=value.Z } end
	if kind == "CFrame" then local p=value.Position; return { type="CFrame", x=p.X, y=p.Y, z=p.Z } end
	if kind == "Color3" then return { type="Color3", r=value.R, g=value.G, b=value.B } end
	if kind == "Instance" then return { type="Instance", class=value.ClassName, name=value.Name, path=value:GetFullName() } end
	if type(value) ~= "table" then return tostring(value) end
	if seen[value] then return "<cycle>" end
	seen[value] = true
	local result, count = {}, 0
	for key, nested in pairs(value) do
		local name = tostring(key)
		if name ~= "BoundsSize" and name ~= "BoundsCFrame" and name ~= "BottomCFrame" then
			count += 1; result[name] = safe(nested, depth + 1, seen)
			if count >= 200 then result.__truncated = true; break end
		end
	end
	seen[value] = nil
	return result
end

local function debugLog(message)
	if DEBUG_HTTP then
		print("[RideAPet][HTTP] " .. tostring(message))
	end
end

local function responseBody(response)
	local body = response and response.Body
	if body == nil then return "" end
	body = tostring(body)
	if #body > 500 then return string.sub(body, 1, 500) .. "..." end
	return body
end

local function send(path, payload)
	if not httpFunc then
		warn("[RideAPet][HTTP] HTTP function is unavailable")
		return
	end
	trace("Preparing request: " .. path)

	local ok, body = pcall(function() return HttpService:JSONEncode(payload) end)
	if not ok then
		warn("[RideAPet][HTTP] JSON encoding failed for " .. path)
		return
	end

	task.spawn(function()
		local attempt = 0
		while true do
			attempt += 1
			debugLog(string.format("POST %s, attempt=%d", path, attempt))

			local requested, response = pcall(function()
				return httpFunc({
					Url=API_BASE_URL .. path,
					Method="POST",
					Headers={ ["Content-Type"]="application/json" },
					Body=body,
				})
			end)
			local status = requested and response and tonumber(response.StatusCode) or 0

			if status >= 200 and status < 300 then
				debugLog(string.format("SUCCESS %s, status=%d, body=%s", path, status, responseBody(response)))
				return
			end

			local errorText = requested and responseBody(response) or tostring(response)
			local retry = status == 0 or status == 408 or status == 429 or status >= 500
			warn(string.format("[RideAPet][HTTP] FAILED %s, status=%d, attempt=%d, body=%s", path, status, attempt, errorText))
			if not retry then
				warn("[RideAPet][HTTP] Request will not be retried because the server returned a client error")
				return
			end

			debugLog(string.format("Retrying %s in %d seconds", path, RETRY_DELAY_SECONDS))
			task.wait(RETRY_DELAY_SECONDS)
		end
	end)
end

local function getEggCounts()
	local counts = {}
	for _, eggObject in activeEggs:GetChildren() do
		local eggName = eggObject:GetAttribute("Egg")
		if typeof(eggName) == "string" and eggName ~= "" then
			counts[eggName] = (counts[eggName] or 0) + 1
		end
	end
	return counts
end

local eggSendSerial = 0
local function queueEggs(label)
	eggSendSerial += 1
		local serial = eggSendSerial
	task.spawn(function()
		task.wait(1)
		if serial ~= eggSendSerial then
			trace("Egg request superseded by a newer change")
			return
		end
		local eggCounts = getEggCounts()
		local eggCount = 0
		for _ in pairs(eggCounts) do eggCount += 1 end
		print(string.format("[RideAPet][SEND] eggs label=%s period_id=%s types=%d", label, getEggPeriodId(), eggCount))
		send("/api/ingest/eggs/", {
			label=label,
			period_id=getEggPeriodId(),
			data=safe(eggCounts),
			sent_at_unix=os.time(),
		})
	end)
end

local function sendStock(category, stock)
	if type(stock) ~= "table" then
		trace("Skipped " .. tostring(category) .. ": stock payload is not a table")
		return
	end
	local normalizedCategory = string.lower(category) == "gears" and "gear" or string.lower(category)
	local itemCount = 0
	for _ in pairs(stock) do itemCount += 1 end
	print(string.format("[RideAPet][SEND] %s period_id=%s items=%d", normalizedCategory, getShopPeriodId(category), itemCount))
	send("/api/ingest/stock/", {
		category=normalizedCategory,
		period_id=getShopPeriodId(category),
		data=safe(stock),
		sent_at_unix=os.time(),
	})
end

local eggsOk, eggsError = pcall(function()
	trace("Connecting ActiveEggs change listeners")
	activeEggs.ChildAdded:Connect(function()
		queueEggs("ActiveEggsChanged")
	end)
	activeEggs.ChildRemoved:Connect(function()
		queueEggs("ActiveEggsChanged")
	end)
	queueEggs("Initial ActiveEggs")
end)
if not eggsOk then
	warn("[RideAPet][INIT] Egg collector failed: " .. tostring(eggsError))
end

local stockOk, stockError = pcall(function()
	trace("Connecting Restock listener")
	restockRemote.OnClientEvent:Connect(function(options, stock)
		trace("Restock event received")
		local payload = stock
		if type(payload) ~= "table" and type(options) == "table" then payload = options end
		if type(payload) ~= "table" then return end
		if type(payload.Food) == "table" then
			initialFoodReceived = true
			sendStock("Food", payload.Food)
		end
		if type(payload.Gears) == "table" then
			initialGearReceived = true
			sendStock("Gears", payload.Gears)
		end
	end)

	task.spawn(function()
		for _ = 1, 10 do
			if initialFoodReceived and initialGearReceived then return end
			trace("Requesting initial shop stock")
			shopStockRemote:FireServer()
			task.wait(2)
		end
	end)
end)
if not stockOk then
	warn("[RideAPet][INIT] Stock collector failed: " .. tostring(stockError))
end
