local RS = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local INGEST_API_URL = "http://127.0.0.1:8000/api/ingest/events/"
local INGEST_API_KEY = ""
local DEBUG = true

local httpFunc = request or http_request or (syn and syn.request)
if not httpFunc then
    error("Your injector does not support HTTP request sending.")
end

local ingestQueue = {}
local ingestWorkerRunning = false

local function now()
    return os.time()
end

local function debugLog(message)
    if DEBUG then
        warn("[GAG2_AUCTION_RUNTIME] " .. tostring(message))
    end
end

local function detectCurrentWorldId()
    local sharedModules = RS:FindFirstChild("SharedModules")
    local worldsModule = sharedModules and sharedModules:FindFirstChild("Worlds")
    if not worldsModule then
        return "unknown"
    end

    local ok, data = pcall(function()
        return require(worldsModule)
    end)
    if not ok or type(data) ~= "table" then
        return "unknown"
    end

    local currentId = data.CurrentId
    if currentId == nil or tostring(currentId) == "" then
        return "unknown"
    end

    return tostring(currentId)
end

local CURRENT_WORLD_ID = detectCurrentWorldId()

local function payloadSummary(payload)
    if type(payload) ~= "table" then
        return ""
    end

    local parts = {}
    if payload.world_id ~= nil then
        table.insert(parts, "world=" .. tostring(payload.world_id))
    end
    if payload.source ~= nil and tostring(payload.source) ~= "" then
        table.insert(parts, "source=" .. tostring(payload.source))
    end
    if payload.step ~= nil and tostring(payload.step) ~= "" then
        table.insert(parts, "step=" .. tostring(payload.step))
    end
    if payload.name ~= nil and tostring(payload.name) ~= "" then
        table.insert(parts, "name=" .. tostring(payload.name))
    end
    if payload.path ~= nil and tostring(payload.path) ~= "" then
        table.insert(parts, "path=" .. tostring(payload.path))
    end
    return table.concat(parts, ", ")
end

local sendIngestEvent

local function runIngestWorker()
    if ingestWorkerRunning then
        return
    end

    ingestWorkerRunning = true
    task.spawn(function()
        while true do
            local nextEvent = table.remove(ingestQueue, 1)
            if not nextEvent then
                task.wait(0.1)
            else
                sendIngestEvent(nextEvent.tag, nextEvent.kind, nextEvent.payload)
                if #ingestQueue > 0 then
                    task.wait(0.05)
                end
            end
        end
    end)
end

runIngestWorker()

sendIngestEvent = function(tag, kind, payload)
    local okEncode, encodedBody = pcall(function()
        return HttpService:JSONEncode({
            tag = tostring(tag),
            kind = tostring(kind),
            payload = payload,
        })
    end)
    if not okEncode then
        debugLog("json encode failed, event=" .. tostring(tag) .. "|" .. tostring(kind))
        return false
    end

    local headers = {
        ["Content-Type"] = "application/json",
    }
    if INGEST_API_KEY ~= "" then
        headers["X-GAG2-Ingest-Key"] = INGEST_API_KEY
    end

    local ok, response = pcall(function()
        return httpFunc({
            Url = INGEST_API_URL,
            Method = "POST",
            Headers = headers,
            Body = encodedBody,
        })
    end)
    if not ok then
        debugLog("http request failed, event=" .. tostring(tag) .. "|" .. tostring(kind) .. ", error=" .. tostring(response))
        return false
    end
    if not response then
        debugLog("http request returned nil, event=" .. tostring(tag) .. "|" .. tostring(kind))
        return false
    end

    local statusCode = tonumber(response.StatusCode) or 0
    if statusCode < 200 or statusCode >= 300 then
        debugLog(
            "http status=" .. tostring(statusCode) ..
            ", event=" .. tostring(tag) .. "|" .. tostring(kind) ..
            ", status_message=" .. tostring(response.StatusMessage) ..
            ", body=" .. tostring(response.Body)
        )
        return false
    end

    debugLog("sent event=" .. tostring(tag) .. "|" .. tostring(kind) .. " status=" .. tostring(statusCode))
    return true
end

local function emit(tag, kind, payload)
    payload = payload or {}
    if payload.world_id == nil then
        payload.world_id = CURRENT_WORLD_ID
    end

    local summary = payloadSummary(payload)
    if summary ~= "" then
        debugLog("send " .. tostring(tag) .. "|" .. tostring(kind) .. " | " .. summary)
    else
        debugLog("send " .. tostring(tag) .. "|" .. tostring(kind))
    end

    table.insert(ingestQueue, {
        tag = tag,
        kind = kind,
        payload = payload,
    })
end

local function findInterestingInstances(root, matchFn, limit)
    local results = {}
    if not root then
        return results
    end

    local ok, descendants = pcall(function()
        return root:GetDescendants()
    end)
    if not ok or type(descendants) ~= "table" then
        return results
    end

    for _, child in ipairs(descendants) do
        if child and matchFn(child) then
            table.insert(results, child)
            if #results >= (limit or 25) then
                break
            end
        end
    end

    return results
end

local function describeInstance(inst)
    if not inst then
        return {}
    end

    local info = {
        name = inst.Name,
        class = inst.ClassName,
        path = inst:GetFullName(),
    }

    local childNames = {}
    local okChildren, children = pcall(function()
        return inst:GetChildren()
    end)
    if okChildren and type(children) == "table" then
        for index, child in ipairs(children) do
            table.insert(childNames, child.Name .. ":" .. child.ClassName)
            if index >= 20 then
                break
            end
        end
    end
    info.children = childNames

    return info
end

local seenPaths = {}

local function isAuctionInterestingName(name)
    local lowerName = string.lower(tostring(name or ""))
    return string.find(lowerName, "auction", 1, true)
        or string.find(lowerName, "snapshot", 1, true)
        or string.find(lowerName, "stockupdate", 1, true)
        or string.find(lowerName, "purchaseresult", 1, true)
        or string.find(lowerName, "requestsnapshot", 1, true)
end

local function logInterestingInstance(label, inst, reason)
    if not inst or not isAuctionInterestingName(inst.Name) then
        return
    end

    local path = ""
    local okPath, resultPath = pcall(function()
        return inst:GetFullName()
    end)
    if okPath then
        path = tostring(resultPath)
    else
        path = tostring(inst.Name)
    end

    if seenPaths[path] then
        return
    end
    seenPaths[path] = true

    debugLog(
        label ..
        " instance" ..
        ", reason=" .. tostring(reason or "") ..
        ", name=" .. tostring(inst.Name) ..
        ", class=" .. tostring(inst.ClassName) ..
        ", path=" .. tostring(path)
    )

    emit("AUCTION", "TEST_TRACE", {
        ts = now(),
        source = label,
        step = "interesting_instance_found",
        reason = reason or "",
        name = inst.Name,
        class = inst.ClassName,
        path = path,
    })
end

local function probeRoot(root, label)
    emit("AUCTION", "TEST_TRACE", {
        ts = now(),
        source = label,
        step = "probe_root",
        found = root ~= nil,
        path = root and root:GetFullName() or "",
    })

    if not root then
        return
    end

    local interesting = findInterestingInstances(root, function(inst)
        return isAuctionInterestingName(inst.Name)
    end, 40)

    local rows = {}
    for _, inst in ipairs(interesting) do
        logInterestingInstance(label, inst, "initial_scan")
        table.insert(rows, describeInstance(inst))
    end

    debugLog(label .. " interesting_instances_count=" .. tostring(#rows))
    for index, row in ipairs(rows) do
        debugLog(
            label ..
            " instance[" .. tostring(index) .. "]" ..
            ", name=" .. tostring(row.name) ..
            ", class=" .. tostring(row.class) ..
            ", path=" .. tostring(row.path)
        )
    end

    emit("AUCTION", "TEST_TRACE", {
        ts = now(),
        source = label,
        step = "interesting_instances",
        count = #rows,
        instances = rows,
    })
end

local function watchRoot(root, label)
    if not root then
        return
    end

    local ok, err = pcall(function()
        root.DescendantAdded:Connect(function(inst)
            if inst and isAuctionInterestingName(inst.Name) then
                logInterestingInstance(label, inst, "descendant_added")
            end
        end)
    end)

    emit("AUCTION", "TEST_TRACE", {
        ts = now(),
        source = label,
        step = "watch_root",
        ok = ok,
        error = ok and "" or tostring(err),
        path = root:GetFullName(),
    })
end

