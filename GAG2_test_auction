local ReplicatedStorage = game:GetService("ReplicatedStorage")

local function log(...)
    warn("[AUCTION_TEST]", ...)
end

local sharedModules = ReplicatedStorage:FindFirstChild("SharedModules")
if not sharedModules then
    log("SharedModules not found")
    return
end

local networkingModule = sharedModules:FindFirstChild("Networking")
if not networkingModule then
    log("Networking not found")
    return
end

log("Networking class =", networkingModule.ClassName, "path =", networkingModule:GetFullName())

if not networkingModule:IsA("ModuleScript") then
    log("Networking is not ModuleScript")
    return
end

local ok, Networking = pcall(require, networkingModule)
if not ok then
    log("require failed:", Networking)
    return
end

log("require ok, networking type =", type(Networking))

local Auctioneer = Networking.Auctioneer
if type(Auctioneer) ~= "table" then
    log("Auctioneer missing, type =", type(Auctioneer))
    return
end

log(
    "Auctioneer found",
    "Snapshot =", tostring(Auctioneer.Snapshot ~= nil),
    "StockUpdate =", tostring(Auctioneer.StockUpdate ~= nil),
    "PurchaseResult =", tostring(Auctioneer.PurchaseResult ~= nil),
    "RequestSnapshot =", tostring(Auctioneer.RequestSnapshot ~= nil)
)

if Auctioneer.Snapshot and Auctioneer.Snapshot.OnClientEvent then
    Auctioneer.Snapshot.OnClientEvent:Connect(function(snapshot)
        log("Snapshot event:", snapshot)
    end)
    log("Snapshot connected via OnClientEvent")
else
    log("Snapshot.OnClientEvent missing")
end

if Auctioneer.StockUpdate and Auctioneer.StockUpdate.OnClientEvent then
    Auctioneer.StockUpdate.OnClientEvent:Connect(function(update)
        log("StockUpdate event:", update)
    end)
    log("StockUpdate connected via OnClientEvent")
else
    log("StockUpdate.OnClientEvent missing")
end

if Auctioneer.PurchaseResult and Auctioneer.PurchaseResult.OnClientEvent then
    Auctioneer.PurchaseResult.OnClientEvent:Connect(function(lotId, success, message)
        log("PurchaseResult event:", lotId, success, message)
    end)
    log("PurchaseResult connected via OnClientEvent")
else
    log("PurchaseResult.OnClientEvent missing")
end

if Auctioneer.RequestSnapshot and typeof(Auctioneer.RequestSnapshot.Fire) == "function" then
    local ok2, result = pcall(function()
        return Auctioneer.RequestSnapshot:Fire()
    end)
    log("RequestSnapshot result:", ok2, result)
else
    log("RequestSnapshot.Fire missing")
end
