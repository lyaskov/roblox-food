end

local function countRecords(records)
	if typeof(records) ~= "table" then
		return 0
	end

	local count = 0
	for _key, _value in pairs(records) do
		count += 1
	end
	return count
end

local function toJsonSafe(value, depth, seen)
	depth = depth or 0
	seen = seen or {}

	if depth > 8 then
		return "..."
	end

	local valueType = typeof(value)
	if value == nil or valueType == "string" or valueType == "number" or valueType == "boolean" then
		return value
	elseif valueType == "Vector3" then
		return { type = "Vector3", x = value.X, y = value.Y, z = value.Z }
	elseif valueType == "CFrame" then
		local position = value.Position
		return { type = "CFrame", x = position.X, y = position.Y, z = position.Z }
	elseif valueType == "Color3" then
		return { type = "Color3", r = value.R, g = value.G, b = value.B }
	elseif valueType == "Instance" then
		return {
			type = "Instance",
			class = value.ClassName,
			name = value.Name,
			path = value:GetFullName(),
		}
	end

	if type(value) ~= "table" then
		return tostring(value)
	end

	if seen[value] then
		return "<cycle>"
	end

	seen[value] = true
	local result = {}
	local count = 0
	local maxArrayIndex = 0
	local isArray = true

	for key, _nestedValue in pairs(value) do
		if type(key) ~= "number" or key < 1 or key % 1 ~= 0 then
			isArray = false
			break
		end
		count += 1
		maxArrayIndex = math.max(maxArrayIndex, key)
	end
	isArray = isArray and count > 0 and maxArrayIndex == count
	count = 0

	for key, nestedValue in pairs(value) do
		local keyString = tostring(key)
		if keyString ~= "BoundsSize"
			and keyString ~= "BoundsCFrame"
			and keyString ~= "BottomCFrame"
		then
			count += 1
			local outputKey = isArray and key or keyString
			result[outputKey] = toJsonSafe(nestedValue, depth + 1, seen)
			if count >= 200 then
				result.__truncated = true
				break
			end
		end
	end

	seen[value] = nil
	return result
end

local function postIngestJson(url, payload, label)
	local ok, err = pcall(function()
		if not httpFunc then
			debugLog("Pluvarion HTTP sender is not available for " .. tostring(label))
			return
		end
		if type(ingestToken) ~= "string" or ingestToken == "" then
			debugLog("Pluvarion token was not passed; skipped delivery for " .. tostring(label))
			return
		end

		local requestPayload = table.clone(payload)
		requestPayload.collector_event_id = HttpService:GenerateGUID(false)
		local encodedBody = HttpService:JSONEncode(requestPayload)

		task.spawn(function()
			local okTask, taskError = pcall(function()
				for attempt = 1, 3 do
					local okRequest, response = pcall(function()
						return httpFunc({
							Url = url,
							Method = "POST",
							Headers = {
								["Content-Type"] = "application/json",
								["Accept"] = "application/json",
								["Authorization"] = "Bearer " .. ingestToken,
							},
							Body = encodedBody,
						})
					end)
					local statusCode = okRequest and response and tonumber(response.StatusCode) or 0
					if okRequest and statusCode >= 200 and statusCode < 300 then
					debugLog("Pluvarion accepted " .. tostring(label) .. ", status=" .. tostring(statusCode))
						return
					end
					local responseBody = okRequest and response and tostring(response.Body or response.body or "") or ""
					if #responseBody > 400 then
						responseBody = string.sub(responseBody, 1, 400) .. "..."
					end
					debugLog("Pluvarion delivery failed for " .. tostring(label) .. ", attempt=" .. tostring(attempt) .. "/3, status=" .. tostring(statusCode) .. ", response=" .. responseBody)
					if okRequest and statusCode >= 400 and statusCode < 500 and statusCode ~= 429 then
						return
					end
					if attempt < 3 then
						task.wait(attempt)
					end
				end
			end)
			if not okTask then
				debugLog("Pluvarion delivery stopped for " .. tostring(label) .. ": " .. tostring(taskError))
			end
		end)
	end)
	if not ok then
		debugLog("Pluvarion delivery setup failed for " .. tostring(label) .. ": " .. tostring(err))
	end
end

local function getHalloweenZoneName(position, zones)
	if zones == nil then
		return nil
	end

	for _, part in ipairs(zones:GetChildren()) do
		if not part:IsA("BasePart") then
			continue
		end

		local localPosition = part.CFrame:PointToObjectSpace(position)
		if math.abs(localPosition.X) > part.Size.X * 0.5 or math.abs(localPosition.Z) > part.Size.Z * 0.5 then
			continue
		end

		if part.Name == "SafeZone" then
			return "SafeZone"
		end

		local zoneIndex = tonumber(string.match(part.Name, "^Zone(%d+)$"))
		local zone = zoneIndex and HalloweenDimension.Zones[zoneIndex]
		return zone and zone.DisplayName or part.Name
	end

	return nil
end

local function getHalloweenEggName(instance)
	for _, attributeName in ipairs({
		"HalloweenEggName",
		"PreparedSourceName",
		"DisplayName",
		"EggName",
		"HalloweenEggType",
	}) do
		local value = instance:GetAttribute(attributeName)
		if typeof(value) == "string" and value ~= "" then
			return value, "attribute:" .. attributeName
		end
	end

	for _, childName in ipairs({ "DisplayName", "EggName", "Name" }) do
		local valueObject = instance:FindFirstChild(childName, true)
		if valueObject and (valueObject:IsA("StringValue") or valueObject:IsA("TextLabel")) then
			local value = valueObject:IsA("StringValue") and valueObject.Value or valueObject.Text
			if typeof(value) == "string" and value ~= "" then
				return value, "child:" .. childName
			end
		end
	end

	for _, attributeName in ipairs({ "AssetCategory", "AssetId" }) do
		local value = instance:GetAttribute(attributeName)
		if typeof(value) == "string" and value ~= "" then
			return value, "attribute:" .. attributeName
		end
	end

	return instance.Name, "model.Name"
end

local function getHalloweenPetId(instance)
	local candidates = { instance }
	for _, descendant in ipairs(instance:GetDescendants()) do
		table.insert(candidates, descendant)
	end
	for _, candidate in ipairs(candidates) do
		local petId = halloweenPetIdByAlias[candidate.Name]
		if petId then return petId, "model name" end
		for _, attributeName in ipairs({ "HalloweenEggPetId", "PetId", "AssetCategory", "AssetId", "HalloweenEggName" }) do
			local value = candidate:GetAttribute(attributeName)
			if typeof(value) == "string" and halloweenPetIdByAlias[value] then
				return halloweenPetIdByAlias[value], "attribute " .. attributeName
			end
		end
		for attributeName, value in pairs(candidate:GetAttributes()) do
			if typeof(value) == "string" and halloweenPetIdByAlias[value] then
				return halloweenPetIdByAlias[value], "attribute " .. attributeName
			end
		end
		if candidate:IsA("StringValue") and halloweenPetIdByAlias[candidate.Value] then
			return halloweenPetIdByAlias[candidate.Value], "StringValue"
		end
	end
	local uid = instance:GetAttribute("HalloweenEggUid") or instance:GetAttribute("Uid") or instance:GetAttribute("UID")
	local petId = typeof(uid) == "string" and halloweenPetIdByUid[uid] or nil
	if petId then return petId, "server UID record" end
	if hasHoodedGerbilMeshPair(instance) then
		return "Hooded Gerbil", "user-confirmed mesh pair"
	end
	return nil, "unidentified"
end

local function hasHalloweenEggMarker(instance)
	if not instance:IsA("Model") then return false end
	return CollectionService:HasTag(instance, "HalloweenWorldEgg")
		or typeof(instance:GetAttribute("HalloweenEggUid")) == "string"
		or typeof(instance:GetAttribute("Uid")) == "string"
		or typeof(instance:GetAttribute("UID")) == "string"
		or instance:GetAttribute("HalloweenEggCanPickUp") == true
		or instance.Name == "HalloweenEgg"
end

local function getHalloweenEggZone(instance, petId)
	local current = instance
	while current and current ~= Workspace do
		for _, key in ipairs({ "HalloweenEggZone", "Zone", "ZoneId", "AreaId" }) do
			local value = current:GetAttribute(key)
			if typeof(value) == "number" or (typeof(value) == "string" and value ~= "") then
				local number = tonumber(tostring(value):match("(%d+)$"))
				local zone = number and HalloweenDimension.Zones[number]
				return zone and string.format("Z%d %s", number, zone.DisplayName) or tostring(value)
			end
		end
		local number = tonumber(current.Name:match("^Zone%s*(%d+)$"))
		if number then
			local zone = HalloweenDimension.Zones[number]
			return zone and string.format("Z%d %s", number, zone.DisplayName) or ("Zone" .. number)
		end
		current = current.Parent
	end
	local spec = petId and HalloweenPets.Specs[petId]
	local zone = spec and spec.Zone and HalloweenDimension.Zones[spec.Zone]
	return zone and string.format("Z%d %s", spec.Zone, zone.DisplayName) or "Z?"
end

local function collectHalloweenEggs()
	local result = {}
	local taggedInstanceCount = 0
	local taggedModelCount = 0
	local taggedNonModelCount = 0
	local generatedUidCount = 0
	local taggedInstances = CollectionService:GetTagged("HalloweenWorldEgg")
	taggedInstanceCount = #taggedInstances
	local candidateInstances = table.clone(taggedInstances)
	local taggedInstanceSet = {}
	local candidateInstanceSet = {}
	for _, instance in ipairs(taggedInstances) do
		taggedInstanceSet[instance] = true
		candidateInstanceSet[instance] = true
	end

	for _, worldEggs in ipairs(Workspace:GetDescendants()) do
		if worldEggs.Name == "WorldEggs" and (worldEggs:IsA("Folder") or worldEggs:IsA("Model")) then
			for _, child in ipairs(worldEggs:GetChildren()) do
				if child:IsA("Model") and not candidateInstanceSet[child] then
					table.insert(candidateInstances, child)
					candidateInstanceSet[child] = true
				end
			end
		elseif hasHalloweenEggMarker(worldEggs) and not candidateInstanceSet[worldEggs] then
			table.insert(candidateInstances, worldEggs)
			candidateInstanceSet[worldEggs] = true
		end
	end

	debugTrace(
		"Halloween scan started: tag=HalloweenWorldEgg, tagged_instances=" .. tostring(taggedInstanceCount) ..
		", world_eggs_folders_scanned=true"
	)

	for _, instance in ipairs(candidateInstances) do
		if instance:GetAttribute("HalloweenEggNest") == true then
			debugTrace("Halloween nest model ignored: path=" .. instance:GetFullName())
			continue
		end
		if instance.Name == "EggShop" or instance.Name == "Halloween Dimension Egg" then
			debugTrace("Halloween non-egg model ignored: path=" .. instance:GetFullName())
			continue
		end
		if not instance:IsA("Model") then
			taggedNonModelCount += 1
			debugTrace("Halloween tagged instance ignored: class=" .. instance.ClassName .. ", path=" .. instance:GetFullName())
			continue
		end
		if taggedInstanceSet[instance] then
			taggedModelCount += 1
		end

		local uid = instance:GetAttribute("HalloweenEggUid")
		local uidSource = "HalloweenEggUid"
		if typeof(uid) ~= "string" or uid == "" then
			local alternateUid = instance:GetAttribute("Uid") or instance:GetAttribute("UID")
			if typeof(alternateUid) == "string" or typeof(alternateUid) == "number" then
				uid = tostring(alternateUid)
				uidSource = "Uid/UID"
			else
				uid = halloweenEggFallbackIds[instance]
				if not uid then
					uid = HttpService:GenerateGUID(false)
					halloweenEggFallbackIds[instance] = uid
				end
				generatedUidCount += 1
				uidSource = "generated-fallback"
			end
		end

		local position = instance:GetPivot().Position
		local petId, petIdSource = getHalloweenPetId(instance)
		if not petId and instance.Name == "HalloweenEgg"
			and getHalloweenEggZone(instance, nil) == "Z2 Haunted Swamp" then
			petId = "Hooded Gerbil"
			petIdSource = "zone guess (unconfirmed)"
		end
		local zoneName = getHalloweenEggZone(instance, petId)
		local eggName, eggNameSource = getHalloweenEggName(instance)
		local uid = instance:GetAttribute("HalloweenEggUid") or instance:GetAttribute("Uid") or instance:GetAttribute("UID") or uid
		local eggAsset = petId and Assets.Directory[petId]
		if eggAsset and eggAsset.Egg and eggAsset.Egg.DisplayName then
			eggName = eggAsset.Egg.DisplayName
		end
		debugTrace(
			"Halloween tagged model: path=" .. instance:GetFullName() ..
			", uid=" .. tostring(uid) ..
			", uid_source=" .. uidSource ..
			", name=" .. tostring(eggName) ..
			", name_source=" .. tostring(eggNameSource) ..
			", pet_id=" .. tostring(petId) ..
			", pet_id_source=" .. tostring(petIdSource) ..
			", zone=" .. zoneName ..
			", can_pick_up=" .. tostring(instance:GetAttribute("HalloweenEggCanPickUp")) ..
			", position=" .. tostring(position) ..
			", attributes=" .. HttpService:JSONEncode(toJsonSafe(instance:GetAttributes()))
		)
		table.insert(result, {
			uid = uid,
			pet_id = petId,
			pet_id_source = petIdSource,
			asset_category = petId,
			area_id = zoneName:gsub("^Z%d+%s+", ""),
			name = eggName,
			display_name = eggName,
			egg_name = eggName,
			zone = zoneName,
			model_name = instance.Name,
			can_pick_up = instance:GetAttribute("HalloweenEggCanPickUp") == true,
			position = position,
			attributes = instance:GetAttributes(),
		})
	end

	table.sort(result, function(a, b)
		return tostring(a.uid) < tostring(b.uid)
	end)
	debugTrace(
		"Halloween scan completed: tagged_instances=" .. tostring(taggedInstanceCount) ..
		", tagged_models=" .. tostring(taggedModelCount) ..
		", ignored_non_models=" .. tostring(taggedNonModelCount) ..
		", eggs_to_send=" .. tostring(#result) ..
		", generated_fallback_uids=" .. tostring(generatedUidCount)
	)
	return result, taggedInstanceCount, taggedModelCount, taggedNonModelCount, generatedUidCount
end

local function copySnapshotWithFieldRecords(snapshot, records)
	if typeof(snapshot) ~= "table" then
		return snapshot
	end

	local copy = {}
	for key, value in pairs(snapshot) do
		copy[key] = value
	end
	copy.Records = records
	return copy
end

local function sendRawSnapshot(label, snapshot, refreshCompletePeriod, refreshHalloweenRoster)
	local liveFieldRecords = snapshot and snapshot.Records
	if refreshCompletePeriod == true and typeof(liveFieldRecords) ~= "table" then
		debugLog("Skip invalid full field snapshot: label=" .. tostring(label))
		return
	end
	local liveFieldRecordCount = countRecords(liveFieldRecords)
	local refreshedCompleteFieldStock = refreshCompletePeriod == true and typeof(liveFieldRecords) == "table"
	if refreshedCompleteFieldStock then
		-- Use the complete server snapshot, including a legitimate empty roster.
		lastCompleteFieldEggRecords = toJsonSafe(liveFieldRecords)
	else
		snapshot = copySnapshotWithFieldRecords(snapshot, lastCompleteFieldEggRecords)
	end
	local recordCount = countRecords(snapshot and snapshot.Records)
	local liveHalloweenEggs, taggedInstanceCount, taggedModelCount, taggedNonModelCount, generatedUidCount = collectHalloweenEggs()
	local halloweenEggs = lastCompleteHalloweenEggs
	local refreshedCompleteRoster = refreshCompletePeriod == true or refreshHalloweenRoster == true
	if refreshedCompleteRoster then
		lastCompleteHalloweenEggs = liveHalloweenEggs
		halloweenEggs = lastCompleteHalloweenEggs
	else
		local mergedHalloweenEggs = table.clone(lastCompleteHalloweenEggs)
		local liveEggByUid = {}
		for _, egg in ipairs(liveHalloweenEggs) do
			if typeof(egg.uid) == "string" and egg.uid ~= "" then
				liveEggByUid[egg.uid] = egg
			end
		end
		local cachedEggByUid = {}
		for index, egg in ipairs(mergedHalloweenEggs) do
			cachedEggByUid[egg.uid] = true
			local updatedEgg = liveEggByUid[egg.uid]
			if updatedEgg then
				mergedHalloweenEggs[index] = updatedEgg
			end
		end
		for _, egg in ipairs(liveHalloweenEggs) do
			if typeof(egg.uid) == "string" and egg.uid ~= "" and not cachedEggByUid[egg.uid] then
				table.insert(mergedHalloweenEggs, egg)
				cachedEggByUid[egg.uid] = true
			end
		end
		lastCompleteHalloweenEggs = mergedHalloweenEggs
		halloweenEggs = lastCompleteHalloweenEggs
	end
	debugTrace("Field roster: label=" .. tostring(label) .. ", mode=" .. tostring(refreshedCompleteFieldStock and "new complete period" or "preserved") .. ", live=" .. tostring(liveFieldRecordCount) .. ", cached=" .. tostring(recordCount))
	debugTrace("Halloween roster: label=" .. tostring(label) .. ", mode=" .. tostring(refreshedCompleteRoster and "new complete period" or "preserved") .. ", live=" .. tostring(#liveHalloweenEggs) .. ", cached=" .. tostring(#halloweenEggs))
	debugTrace("Egg snapshot prepared: label=" .. tostring(label) .. ", records=" .. tostring(recordCount) .. ", halloween_tagged_instances=" .. tostring(taggedInstanceCount) .. ", halloween_tagged_models=" .. tostring(taggedModelCount) .. ", halloween_ignored_non_models=" .. tostring(taggedNonModelCount) .. ", halloween_eggs=" .. tostring(#halloweenEggs) .. ", halloween_generated_fallback_uids=" .. tostring(generatedUidCount) .. ", server_time=" .. tostring(snapshot and snapshot.ServerTime))
	print(string.format("[HalloweenEggs] %d eggs | %s", #halloweenEggs, tostring(label)))
	if #halloweenEggs == 0 then
		print("[HalloweenEggs] No Halloween eggs detected")
	else
		for _, egg in ipairs(halloweenEggs) do
			print(string.format(
				"[HalloweenEggs] %s | %s | pet=%s | via=%s | uid=%s | can_pick_up=%s",
				tostring(egg.zone or "Z?"),
				tostring(egg.name or egg.model_name or "?"),
				tostring(egg.pet_id or "?"),
				tostring(egg.pet_id_source or "unidentified"),
				tostring(egg.uid or "-"),
				tostring(egg.can_pick_up)
			))
		end
	end
	local payload = {
		label = label,
		snapshot = toJsonSafe(snapshot),
		halloween_eggs = toJsonSafe(halloweenEggs),
		sent_at_unix = os.time(),
	}
	debugTrace("Egg HTTP payload ready: label=" .. tostring(label) .. ", halloween_eggs=" .. tostring(#halloweenEggs) .. ", records=" .. tostring(recordCount))
	postIngestJson(EGGS_INGEST_URL, payload, label)
end

local function getBiomeDisplayName(biomeId)
	if not biomeId or biomeId == "" then
		return ""
	end

	local ok, areaData = pcall(function()
		return Areas.Directory[biomeId]
	end)
	if ok and areaData then
		return tostring(areaData.DisplayName or biomeId)
	end
	return tostring(biomeId)
end

local function rememberPortalBiome(biomeId)
	if not biomeId or biomeId == "" then
		return
	end
	portalBiomeId = tostring(biomeId):gsub("^%s+", ""):gsub("%s+$", "")
	portalBiomeDisplayName = getBiomeDisplayName(portalBiomeId)
	debugTrace("Portal biome extracted: id=" .. portalBiomeId .. ", display=" .. portalBiomeDisplayName)
end

local function extractPortalBiome(notification)
	if typeof(notification) ~= "table" then
		return ""
	end

	local text = tostring(notification.Text or notification.Message or "")
	text = string.gsub(text, "<[^>]->", " ")
	local biome = string.match(text, "[Pp]ortal%s+in%s+([%a][%a%s%-]-)%s+[Ii]f%s+")
	if biome then
		return biome
	end

	return ""
end

local function markPortalDetected(portal, source, notificationData)
	if portal then
		activePortal = portal
	end

	local notificationBiome = extractPortalBiome(notificationData)
	if notificationBiome ~= "" then
		rememberPortalBiome(notificationBiome)
		portalAlertActive = true
	end

	lastPortalAtUnix = math.floor(Workspace:GetServerTimeNow())
	portalManualExpiresAtUnix = lastPortalAtUnix + PORTAL_ACTIVE_DURATION_SECONDS
	debugLog(
		"Portal detected from " .. tostring(source) ..
		": model=" .. tostring(portal and portal:GetFullName() or "<not found>") ..
		", biome=" .. tostring(portalBiomeId) ..
		" (" .. tostring(portalBiomeDisplayName) .. ")" ..
		", manual_expires_at=" .. tostring(portalManualExpiresAtUnix)
	)
end

local function findPortalInWorkspace()
	local portal = Workspace:FindFirstChild(PORTAL_NAME, true)
	if portal and portal:IsA("Model") then
		return portal
	end

	for _, descendant in ipairs(Workspace:GetDescendants()) do
		if descendant:IsA("Model") then
			local normalizedName = string.lower(descendant.Name)
			if normalizedName == "dr. scramble's mech"
				or normalizedName == "dr scramble's mech"
				or normalizedName == "drscramblesmech"
			then
				return descendant
			end
		end
	end

	return nil
end

local function debugNotificationFields(notification)
	if not DEBUG_VERBOSE or typeof(notification) ~= "table" then
		return
	end
	local fieldCount = 0
	for key, value in pairs(notification) do
		fieldCount += 1
		debugTrace("Alerts.Raise field: " .. tostring(key) .. "=" .. tostring(value))
		if fieldCount >= 40 then
			debugTrace("Alerts.Raise fields truncated at 40")
			break
		end
	end
end

local function clearPortal(portal)
	if portal == nil or portal == activePortal then
		activePortal = nil
		portalAlertActive = false
		portalManualExpiresAtUnix = nil
		debugLog("Portal removed")
	end
end

local function syncPortalFromWorkspace()
	local portal = findPortalInWorkspace()
	if portal then
		if activePortal ~= portal then
			markPortalDetected(portal, "Workspace polling")
		end
		return true
	end

	if activePortal and activePortal.Parent == nil then
		activePortal = nil
	end

	local currentServerTime = math.floor(tonumber(Workspace:GetServerTimeNow()) or os.time())
	if portalManualExpiresAtUnix and currentServerTime >= portalManualExpiresAtUnix then
		portalAlertActive = false
		debugTrace("Portal manually closed after " .. tostring(PORTAL_ACTIVE_DURATION_SECONDS) .. " seconds; expires_at=" .. tostring(portalManualExpiresAtUnix))
	end

	return false
end

local function safeCall(callback, fallback)
	local ok, value = pcall(callback)
	if ok then
		return value
	end
	debugLog("safeCall failed: " .. tostring(value))
	return fallback
end

local function getServerTimeUnix()
	return math.floor(tonumber(safeCall(function()
		return Workspace:GetServerTimeNow()
	end, os.time())) or os.time())
end

local function readPortalScheduleSeconds()
	local configured = tonumber(safeCall(function()
		return ScrambleBossFlags.ScheduleIntervalSeconds:Get()
	end, DEFAULT_PORTAL_SCHEDULE_SECONDS)) or DEFAULT_PORTAL_SCHEDULE_SECONDS
	portalScheduleSeconds = math.max(300, math.min(86400, math.floor(configured)))
	return portalScheduleSeconds
end

local function readPortalSpawnRange()
	portalSpawnFrom = tostring(safeCall(function()
		return ScrambleBossFlags.PortalSpawnFrom:Get()
	end, "") or "")
	portalSpawnTo = tostring(safeCall(function()
		return ScrambleBossFlags.PortalSpawnTo:Get()
	end, "") or "")
end

local function applyBossState(state, source)
	if typeof(state) ~= "table" then
		debugLog("BossEvent state ignored: expected table, got " .. tostring(typeof(state)))
		return false
	end

	bossState = state
	bossOpen = state.Open
	bossSpawnsAtUnix = tonumber(state.BossSpawnsAt or state.OpensAt)
	bossClosesAtUnix = tonumber(state.ClosesAt)
	bossHealth = tonumber(state.BossHealth)
	bossMaxHealth = tonumber(state.BossMaxHealth)
	readPortalScheduleSeconds()
	readPortalSpawnRange()

	debugTrace(
		"BossEvent state applied: source=" .. tostring(source) ..
		", open=" .. tostring(bossOpen) ..
		", spawns_at=" .. tostring(bossSpawnsAtUnix) ..
		", closes_at=" .. tostring(bossClosesAtUnix) ..
		", health=" .. tostring(bossHealth) .. "/" .. tostring(bossMaxHealth) ..
		", schedule=" .. tostring(portalScheduleSeconds) ..
		", spawn_from=" .. tostring(portalSpawnFrom) ..
		", spawn_to=" .. tostring(portalSpawnTo)
	)
	return true
end

local function askBossSnapshot(source)
	local bossRemotes = Remotes and Remotes.BossEvent
	local snapshotRemote = bossRemotes and bossRemotes.AskSnapshot
	if not snapshotRemote or not snapshotRemote.InvokeServer then
		debugLog("BossEvent.AskSnapshot is unavailable; using schedule fallback")
		return false
	end

	local ok, state = pcall(function()
		return snapshotRemote:InvokeServer()
	end)
	if not ok then
		debugLog("BossEvent.AskSnapshot failed: " .. tostring(state))
		return false
	end
	return applyBossState(state, source)
end

local function getBannerId(entry)
	if typeof(entry) == "table" then
		return tostring(entry.Id or entry.id or entry.Name or "")
	end
	return tostring(entry or "")
end

local function buildBannerPayload(entry, activeBannerId)
	local bannerId = getBannerId(entry)
	local banner = safeCall(function()
		return ScrambleTradeIn.GetBanner(bannerId)
	end, nil)

	local displayName = banner
		and tostring(banner.DisplayName or banner.Name or bannerId)
		or bannerId
	local weight = safeCall(function()
		return ScrambleTradeIn.GetBannerWeight(bannerId)
	end, nil)

	return {
		banner_id = bannerId,
		display_name = displayName,
		weight = weight,
		icon = banner and tostring(banner.Icon or banner.EggIcon or "") or "",
		egg_skin = banner and tostring(banner.EggSkin or banner.Egg or "") or "",
		color = {},
		is_current = bannerId == activeBannerId,
	}
end

local function getAllBannerPayloads(activeBannerId)
	local banners = {}
	for _, entry in ipairs(ScrambleTradeIn.Banners or {}) do
		table.insert(banners, buildBannerPayload(entry, activeBannerId))
	end
	debugTrace("Banner list built: count=" .. tostring(#banners) .. ", active_id=" .. tostring(activeBannerId))
	return banners
end

local function getBannerRotationState(serverTimeUnix)
	local activeBannerId = tostring(safeCall(function()
		if type(ScrambleTradeIn.CurrentBannerId) ~= "function" then
			return ""
		end
		return ScrambleTradeIn.CurrentBannerId()
	end, "") or "")
	local activeBanner = safeCall(function()
		return ScrambleTradeIn.GetBanner(activeBannerId)
	end, nil)
	local activeBannerDisplayName = activeBanner
		and tostring(activeBanner.DisplayName or activeBanner.Name or activeBannerId)
		or activeBannerId

	local configuredRotationSeconds = tonumber(safeCall(function()
		return ScrambleTradeInFlags.RotationSeconds:Get()
	end, BANNER_ROTATION_SECONDS)) or BANNER_ROTATION_SECONDS
	if configuredRotationSeconds ~= BANNER_ROTATION_SECONDS then
		debugLog(
			"ScrambleTradeIn RotationSeconds is " .. tostring(configuredRotationSeconds) ..
			"; using configured value " .. tostring(BANNER_ROTATION_SECONDS)
		)
	end

	local currentPeriod = math.floor(serverTimeUnix / BANNER_ROTATION_SECONDS)
	local secondsUntilRotation = BANNER_ROTATION_SECONDS - (serverTimeUnix % BANNER_ROTATION_SECONDS)
	debugTrace("Banner rotation state: period=" .. tostring(currentPeriod) .. ", active_id=" .. tostring(activeBannerId) .. ", active_name=" .. tostring(activeBannerDisplayName) .. ", seconds_left=" .. tostring(secondsUntilRotation))

	return {
		current_period = currentPeriod,
		current_banner_id = activeBannerId,
		current_banner_display_name = activeBannerDisplayName,
		rotation_seconds = BANNER_ROTATION_SECONDS,
		seconds_until_rotation = secondsUntilRotation,
	}
end

local function getNextPortalAtUnix(serverTimeUnix)
	if bossSpawnsAtUnix and bossSpawnsAtUnix > serverTimeUnix then
		return bossSpawnsAtUnix
	end
	return (math.floor(serverTimeUnix / readPortalScheduleSeconds()) + 1) * readPortalScheduleSeconds()
end

local function buildPortalBannerPayload()
	local serverTimeUnix = getServerTimeUnix()
	local bannerRotation = getBannerRotationState(serverTimeUnix)
	local modelActive = activePortal ~= nil and activePortal.Parent ~= nil
	local manualClosed = portalManualExpiresAtUnix ~= nil and serverTimeUnix >= portalManualExpiresAtUnix
	local portalActive = not manualClosed and (modelActive or portalAlertActive or bossOpen == true)
	local nextPortalAtUnix = getNextPortalAtUnix(serverTimeUnix)
	local currentBiomeId = portalActive and portalBiomeId or ""
	local currentBiomeDisplayName = portalActive and portalBiomeDisplayName or ""
	local effectiveClosesAtUnix = portalManualExpiresAtUnix or bossClosesAtUnix
	debugTrace("Portal state built: active=" .. tostring(portalActive) .. ", model_active=" .. tostring(modelActive) .. ", alert_active=" .. tostring(portalAlertActive) .. ", manual_closed=" .. tostring(manualClosed) .. ", biome_id=" .. tostring(portalBiomeId) .. ", next_portal=" .. tostring(nextPortalAtUnix) .. ", last_portal=" .. tostring(lastPortalAtUnix) .. ", closes_at=" .. tostring(effectiveClosesAtUnix))

	return {
		server_time_unix = serverTimeUnix,
		portal = {
			active = portalActive,
			biome_id = currentBiomeId,
			biome_display_name = currentBiomeDisplayName,
			next_spawn_at_unix = nextPortalAtUnix,
			last_portal_at_unix = lastPortalAtUnix,
			schedule_seconds = portalScheduleSeconds,
			boss_open = bossOpen,
			boss_spawns_at_unix = bossSpawnsAtUnix,
			closes_at_unix = effectiveClosesAtUnix,
			boss_health = bossHealth,
			boss_max_health = bossMaxHealth,
			spawn_from = portalSpawnFrom,
			spawn_to = portalSpawnTo,
		},
		banner_rotation = bannerRotation,
		banners = getAllBannerPayloads(bannerRotation.current_banner_id),
	}
end

local function sendPortalBannerState(label)
	debugTrace("Preparing portal/banner send: label=" .. tostring(label))
	local state = buildPortalBannerPayload()
	local payload = {
		label = label,
		sent_at_unix = os.time(),
		server_time_unix = state.server_time_unix,
		portal = state.portal,
		banner_rotation = state.banner_rotation,
		banners = state.banners,
	}
	postIngestJson(PORTAL_BANNER_INGEST_URL, payload, label)
end

-- Keep this heartbeat independent from portal/banner game features. If a game
-- update removes those features, the watchdog can still see that this script runs.
local function sendCollectorHeartbeat()
	postIngestJson(
		HEARTBEAT_INGEST_URL,
		{
			collector = "steal-an-egg",
			sent_at_unix = os.time(),
		},
		"CollectorHeartbeat"
	)
end

local function initializeCollectorHeartbeat()
	local ok, err = pcall(function()
		task.spawn(function()
			while true do
				sendCollectorHeartbeat()
				task.wait(15)
			end
		end)
	end)
	if not ok then
		debugLog("Failed to initialize collector heartbeat: " .. tostring(err))
	end
end

local function initializeEggIngest()
	local ok, err = pcall(function()
		debugLog("Egg ingest init started; http_available=" .. tostring(httpFunc ~= nil))
		local scheduledLabel = ""
		local rosterRefreshScheduled = false
		local rosterRefreshRevision = 0
		local function scheduleHalloweenEggRosterRefresh(label)
			scheduledLabel = label
			rosterRefreshRevision += 1
			if rosterRefreshScheduled then return end
			rosterRefreshScheduled = true
			task.spawn(function()
				local seenRevision = rosterRefreshRevision
				repeat
					task.wait(1.5)
					seenRevision = rosterRefreshRevision
				until seenRevision == rosterRefreshRevision
				rosterRefreshScheduled = false
				local ok, snapshot = pcall(EggState.SyncFieldEggs)
				if not ok then
					debugLog("Full server egg snapshot failed after rotation: " .. tostring(snapshot))
					return
				end
				-- Keep API labels within the server's accepted Halloween event vocabulary.
				sendRawSnapshot("HalloweenWorldEggChanged", snapshot, true, true)
			end)
		end

		if pendingHalloweenServerUpdate then
			pendingHalloweenServerUpdate = false
			scheduleHalloweenEggRosterRefresh("pending server egg update")
		end
		_G.scheduleHalloweenEggRosterRefresh = scheduleHalloweenEggRosterRefresh

		local snapshot = EggState.SyncFieldEggs()
		debugTrace("EggState.SyncFieldEggs completed")
		if countRecords(snapshot and snapshot.Records) > 0 then
			lastCompleteFieldEggRecords = toJsonSafe(snapshot.Records)
		end
		task.delay(1.5, function()
			local initialSnapshot = EggState.ReadFieldEggs()
			sendRawSnapshot("Initial SyncFieldEggs", initialSnapshot or snapshot, true)
		end)
	end)

	if not ok then
		warn("[DebugEggsRawJson] Failed to initialize eggs: " .. tostring(err))
	end
end

local function initializeHalloweenEventNotifications()
	local lastObservedEvent = Workspace:GetAttribute(HALLOWEEN_WORLD_EVENT_ATTRIBUTE)
	debugLog("Halloween event listener initialized; current_event=" .. tostring(lastObservedEvent))

	Workspace:GetAttributeChangedSignal(HALLOWEEN_WORLD_EVENT_ATTRIBUTE):Connect(function()
		local currentEvent = Workspace:GetAttribute(HALLOWEEN_WORLD_EVENT_ATTRIBUTE)
		if currentEvent == lastObservedEvent then
			return
		end

		lastObservedEvent = currentEvent
		if currentEvent ~= "BloodMoon" and currentEvent ~= "PumpkinMoon" then
			debugTrace("Halloween event ended or changed to an unsupported value: " .. tostring(currentEvent))
			return
		end

		local payload = {
			event_type = currentEvent,
			started_at_unix = getServerTimeUnix(),
		}
		postIngestJson(
			HALLOWEEN_EVENT_INGEST_URL,
			payload,
			"HalloweenWorldEvent:" .. currentEvent
		)
	end)
end

local function initializeButterflyBloomNotifications()
	Remotes.LiveEvents.Began.OnClientEvent:Connect(function(eventName, duration)
		if eventName ~= "ButterflyBloom" then
			return
		end

		local durationSeconds = tonumber(duration)
		if durationSeconds then
			durationSeconds = math.floor(durationSeconds)
			if durationSeconds <= 0 then
				durationSeconds = nil
			end
		end

		debugLog(
			("Butterfly Bloom started; duration=%s"):format(tostring(duration))
		)
		postIngestJson(
			HALLOWEEN_EVENT_INGEST_URL,
			{
				event_type = "ButterflyBloom",
				started_at_unix = getServerTimeUnix(),
				duration_seconds = durationSeconds,
			},
			"HalloweenWorldEvent:ButterflyBloom"
		)
	end)
end

local function getAlertNotification(...)
	local args = { ... }
	if typeof(args[1]) == "table" then
		return args[1]
	end
	if typeof(args[3]) == "table" then
		return args[3]
	end
	return nil
end

local function notificationContainsPortal(notification)
	if typeof(notification) ~= "table" then
		return false
	end

	local text = string.upper(tostring(notification.Text or notification.Message or ""))
	local hasBiome = notification.PortalBiome
		or notification.Biome
		or notification.AreaId
		or notification.Area
		or notification.Zone
		or notification.PortalName
		or notification.Portal

	return hasBiome ~= nil
		or string.find(text, "PORTAL", 1, true) ~= nil
		or string.find(text, "DR. SCRAMBLE", 1, true) ~= nil
		or string.find(text, "MECH", 1, true) ~= nil
end

local function initializePortalAndBanners()
	local ok, err = pcall(function()
		debugLog("Portal/banner init started; portal_name=" .. PORTAL_NAME .. ", banner_count=" .. tostring(countRecords(ScrambleTradeIn.Banners)) .. ", http_available=" .. tostring(httpFunc ~= nil))
		readPortalScheduleSeconds()
		readPortalSpawnRange()
		askBossSnapshot("initial")
		syncPortalFromWorkspace()
		sendPortalBannerState(PORTAL_INFO_LABEL)
		debugTrace("Initial portal/banner state send completed")

		Workspace.DescendantAdded:Connect(function(child)
			local normalizedName = string.lower(child.Name)
			if child:IsA("Model") and (child.Name == PORTAL_NAME
				or normalizedName == "dr. scramble's mech"
				or normalizedName == "dr scramble's mech"
				or normalizedName == "drscramblesmech") then
				markPortalDetected(child, "Workspace.DescendantAdded")
                sendPortalBannerState(PORTAL_INFO_LABEL)
			end
		end)

		Workspace.ChildRemoved:Connect(function(child)
			if child == activePortal then
				clearPortal(child)
                sendPortalBannerState(PORTAL_INFO_LABEL)
			end
		end)

		local alertsRemote = Remotes and Remotes.Alerts and Remotes.Alerts.Raise
		if alertsRemote and alertsRemote.OnClientEvent then
			debugTrace("Alerts.Raise remote connected")
		alertsRemote.OnClientEvent:Connect(function(...)
			local notification = getAlertNotification(...)
			debugNotificationFields(notification)
			if not notificationContainsPortal(notification) then
				return
			end

			markPortalDetected(
				findPortalInWorkspace(),
				"Alerts.Raise",
				notification
			)
			askBossSnapshot("Alerts.Raise")
            sendPortalBannerState(PORTAL_INFO_LABEL)
		end)
		else
			debugLog("Alerts.Raise remote is unavailable")
		end

		local bossRemotes = Remotes and Remotes.BossEvent
		if bossRemotes and bossRemotes.StateShifted and bossRemotes.StateShifted.OnClientEvent then
			debugTrace("BossEvent.StateShifted remote connected")
			bossRemotes.StateShifted.OnClientEvent:Connect(function(state)
				applyBossState(state, "BossEvent.StateShifted")
				syncPortalFromWorkspace()
				sendPortalBannerState(PORTAL_INFO_LABEL)
			end)
		else
			debugLog("BossEvent.StateShifted remote is unavailable")
		end

		local scrambleRemotes = Remotes.ScrambleTradeIn
		if scrambleRemotes and scrambleRemotes.BannerRotated and scrambleRemotes.BannerRotated.OnClientEvent then
			debugTrace("ScrambleTradeIn.BannerRotated remote connected")
			scrambleRemotes.BannerRotated.OnClientEvent:Connect(function()
                sendPortalBannerState(BANNER_ROTATION_LABEL)
			end)
		else
			debugLog("ScrambleTradeIn.BannerRotated remote is unavailable")
		end

		task.spawn(function()
			local lastPeriod = nil
			local lastPortalActive = nil
			local lastNextPortalAt = nil

			while true do
				task.wait(15)
				debugTrace("Portal/banner polling tick")

				local serverTimeUnix = getServerTimeUnix()
				local previousBossSpawnsAt = bossSpawnsAtUnix
				local previousBossOpen = bossOpen
				askBossSnapshot("polling")
				local currentPortalActive = syncPortalFromWorkspace()
				local currentPeriod = math.floor(serverTimeUnix / BANNER_ROTATION_SECONDS)
				local nextPortalAt = getNextPortalAtUnix(serverTimeUnix)

				if currentPeriod ~= lastPeriod
					or currentPortalActive ~= lastPortalActive
					or nextPortalAt ~= lastNextPortalAt
					or bossSpawnsAtUnix ~= previousBossSpawnsAt
					or bossOpen ~= previousBossOpen
				then
					lastPeriod = currentPeriod
					lastPortalActive = currentPortalActive
					lastNextPortalAt = nextPortalAt
                    sendPortalBannerState(currentPortalActive and PORTAL_INFO_LABEL or BANNER_ROTATION_LABEL)
				else
                    sendPortalBannerState(PORTAL_INFO_LABEL)
				end
			end
		end)
	end)

	if not ok then
		warn("[DebugEggsRawJson] Failed to initialize portal/banner state: " .. tostring(err))
	end
end

initializeCollectorHeartbeat()
initializeEggIngest()
initializeHalloweenEventNotifications()
initializeButterflyBloomNotifications()
initializePortalAndBanners()
