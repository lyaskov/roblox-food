-- The diagnostic collector confirmed this mesh pair belongs to Hooded Gerbil.
local hoodedGerbilMeshIds = {
	["85596455133555"] = true,
	["70705556141109"] = true,
}

local function hasHoodedGerbilMeshPair(model)
	local found = {}
	for _, item in ipairs(model:GetDescendants()) do
		if item:IsA("MeshPart") or item:IsA("SpecialMesh") then
			local meshId = item.MeshId:match("%d+")
			if meshId and hoodedGerbilMeshIds[meshId] then
				found[meshId] = true
			end
		end
	end
	return found["85596455133555"] == true and found["70705556141109"] == true
end

local function indexHalloweenServerEggs(value, depth, seen)
	if type(value) ~= "table" or depth > 6 or seen[value] then return false end
	seen[value] = true
	local changed = false
	local uid = value.Uid or value.UID
	local petId = value.AssetCategory
	if typeof(uid) == "string" and typeof(petId) == "string" and HalloweenPets.Specs[petId]
		and halloweenPetIdByUid[uid] ~= petId then
		halloweenPetIdByUid[uid] = petId
		changed = true
	end
	for _, child in pairs(value) do
		if type(child) == "table" and indexHalloweenServerEggs(child, depth + 1, seen) then changed = true end
	end
	seen[value] = nil
	return changed
end

local watchedHalloweenRemotes = {}
local pendingHalloweenServerUpdate = false
local function watchHalloweenRemote(instance)
	if not instance:IsA("RemoteEvent") or watchedHalloweenRemotes[instance] then return end
	local fullName = instance:GetFullName():lower()
	if not string.find(fullName, "eggworld/fieldeggbatchshifted", 1, true) then return end
	watchedHalloweenRemotes[instance] = true
	instance.OnClientEvent:Connect(function(...)
		local changed = false
		local values = table.pack(...)
		for index = 1, values.n do
			if indexHalloweenServerEggs(values[index], 0, {}) then changed = true end
		end
		local schedule = _G.scheduleHalloweenEggRosterRefresh
		if schedule then
			schedule(changed and "server egg update with identity" or "server egg update")
		else
			pendingHalloweenServerUpdate = true
		end
	end)
end

