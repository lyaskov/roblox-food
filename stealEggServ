local INGEST_API_URL = "http://69.30.250.79:8001/api/ingest/eggs/"
local RIFT_INGEST_API_URL = "http://69.30.250.79:8001/api/ingest/rift/"
local DEBUG_INGEST = true
local httpFunc = request or http_request or (syn and syn.request)
local RIFT_OPEN_ATTRIBUTE = RiftEligibility.OpenAttribute
local RIFT_BANNER_COLORS = {
	Verdant = { r = 126, g = 217, b = 130 },
	Umbral = { r = 168, g = 122, b = 255 },
	Radiant = { r = 255, g = 205, b = 84 },
}
local lastNotifiedBiome = nil

local function debugLog(message)
	if not DEBUG_INGEST then
		return
	end

	warn("[DebugEggsRawJson] " .. tostring(message))
end

local function countRecords(records)
	if typeof(records) ~= "table" then
		return 0
	end

	local count = 0
	for _key, _value in pairs(records) do
		count += 1
	end

	return count
end

local function toJsonSafe(value, depth, seen)
	depth = depth or 0
	seen = seen or {}

	if depth > 8 then
		return "..."
	end

	local valueType = typeof(value)
	if value == nil or valueType == "string" or valueType == "number" or valueType == "boolean" then
		return value
	end

	if valueType == "Vector3" then
		return {
			type = "Vector3",
			x = value.X,
			y = value.Y,
			z = value.Z,
		}
	end

	if valueType == "CFrame" then
		local position = value.Position
		return {
			type = "CFrame",
			x = position.X,
			y = position.Y,
			z = position.Z,
		}
	end

	if valueType == "Color3" then
		return {
			type = "Color3",
			r = value.R,
			g = value.G,
			b = value.B,
		}
	end

	if valueType == "Instance" then
		return {
			type = "Instance",
			class = value.ClassName,
			name = value.Name,
			path = value:GetFullName(),
		}
	end

	if type(value) == "table" then
		if seen[value] then
			return "<cycle>"
		end

		seen[value] = true

		local result = {}
		local count = 0
		for key, nestedValue in pairs(value) do
			local keyString = tostring(key)
			if keyString ~= "BoundsSize" and keyString ~= "BoundsCFrame" and keyString ~= "BottomCFrame" then
			count += 1
				result[keyString] = toJsonSafe(nestedValue, depth + 1, seen)
				if count >= 200 then
					result.__truncated = true
					break
				end
			end
		end

		seen[value] = nil
		return result
	end

	return tostring(value)
end

local function sendRawSnapshot(label, snapshot)
	if not httpFunc then
		debugLog("HTTP sender is not available in this executor")
		return
	end

	local records = snapshot and snapshot.Records
	local recordCount = countRecords(records)
	if recordCount < 10 then
		debugLog("Skip send for " .. tostring(label) .. ": recordCount=" .. tostring(recordCount))
		return
	end

	local payload = {
		label = label,
		snapshot = toJsonSafe(snapshot),
		sent_at_unix = os.time(),
	}

	local okEncode, encodedBody = pcall(function()
		return HttpService:JSONEncode(payload)
	end)

	if not okEncode then
		debugLog("Failed to encode payload for " .. tostring(label))
		return
	end

	local okRequest, response = pcall(function()
		return httpFunc({
			Url = INGEST_API_URL,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json",
			},
			Body = encodedBody,
		})
	end)

	if not okRequest then
		debugLog("HTTP request failed for " .. tostring(label) .. ": " .. tostring(response))
		return
	end

	local statusCode = response and tonumber(response.StatusCode) or 0
	if statusCode < 200 or statusCode >= 300 then
		debugLog(
			"HTTP status failed for " .. tostring(label) ..
			", status=" .. tostring(statusCode) ..
			", body=" .. tostring(response and response.Body)
		)
		return
	end

	debugLog("Raw snapshot sent: " .. tostring(label) .. ", status=" .. tostring(statusCode))
end

local function getBiomeName(areaId)
	if not areaId or areaId == "" then
		return ""
	end

	local areaData = Areas.Directory[areaId]
	if areaData then
		return tostring(areaData.DisplayName or areaId)
	end

	return tostring(areaId)
end

local function getLastKnownBiome(spawnAreaId)
	if spawnAreaId and spawnAreaId ~= "" then
		return spawnAreaId
	end

	if lastNotifiedBiome and lastNotifiedBiome ~= "" then
		return lastNotifiedBiome
	end

	return ""
end

local function buildRiftBannerPayload(bannerId)
	local fromBiome, toBiome = Rift.GetBannerRange(bannerId)
	local icon = ""
	local eggSkin = ""
	local weight = Rift.GetBannerWeight(bannerId)

	pcall(function()
		icon = tostring(Rift.GetBannerEggIcon(bannerId) or "")
	end)
	pcall(function()
		eggSkin = tostring(Rift.GetBannerEggSkin(bannerId) or "")
	end)

	return {
		banner_id = tostring(bannerId or ""),
		display_name = tostring(Rift.GetBannerDisplayName(bannerId) or ""),
		weight = weight,
		icon = icon,
		egg_skin = eggSkin,
		color = RIFT_BANNER_COLORS[bannerId] or {},
		from_biome = tostring(fromBiome or ""),
		to_biome = tostring(toBiome or ""),
	}
end

local function buildRiftPayload()
	local currentPeriod = Rift.CurrentPeriod()
	local currentBannerId = Rift.CurrentBannerId()
	local currentBanner = buildRiftBannerPayload(currentBannerId)
	local spawnAreaId = RiftFlags.SpawnAreaId:Get()
	local notifiedBiome = lastNotifiedBiome
	local effectiveSpawnAreaId = getLastKnownBiome(spawnAreaId)

	local allBanners = {}
	for _, bannerId in ipairs(Rift.BannerIds()) do
		table.insert(allBanners, buildRiftBannerPayload(bannerId))
	end

	return {
		current_period = currentPeriod,
		current_banner_id = tostring(currentBannerId or ""),
		current_banner_display_name = tostring(Rift.GetBannerDisplayName(currentBannerId) or ""),
		current_banner_icon = currentBanner.icon,
		current_banner_egg_skin = currentBanner.egg_skin,
		rotation_seconds = Rift.RotationSeconds(),
		seconds_until_rotation = Rift.SecondsUntilRotation(),
		is_rift_live = RiftEligibility.IsFeatureLive(),
		from_biome = currentBanner.from_biome,
		to_biome = currentBanner.to_biome,
		spawn_area_id = tostring(spawnAreaId or ""),
		spawn_area_display_name = getBiomeName(spawnAreaId),
		notified_spawn_area_id = tostring(notifiedBiome or ""),
		notified_spawn_area_display_name = getBiomeName(notifiedBiome),
		effective_spawn_area_id = tostring(effectiveSpawnAreaId or ""),
		effective_spawn_area_display_name = getBiomeName(effectiveSpawnAreaId),
		current_banner_weight = currentBanner.weight,
		all_banners = allBanners,
	}
end

local function debugRiftPayload(label, riftPayload)
	debugLog(
		"Rift " .. tostring(label) ..
		" | period=" .. tostring(riftPayload.current_period) ..
		" | banner=" .. tostring(riftPayload.current_banner_id) ..
		" (" .. tostring(riftPayload.current_banner_display_name) .. ")" ..
		" | rotation_left=" .. tostring(riftPayload.seconds_until_rotation) ..
		" | live=" .. tostring(riftPayload.is_rift_live) ..
		" | range=" .. tostring(riftPayload.from_biome) .. " -> " .. tostring(riftPayload.to_biome) ..
		" | spawn=" .. tostring(riftPayload.spawn_area_id) ..
		" (" .. tostring(riftPayload.spawn_area_display_name) .. ")" ..
		" | notified_spawn=" .. tostring(riftPayload.notified_spawn_area_id) ..
		" (" .. tostring(riftPayload.notified_spawn_area_display_name) .. ")" ..
		" | banners=" .. tostring(#riftPayload.all_banners)
	)
end

local function sendRiftInfo(label)
	if not httpFunc then
		debugLog("HTTP sender is not available in this executor")
		return
	end

	local okBuild, riftPayload = pcall(buildRiftPayload)
	if not okBuild then
		debugLog("Failed to build rift payload for " .. tostring(label) .. ": " .. tostring(riftPayload))
		return
	end

	debugRiftPayload(label, riftPayload)

	local payload = {
		label = label,
		rift = riftPayload,
		sent_at_unix = os.time(),
	}

	local okEncode, encodedBody = pcall(function()
		return HttpService:JSONEncode(payload)
	end)

	if not okEncode then
		debugLog("Failed to encode rift payload for " .. tostring(label))
		return
	end

	local okRequest, response = pcall(function()
		return httpFunc({
			Url = RIFT_INGEST_API_URL,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json",
			},
			Body = encodedBody,
		})
	end)

	if not okRequest then
		debugLog("HTTP request failed for rift " .. tostring(label) .. ": " .. tostring(response))
		return
	end

	local statusCode = response and tonumber(response.StatusCode) or 0
	if statusCode < 200 or statusCode >= 300 then
		debugLog(
			"HTTP status failed for rift " .. tostring(label) ..
			", status=" .. tostring(statusCode) ..
			", body=" .. tostring(response and response.Body)
		)
		return
	end

	debugLog("Rift info sent: " .. tostring(label) .. ", status=" .. tostring(statusCode))
end

local function printRawSnapshot(label, snapshot)
	if typeof(snapshot) ~= "table" then
		warn("[DebugEggsRawJson] " .. label .. " | snapshot is not a table")
		return
	end

	local records = snapshot.Records
	local recordCount = countRecords(records)
	if recordCount < 10 then
		debugLog("Skip dump for " .. tostring(label) .. ": recordCount=" .. tostring(recordCount))
		return
	end

	local payload = {
		label = label,
		snapshot = toJsonSafe(snapshot),
	}

	local ok, encoded = pcall(function()
		return HttpService:JSONEncode(payload)
	end)

	if not ok then
		warn("[DebugEggsRawJson] Failed to encode " .. label)
		return
	end

	print("\n========== [DebugEggs RAW JSON] ==========")
	print(encoded)
	print("=========================================")

	sendRawSnapshot(label, snapshot)
end

local ok, err = pcall(function()
	EggState.FieldRefreshed:Connect(function(snapshot)
		printRawSnapshot("FieldRefreshed", snapshot)
	end)

	local snapshot = EggState.SyncFieldEggs()
	printRawSnapshot("Initial SyncFieldEggs", snapshot)
end)

if not ok then
	warn("[DebugEggsRawJson] Failed to initialize eggs: " .. tostring(err))
end

local riftOk, riftErr = pcall(function()
	if not Save.IsLocalDataLoaded() then
		debugLog("Waiting for profile data before Rift state...")
		Save.ProfileReady:Wait()
	end

	sendRiftInfo("RiftInfo")

	Remotes.Rift.BannerRotated.OnClientEvent:Connect(function()
		sendRiftInfo("RiftRotation")
	end)

	Remotes.Alerts.Raise.OnClientEvent:Connect(function(notifType, _, data)
		if notifType == "RiftSpawn" and typeof(data) == "table" then
			lastNotifiedBiome = data.AreaId
			sendRiftInfo("RiftInfo")
		end
	end)

	if RiftFlags.SpawnAreaId and RiftFlags.SpawnAreaId.Changed then
		RiftFlags.SpawnAreaId.Changed:Connect(function()
			sendRiftInfo("RiftInfo")
		end)
	end

	Workspace:GetAttributeChangedSignal(RIFT_OPEN_ATTRIBUTE):Connect(function()
		sendRiftInfo("RiftInfo")
	end)

	task.spawn(function()
		local lastRiftPeriod = Rift.CurrentPeriod()
		local lastSpawnAreaId = RiftFlags.SpawnAreaId:Get()
		local lastIsLive = RiftEligibility.IsFeatureLive()
		while true do
			task.wait(5)

			local newRiftPeriod = Rift.CurrentPeriod()
			local newSpawnAreaId = RiftFlags.SpawnAreaId:Get()
			local newIsLive = RiftEligibility.IsFeatureLive()
			if newRiftPeriod ~= lastRiftPeriod then
				lastRiftPeriod = newRiftPeriod
				lastSpawnAreaId = newSpawnAreaId
				lastIsLive = newIsLive
				sendRiftInfo("RiftRotation")
			elseif newSpawnAreaId ~= lastSpawnAreaId or newIsLive ~= lastIsLive then
				lastSpawnAreaId = newSpawnAreaId
				lastIsLive = newIsLive
				sendRiftInfo("RiftInfo")
			end
		end
	end)
end)

if not riftOk then
	warn("[DebugEggsRawJson] Failed to initialize rift: " .. tostring(riftErr))
end

