-- Prints the live Halloween world eggs by zone on load and after a global respawn.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local HalloweenDimension = require(ReplicatedStorage.Shared.Util.HalloweenDimension)
local HalloweenPets = require(ReplicatedStorage.Data.HalloweenPets)
local Assets = require(ReplicatedStorage.Data.Assets)

local function normalized(value)
	return string.lower((string.gsub(tostring(value or ""), "[^%w]", "")))
end

local function getEggName(egg)
	for _, attributeName in ipairs({ "HalloweenEggName", "EggName", "HalloweenEggType", "AssetCategory", "AssetId", "PetId" }) do
		local value = egg:GetAttribute(attributeName)
		if type(value) == "string" then
			local asset = Assets.Directory[value]
			if asset and asset.Egg and asset.Egg.DisplayName then
				return asset.Egg.DisplayName
			end

			local petSpec = HalloweenPets.Specs[value]
			if petSpec then
				return petSpec.EggModel or petSpec.DisplayName .. " Egg"
			end

			if attributeName == "HalloweenEggName" or attributeName == "EggName" or attributeName == "HalloweenEggType" then
				return value
			end
		end
	end

	local displayName = egg:GetAttribute("DisplayName")
	if type(displayName) == "string" and displayName ~= "" and displayName ~= egg.Name then
		return displayName
	end

	for _, childName in ipairs({ "DisplayName", "EggName", "Name" }) do
		local valueObject = egg:FindFirstChild(childName, true)
		if valueObject and (valueObject:IsA("StringValue") or valueObject:IsA("TextLabel")) then
			local value = valueObject:IsA("StringValue") and valueObject.Value or valueObject.Text
			if type(value) == "string" and value ~= "" and value ~= egg.Name then
				return value
			end
		end
	end

	local asset = Assets.Directory[egg.Name]
	if asset and asset.Egg and asset.Egg.DisplayName then
		return asset.Egg.DisplayName
	end

	local petSpec = HalloweenPets.Specs[egg.Name]
	if petSpec then
		return petSpec.EggModel or petSpec.DisplayName .. " Egg"
	end

	local uid = egg:GetAttribute("HalloweenEggUid")
	return ("Unknown Halloween egg (uid=%s)"):format(tostring(uid))
end

local function getZoneIndex(egg, zones)
	for index, zone in ipairs(HalloweenDimension.Zones) do
		local zoneName = normalized(zone.DisplayName)
		for _, attributeName in ipairs({ "Zone", "ZoneIndex", "ZoneName", "AreaId" }) do
			local value = egg:GetAttribute(attributeName)
			if type(value) == "number" and value == index then
				return index
			end

			local areaId = normalized(value)
			if areaId == zoneName
				or string.find(areaId, zoneName, 1, true)
				or string.find(areaId, "zone" .. index, 1, true) then
				return index
			end
		end
	end

	local position = egg:GetPivot().Position
	for _, part in ipairs(zones:GetChildren()) do
		local index = tonumber(string.match(part.Name, "^Zone(%d+)$"))
		if index and index <= #HalloweenDimension.Zones and part:IsA("BasePart") then
			local localPosition = part.CFrame:PointToObjectSpace(position)
			if math.abs(localPosition.X) <= part.Size.X * 0.5
				and math.abs(localPosition.Z) <= part.Size.Z * 0.5 then
				return index
			end
		end
	end

	return nil
end

local function printSnapshot(worldEggs, zones)
	local eggsByZone = {}
	for zoneIndex in ipairs(HalloweenDimension.Zones) do
		eggsByZone[zoneIndex] = {}
	end

	for _, egg in ipairs(worldEggs:GetChildren()) do
		if not egg:IsA("Model") or type(egg:GetAttribute("HalloweenEggUid")) ~= "string" then
			continue
		end

		local zoneIndex = getZoneIndex(egg, zones)
		if zoneIndex and eggsByZone[zoneIndex] then
			table.insert(eggsByZone[zoneIndex], getEggName(egg))
		end
	end

	for zoneIndex, zone in ipairs(HalloweenDimension.Zones) do
		local eggNames = eggsByZone[zoneIndex]
		table.sort(eggNames)
		print(("[HalloweenEggs] zone=%s; eggs=%d"):format(zone.DisplayName, #eggNames))
		for _, eggName in ipairs(eggNames) do
			print(("[HalloweenEggs] zone=%s; egg=%s"):format(zone.DisplayName, eggName))
		end
	end

	-- Dump the replicated instance tree for each egg. This shows all state the
	-- client can inspect locally; it is not a raw network packet capture.
	for _, egg in ipairs(worldEggs:GetChildren()) do
		if egg:IsA("Model") and type(egg:GetAttribute("HalloweenEggUid")) == "string" then
			print(("[HalloweenEggs][DEBUG] egg=%s uid=%s zone=%s"):format(
				egg:GetFullName(),
				tostring(egg:GetAttribute("HalloweenEggUid")),
				getZoneIndex(egg, zones) or "unknown"
			))

			local instances = { egg }
			for _, descendant in ipairs(egg:GetDescendants()) do
				table.insert(instances, descendant)
			end
			table.sort(instances, function(a, b)
				return a:GetFullName() < b:GetFullName()
			end)

			for _, instance in ipairs(instances) do
				local details = { "class=" .. instance.ClassName }
				local attributes = instance:GetAttributes()
				local attributeNames = {}
				for name in pairs(attributes) do
					table.insert(attributeNames, name)
				end
				table.sort(attributeNames)
				for _, name in ipairs(attributeNames) do
					table.insert(details, ("attr.%s=%s"):format(name, tostring(attributes[name])))
				end

				if instance:IsA("ValueBase") then
					table.insert(details, "value=" .. tostring(instance.Value))
				elseif instance:IsA("TextLabel") or instance:IsA("TextButton") then
					table.insert(details, "text=" .. tostring(instance.Text))
				elseif instance:IsA("BasePart") then
					table.insert(details, "position=" .. tostring(instance.Position))
					table.insert(details, "size=" .. tostring(instance.Size))
				elseif instance:IsA("ProximityPrompt") then
					table.insert(details, "actionText=" .. tostring(instance.ActionText))
					table.insert(details, "objectText=" .. tostring(instance.ObjectText))
					table.insert(details, "enabled=" .. tostring(instance.Enabled))
				end

				print(("[HalloweenEggs][DEBUG] %s | %s"):format(
					instance:GetFullName(),
					table.concat(details, "; ")
				))
			end
		end
	end
end

local printScheduled = false
local function schedulePrint(worldEggs, zones)
	if printScheduled then
		return
	end

	printScheduled = true
	task.delay(1, function()
		printScheduled = false
		if worldEggs.Parent then
			printSnapshot(worldEggs, zones)
		end
	end)
end

local function watchEgg(egg, worldEggs, zones)
	if egg:IsA("Model") then
		local function watchInstance(instance)
			instance.AttributeChanged:Connect(function()
				schedulePrint(worldEggs, zones)
			end)
			if instance:IsA("ValueBase") then
				instance.Changed:Connect(function()
					schedulePrint(worldEggs, zones)
				end)
			end
		end

		watchInstance(egg)
		egg.DescendantAdded:Connect(function(descendant)
			watchInstance(descendant)
			schedulePrint(worldEggs, zones)
		end)
	end
end

task.spawn(function()
	local map = Workspace:WaitForChild(HalloweenDimension.MapName, 30)
	if not map then
		warn("[HalloweenEggs] HalloweenDimension map did not load")
		return
	end

	local worldEggs = map:WaitForChild("WorldEggs", 30)
	local zones = map:WaitForChild("Zones", 30)
	if not worldEggs or not zones then
		warn("[HalloweenEggs] WorldEggs or Zones folder did not load")
		return
	end

	worldEggs.ChildAdded:Connect(function(egg)
		watchEgg(egg, worldEggs, zones)
		schedulePrint(worldEggs, zones)
	end)
	worldEggs.ChildRemoved:Connect(function()
		 schedulePrint(worldEggs, zones)
	end)
	for _, egg in ipairs(worldEggs:GetChildren()) do
		watchEgg(egg, worldEggs, zones)
	end

	printSnapshot(worldEggs, zones)
end)
