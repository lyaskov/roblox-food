-- Клиентская диагностика Halloween-яиц. Только читает клиентские модели и атрибуты.
-- Запускать в клиентском контексте (например, из test/HalloweenEggDiagnostics.client.luau).

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Assets = require(ReplicatedStorage.Data.Assets)
local HalloweenPets = require(ReplicatedStorage.Data.HalloweenPets)
local logPrefix = "[HalloweenEggDiagnostics]"
local tracked = {}
local TAG_NAME = "HalloweenWorldEgg"
local snapshotQueued = false

local function findZone(instance)
	local current = instance
	while current ~= nil and current ~= Workspace do
		for _, attributeName in ipairs({ "HalloweenEggZone", "Zone", "ZoneId", "AreaId" }) do
			local value = current:GetAttribute(attributeName)
			if typeof(value) == "number" or (typeof(value) == "string" and value ~= "") then
				return tostring(value)
			end
		end

		local zoneNumber = current.Name:match("^Zone%s*(%d+)$")
		if zoneNumber then
			return zoneNumber
		end
		current = current.Parent
	end
	return nil
end

local function findPetName(model)
	for _, attributeName in ipairs({ "HalloweenEggPetId", "PetId", "AssetId", "HalloweenEggName" }) do
		local value = model:GetAttribute(attributeName)
		if typeof(value) == "string" and value ~= "" then
			return value
		end
	end

	if HalloweenPets.Specs[model.Name] then
		return model.Name
	end

	local eggUid = model:GetAttribute("HalloweenEggUid")
	if typeof(eggUid) == "string" and HalloweenPets.Specs[eggUid] then
		return eggUid
	end
	return nil
end

local function findEggDisplayName(model, petName)
	local asset = petName and Assets.Directory[petName]
	if asset and asset.Egg and asset.Egg.DisplayName then
		return asset.Egg.DisplayName
	end

	for name, candidate in pairs(Assets.Directory) do
		local egg = candidate.Egg
		if egg and (egg.ModelName == model.Name or egg.DisplayName == model.Name) then
			return egg.DisplayName or egg.ModelName or name
		end
	end
	return model.Name
end

local function describe(model)
	local petName = findPetName(model)
	local spec = petName and HalloweenPets.Specs[petName]
	local zone = findZone(model) or (spec and spec.Zone and tostring(spec.Zone))
	local eggUid = model:GetAttribute("HalloweenEggUid")
	return string.format(
		"%s | %s | pet=%s | uid=%s | %s",
		zone or "<unknown>",
		findEggDisplayName(model, petName),
		petName or "<unknown>",
		typeof(eggUid) == "string" and eggUid or "<missing>",
		model:GetFullName()
	)
end

local function printZoneCatalog(reason)
	local zoneDropTables = HalloweenPets.Config.ZoneDropTables
	for zoneIndex = 1, 3 do
		local zoneId = "Zone" .. zoneIndex
		local drops = zoneDropTables[zoneId] or {}
		print(string.format("%s [%s] %s — яиц: %d", logPrefix, reason, zoneId, #drops))
		for _, drop in ipairs(drops) do
			local petId = drop[1]
			local spec = HalloweenPets.Specs[petId]
			local asset = Assets.Directory[petId]
			local eggName = asset and asset.Egg and asset.Egg.DisplayName
			print(string.format(
				"%s   %s | питомец: %s | id: %s",
				logPrefix,
				eggName or (spec and spec.EggModel) or "<unknown egg>",
				(spec and spec.DisplayName) or petId,
				petId
			))
		end
	end
end

local function printSnapshot(reason)
	printZoneCatalog(reason)
	local entries = {}
	for model in pairs(tracked) do
		if model.Parent ~= nil then
			table.insert(entries, describe(model))
		end
	end
	table.sort(entries)
	print(string.format("%s [%s] Halloween eggs: %d", logPrefix, reason, #entries))
	for _, entry in ipairs(entries) do
		print(logPrefix, "zone | egg name | pet | uid | path:", entry)
	end
end

local function scheduleSnapshot(reason)
	if snapshotQueued then
		return
	end
	snapshotQueued = true
	task.defer(function()
		snapshotQueued = false
		printSnapshot(reason)
	end)
end

local function track(instance, reason)
	if not instance:IsA("Model") then
		return
	end

	if tracked[instance] then
		scheduleSnapshot(reason)
		return
	end

	local connections = {}
	tracked[instance] = connections

	local function changed()
		scheduleSnapshot("updated")
	end

	for _, attributeName in ipairs({
		"HalloweenEggUid",
		"HalloweenEggZone",
		"Zone",
		"ZoneId",
		"AreaId",
		"HalloweenEggPetId",
		"PetId",
		"AssetId",
		"HalloweenEggName",
	}) do
		table.insert(connections, instance:GetAttributeChangedSignal(attributeName):Connect(changed))
	end

	table.insert(connections, instance.AncestryChanged:Connect(changed))
	table.insert(connections, instance.Destroying:Connect(function()
		for _, connection in ipairs(connections) do
			connection:Disconnect()
		end
		tracked[instance] = nil
		scheduleSnapshot("removed")
	end))

	scheduleSnapshot(reason)
end

local function discoverTagged()
	for _, instance in ipairs(CollectionService:GetTagged(TAG_NAME)) do
		track(instance, "initial/tagged")
	end
end

local function scanWorldEggFolders()
	for _, instance in ipairs(Workspace:GetDescendants()) do
		if instance.Name == "WorldEggs" and (instance:IsA("Folder") or instance:IsA("Model")) then
			for _, egg in ipairs(instance:GetChildren()) do
				if egg:IsA("Model") and egg:GetAttribute("HalloweenEggUid") ~= nil then
					track(egg, "initial/WorldEggs")
				end
			end
		end
	end
end

discoverTagged()
scanWorldEggFolders()
scheduleSnapshot("initial load")

CollectionService:GetInstanceAddedSignal(TAG_NAME):Connect(function(instance)
	track(instance, "added")
end)

CollectionService:GetInstanceRemovedSignal(TAG_NAME):Connect(function(instance)
	local connections = tracked[instance]
	if connections then
		for _, connection in ipairs(connections) do
			connection:Disconnect() 
		end
		tracked[instance] = nil
	end
	scheduleSnapshot("removed")
end)

Workspace.DescendantAdded:Connect(function(instance)
	if instance.Name == "WorldEggs" then
		task.defer(scanWorldEggFolders)
	elseif instance:IsA("Model") and instance:GetAttribute("HalloweenEggUid") ~= nil then
		track(instance, "added")
	end
end)

print(logPrefix, "watching for Halloween egg additions, removals, and attribute updates")
