-- Prints Halloween pets available from eggs, grouped by zone.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HalloweenDimension = require(ReplicatedStorage.Shared.Util.HalloweenDimension)
local HalloweenPets = require(ReplicatedStorage.Data.HalloweenPets)
local Assets = require(ReplicatedStorage.Data.Assets)
local BalanceConfig = require(ReplicatedStorage.Shared.Flags.BalanceConfig)

local function printPetsByZone()
	local dropTables = HalloweenPets.Config.ZoneDropTables

	for zoneIndex, zone in ipairs(HalloweenDimension.Zones) do
		local drops = dropTables["Zone" .. zoneIndex] or {}
		print(("[HalloweenPets] zone=%s"):format(zone.DisplayName))

		for _, drop in ipairs(drops) do
			local assetId = drop[1]
			local asset = Assets.Directory[assetId]
			local petName = asset and asset.DisplayName or assetId
			print(("[HalloweenPets] zone=%s; pet=%s"):format(zone.DisplayName, petName))
		end
	end
end

-- Print again whenever the server updates the Halloween pet balance data.
BalanceConfig.Changed:Connect(function(key)
	if key == "Game.HalloweenPets" then
		printPetsByZone()
	end
end)

-- Print the current server-provided values after module initialization.
task.defer(printPetsByZone)
