-- Prints field egg records plus live Halloween world egg models.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")
local EggState = require(ReplicatedStorage.Client.EggState)
local HalloweenDimension = require(ReplicatedStorage.Shared.Util.HalloweenDimension)
local lastPrinted = {}
local halloweenEggConnections = {}
local lastHalloweenEggSignature = {}
local printedInitialSnapshot = false

local function printEggRecord(record)
	if type(record) ~= "table" then
		return
	end

	local uid = record.Uid
	if type(uid) ~= "string" then
		return
	end

	local row = {
		record_key = uid,
		uid = uid,
		area_id = record.AreaId or "",
		nest_id = record.NestId or "",
		asset_category = record.AssetCategory or "",
		state = record.State or "",
		version = record.Version,
		has_parasite = record.HasParasite == true,
		base_mutation = record.BaseMutation or "",
		asset_color_index = record.AssetColorIndex,
		asset_color_seed = record.AssetColorSeed,
		asset_eye_color = record.AssetEyeColor or "",
		asset_scale = record.AssetScale,
		nest_scale = record.NestScale,
	}

	local signature = table.concat({
		tostring(row.area_id), tostring(row.nest_id), tostring(row.asset_category),
		tostring(row.state), tostring(row.version), tostring(row.has_parasite),
		tostring(row.base_mutation), tostring(row.asset_color_index),
		tostring(row.asset_color_seed), tostring(row.asset_eye_color),
		tostring(row.asset_scale), tostring(row.nest_scale),
	}, "|")
	if lastPrinted[uid] == signature then
		return
	end
	lastPrinted[uid] = signature

	print(("[EggTest] record_key=%s"):format(uid))
	for key, value in pairs(row) do
		print(("  %s = %s"):format(key, tostring(value)))
	end
end

local function onSnapshot(snapshot)
	if type(snapshot) ~= "table" or type(snapshot.Records) ~= "table" then
		return
	end

	local records = table.clone(snapshot.Records)
	table.sort(records, function(a, b)
		return tostring(a.Uid) < tostring(b.Uid)
	end)

	if not printedInitialSnapshot then
		print(("[EggTest] Initial live egg snapshot: %d eggs; ServerTime=%s"):format(
			#records,
			tostring(snapshot.ServerTime)
		))
		printedInitialSnapshot = true
	end

	for _, record in ipairs(records) do
		printEggRecord(record)
	end
end

-- Halloween world eggs are separate tagged models; they are not in EggState's field snapshot.
local function halloweenZoneAt(position)
	local map = Workspace:FindFirstChild(HalloweenDimension.MapName)
	local zones = map and map:FindFirstChild("Zones")
	if zones == nil then
		return nil
	end

	for _, part in ipairs(zones:GetChildren()) do
		if not part:IsA("BasePart") then
			continue
		end

		local localPosition = part.CFrame:PointToObjectSpace(position)
		if math.abs(localPosition.X) > part.Size.X * 0.5 or math.abs(localPosition.Z) > part.Size.Z * 0.5 then
			continue
		end

		if part.Name == "SafeZone" then
			return "SafeZone"
		end

		local zoneIndex = tonumber(string.match(part.Name, "^Zone(%d+)$"))
		local zone = zoneIndex and HalloweenDimension.Zones[zoneIndex]
		return zone and zone.DisplayName or part.Name
	end

	return nil
end

local function printHalloweenWorldEgg(model)
	if not model:IsA("Model") then
		return
	end

	local attributes = model:GetAttributes()
	local uid = attributes.HalloweenEggUid
	local position = model:GetPivot().Position
	local zoneName = halloweenZoneAt(position) or "Outside Halloween zones"
	local attributeKeys = {}
	for key in pairs(attributes) do
		table.insert(attributeKeys, key)
	end
	table.sort(attributeKeys)
	local signatureParts = { zoneName }
	for _, key in ipairs(attributeKeys) do
		table.insert(signatureParts, key .. "=" .. tostring(attributes[key]))
	end
	local signature = table.concat(signatureParts, "|")
	if lastHalloweenEggSignature[model] == signature then
		return
	end
	lastHalloweenEggSignature[model] = signature

	print(("[HalloweenEgg] zone=%s; uid=%s; model=%s; can_pick_up=%s; position=(%.2f, %.2f, %.2f)"):format(
		zoneName,
		tostring(uid),
		model.Name,
		tostring(attributes.HalloweenEggCanPickUp),
		position.X,
		position.Y,
		position.Z
	))
	for _, key in ipairs(attributeKeys) do
		print(("  %s = %s"):format(key, tostring(attributes[key])))
	end
end

local function watchHalloweenWorldEgg(instance)
	if not instance:IsA("Model") or halloweenEggConnections[instance] then
		return
	end

	printHalloweenWorldEgg(instance)
	halloweenEggConnections[instance] = instance.AttributeChanged:Connect(function()
		printHalloweenWorldEgg(instance)
	end)
end

local function unwatchHalloweenWorldEgg(instance)
	local connection = halloweenEggConnections[instance]
	if connection then
		connection:Disconnect()
		halloweenEggConnections[instance] = nil
	end
	lastHalloweenEggSignature[instance] = nil
	print(("[HalloweenEgg] removed; model=%s; uid=%s"):format(
		instance.Name,
		tostring(instance:GetAttribute("HalloweenEggUid"))
	))
end

-- EggState raises FieldRefreshed after receiving the list from EggWorld remotes.
EggState.FieldRefreshed:Connect(onSnapshot)
EggState.FieldShifted:Connect(printEggRecord)

for _, instance in ipairs(CollectionService:GetTagged("HalloweenWorldEgg")) do
	watchHalloweenWorldEgg(instance)
end
CollectionService:GetInstanceAddedSignal("HalloweenWorldEgg"):Connect(watchHalloweenWorldEgg)
CollectionService:GetInstanceRemovedSignal("HalloweenWorldEgg"):Connect(unwatchHalloweenWorldEgg)

-- Carried eggs can move between zones without changing attributes.
task.spawn(function()
	while true do
		task.wait(0.5)
		for _, instance in ipairs(CollectionService:GetTagged("HalloweenWorldEgg")) do
			printHalloweenWorldEgg(instance)
		end
	end
end)

-- Print the cached server list or request its initial snapshot.
task.defer(function()
	if EggState.HasFieldSnapshot() then
		onSnapshot(EggState.ReadFieldEggs())
	else
		EggState.SyncFieldEggs()
	end
end)
