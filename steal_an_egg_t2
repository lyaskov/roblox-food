-- Клиентская диагностика только фактически появившихся Halloween-яиц.
-- Выводит снимок при загрузке, изменениях мира и каждые 5 минут.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Assets = require(ReplicatedStorage.Data.Assets)
local HalloweenPets = require(ReplicatedStorage.Data.HalloweenPets)
local HalloweenDimension = require(ReplicatedStorage.Shared.Util.HalloweenDimension)
require(ReplicatedStorage.Shared.Remotes)
local logPrefix = "[HalloweenEggDiagnostics]"
local tagName = "HalloweenWorldEgg"
local tracked = {}
local watchedFolders = {}
local snapshotQueued = false
local lastReason = "initial"
local watchedRemotes = {}

local petIdByAlias = {}
for petId, spec in pairs(HalloweenPets.Specs) do
	petIdByAlias[petId] = petId
	petIdByAlias[spec.DisplayName] = petId
	petIdByAlias[spec.EggModel] = petId
	petIdByAlias[spec.DisplayName .. " Egg"] = petId
	if spec.Source then
		petIdByAlias[spec.Source] = petId
	end
	if spec.EggSource then
		petIdByAlias[spec.EggSource] = petId
	end
	local asset = Assets.Directory[petId]
	if asset and asset.Egg then
		petIdByAlias[asset.Egg.DisplayName] = petId
		petIdByAlias[asset.Egg.ModelName] = petId
	end
end

local function findPetId(model)
	local candidates = { model }
	for _, descendant in ipairs(model:GetDescendants()) do
		table.insert(candidates, descendant)
	end

	for _, candidate in ipairs(candidates) do
		local petId = petIdByAlias[candidate.Name]
		if petId then
			return petId
		end

		for _, value in pairs(candidate:GetAttributes()) do
			if typeof(value) == "string" then
				petId = petIdByAlias[value]
				if petId then
					return petId
				end
			end
		end

		if candidate:IsA("StringValue") then
			petId = petIdByAlias[candidate.Value]
			if petId then
				return petId
			end
		end
	end

	return nil
end

local function findReplicatedName(model)
	local nameAttributes = {
		"PreparedSourceName",
		"HalloweenEggName",
		"EggName",
		"DisplayName",
		"AssetCategory",
	}
	local candidates = { model }
	for _, descendant in ipairs(model:GetDescendants()) do
		table.insert(candidates, descendant)
	end

	for _, candidate in ipairs(candidates) do
		for _, attributeName in ipairs(nameAttributes) do
			local value = candidate:GetAttribute(attributeName)
			if typeof(value) == "string" and value ~= "" then
				local petId = petIdByAlias[value]
				local asset = petId and Assets.Directory[petId]
				if asset and asset.Egg and asset.Egg.DisplayName then
					return asset.Egg.DisplayName
				end
				return value
			end
		end
	end

	return nil
end

local function findZone(model, petId)
	local function zoneLabel(value)
		local zoneIndex = tonumber(tostring(value):match("(%d+)$"))
		local zone = zoneIndex and HalloweenDimension.Zones[zoneIndex]
		if zone then
			return string.format("Zone%d (%s)", zoneIndex, zone.DisplayName)
		end
		return tostring(value)
	end

	local current = model
	while current ~= nil and current ~= Workspace do
		for _, attributeName in ipairs({ "HalloweenEggZone", "Zone", "ZoneId", "AreaId" }) do
			local value = current:GetAttribute(attributeName)
			if typeof(value) == "number" or (typeof(value) == "string" and value ~= "") then
				return zoneLabel(value)
			end
		end

		local zoneNumber = current.Name:match("^Zone%s*(%d+)$")
		if zoneNumber then
			return zoneLabel("Zone" .. zoneNumber)
		end
		current = current.Parent
	end

	local spec = petId and HalloweenPets.Specs[petId]
	return spec and spec.Zone and zoneLabel("Zone" .. tostring(spec.Zone)) or "<unknown zone>"
end

local function describe(model)
	local petId = findPetId(model)
	local asset = petId and Assets.Directory[petId]
	local eggName = asset and asset.Egg and asset.Egg.DisplayName
	local spec = petId and HalloweenPets.Specs[petId]
	if not eggName then
		eggName = findReplicatedName(model) or (spec and spec.EggModel) or model.Name
	end

	return {
		Zone = findZone(model, petId),
		Name = eggName,
		PetId = petId or "<unknown>",
		Uid = model:GetAttribute("HalloweenEggUid"),
		Path = model:GetFullName(),
		Model = model,
	}
end

local collectIdentityEvidence

local function printSnapshot(reason)
	local byZone = {}
	local total = 0

	for model in pairs(tracked) do
		if model.Parent ~= nil
			and (CollectionService:HasTag(model, tagName) or typeof(model:GetAttribute("HalloweenEggUid")) == "string")
		then
			local entry = describe(model)
			byZone[entry.Zone] = byZone[entry.Zone] or {}
			table.insert(byZone[entry.Zone], entry)
			total += 1
		end
	end

	print(string.format("%s [%s] Найдено яиц: %d", logPrefix, reason, total))
	local zones = {}
	for zone in pairs(byZone) do
		table.insert(zones, zone)
	end
	table.sort(zones)

	if #zones == 0 then
		print(logPrefix, "В мире пока нет обнаруженных Halloween-яиц")
		return
	end

	for _, zone in ipairs(zones) do
		local entries = byZone[zone]
		table.sort(entries, function(a, b)
			return a.Name < b.Name
		end)
		print(string.format("%s %s: %d яиц", logPrefix, zone, #entries))
		for _, entry in ipairs(entries) do
			print(string.format(
				"%s   %s | pet=%s | uid=%s",
				logPrefix,
				entry.Name,
				entry.PetId,
				typeof(entry.Uid) == "string" and entry.Uid or "<нет uid>"
			))
			if entry.PetId == "<unknown>" then
				warn(logPrefix, "не удалось сопоставить имя; данные модели:", collectIdentityEvidence(entry.Model))
			end
		end
	end
end

collectIdentityEvidence = function(model)
	local evidence = {}
	local seen = {}
	local function add(value)
		value = tostring(value)
		if not seen[value] then
			seen[value] = true
			table.insert(evidence, value)
		end
	end

	local function addVisualProperties(instance)
		if instance:IsA("MeshPart") then
			add("MeshPart.MeshId=" .. instance.MeshId)
			add("MeshPart.TextureID=" .. instance.TextureID)
		elseif instance:IsA("SpecialMesh") then
			add("SpecialMesh.MeshId=" .. instance.MeshId)
			add("SpecialMesh.TextureId=" .. instance.TextureId)
		elseif instance:IsA("Decal") or instance:IsA("Texture") then
			add(instance.ClassName .. ".Texture=" .. instance.Texture)
		elseif instance:IsA("SurfaceAppearance") then
			add("SurfaceAppearance.ColorMap=" .. instance.ColorMap)
			add("SurfaceAppearance.MetalnessMap=" .. instance.MetalnessMap)
			add("SurfaceAppearance.NormalMap=" .. instance.NormalMap)
			add("SurfaceAppearance.RoughnessMap=" .. instance.RoughnessMap)
		elseif instance:IsA("BasePart") then
			add(string.format(
				"part=%s color=%s material=%s",
				instance.Name,
				tostring(instance.Color),
				instance.Material.Name
			))
		end
	end

	add("model=" .. model.Name .. " class=" .. model.ClassName)
	addVisualProperties(model)
	for key, value in pairs(model:GetAttributes()) do
		add("attr:" .. tostring(key) .. "=" .. tostring(value))
	end
	for _, descendant in ipairs(model:GetDescendants()) do
		add("child=" .. descendant.ClassName .. ":" .. descendant.Name)
		addVisualProperties(descendant)
		for key, value in pairs(descendant:GetAttributes()) do
			add("attr:" .. tostring(key) .. "=" .. tostring(value))
		end
		if descendant:IsA("StringValue") then
			add("value:" .. descendant.Name .. "=" .. descendant.Value)
		end
		if #evidence >= 80 then
			add("<evidence truncated>")
			break
		end
	end
	table.sort(evidence)
	return table.concat(evidence, " | ")
end

local function remoteLooksRelevant(remote)
	local fullName = remote:GetFullName():lower()
	if string.find(fullName, "monsterhit", 1, true) then
		return false
	end
	return string.find(fullName, "halloween", 1, true) ~= nil
		or string.find(fullName, "egg", 1, true) ~= nil
		or string.find(fullName, "zone", 1, true) ~= nil
		or string.find(fullName, "area", 1, true) ~= nil
		or string.find(fullName, "rotation", 1, true) ~= nil
		or string.find(fullName, "spawn", 1, true) ~= nil
		or string.find(fullName, "world", 1, true) ~= nil
end

local function formatRemoteValue(value, depth, seen)
	local kind = typeof(value)
	if kind == "Instance" then
		return value:GetFullName()
	elseif type(value) ~= "table" then
		return tostring(value)
	elseif depth >= 3 then
		return "<table>"
	elseif seen[value] then
		return "<cycle>"
	end

	seen[value] = true
	local parts = {}
	local count = 0
	for key, child in pairs(value) do
		count += 1
		if count > 30 then
			table.insert(parts, "…")
			break
		end
		table.insert(parts, tostring(key) .. "=" .. formatRemoteValue(child, depth + 1, seen))
	end
	table.sort(parts)
	seen[value] = nil
	return "{" .. table.concat(parts, ", ") .. "}"
end

local function containsEggData(value, depth, seen)
	if depth > 5 then
		return false
	end

	if typeof(value) == "Instance" then
		if petIdByAlias[value.Name] or value:GetAttribute("HalloweenEggUid") ~= nil then
			return true
		end
		for _, attributeValue in pairs(value:GetAttributes()) do
			if typeof(attributeValue) == "string" and petIdByAlias[attributeValue] then
				return true
			end
		end
		return false
	elseif type(value) == "string" then
		return petIdByAlias[value] ~= nil
			or string.find(value:lower(), "halloween", 1, true) ~= nil
			or string.find(value:lower(), "egg", 1, true) ~= nil
	elseif type(value) ~= "table" then
		return false
	end

	if seen[value] then
		return false
	end
	seen[value] = true
	for key, child in pairs(value) do
		if (type(key) == "string" and (string.find(key:lower(), "zone", 1, true) or string.find(key:lower(), "egg", 1, true)))
			or containsEggData(child, depth + 1, seen)
		then
			seen[value] = nil
			return true
		end
	end
	seen[value] = nil
	return false
end

local function watchRemote(instance)
	if not instance:IsA("RemoteEvent") or watchedRemotes[instance] then
		return
	end

	watchedRemotes[instance] = true
	if remoteLooksRelevant(instance) then
		print(logPrefix, "подписка на RemoteEvent:", instance:GetFullName())
	end
	instance.OnClientEvent:Connect(function(...)
		local args = table.pack(...)
		local relevant = remoteLooksRelevant(instance)
		if not relevant then
			for index = 1, args.n do
				if containsEggData(args[index], 0, {}) then
					relevant = true
					break
				end
			end
		end
		if not relevant then
			return
		end

		print(string.format("%s серверное событие %s (%d арг.)", logPrefix, instance:GetFullName(), args.n))
		for index = 1, args.n do
			print(logPrefix, "arg" .. index .. " = " .. formatRemoteValue(args[index], 0, {}))
		end
	end)
end

local function scheduleSnapshot(reason)
	lastReason = reason
	if snapshotQueued then
		return
	end
	snapshotQueued = true
	task.defer(function()
		snapshotQueued = false
		printSnapshot(lastReason)
	end)
end

local function track(instance, reason)
	if not instance:IsA("Model") or tracked[instance] then
		return
	end

	local connections = {}
	tracked[instance] = connections

	local function changed()
		scheduleSnapshot("обновление")
	end

	local function watchInstanceAttributes(target)
		for _, attributeName in ipairs({
		"HalloweenEggUid", "HalloweenEggZone", "Zone", "ZoneId", "AreaId",
		"HalloweenEggPetId", "PetId", "AssetId", "HalloweenEggName",
		}) do
			table.insert(connections, target:GetAttributeChangedSignal(attributeName):Connect(changed))
		end
		if target:IsA("StringValue") then
			table.insert(connections, target.Changed:Connect(changed))
		end
	end

	watchInstanceAttributes(instance)
	for _, descendant in ipairs(instance:GetDescendants()) do
		watchInstanceAttributes(descendant)
	end
	table.insert(connections, instance.DescendantAdded:Connect(function(descendant)
		watchInstanceAttributes(descendant)
		changed()
	end))
	table.insert(connections, instance.DescendantRemoving:Connect(changed))

	table.insert(connections, instance.AncestryChanged:Connect(changed))
	table.insert(connections, instance.Destroying:Connect(function()
		for _, connection in ipairs(connections) do
			connection:Disconnect()
		end
		tracked[instance] = nil
		scheduleSnapshot("яйцо удалено")
	end))

	scheduleSnapshot(reason)
end

local function watchWorldEggs(folder)
	if watchedFolders[folder] then
		return
	end
	watchedFolders[folder] = true

	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("Model") then
			track(child, "снимок WorldEggs")
		end
	end

	folder.ChildAdded:Connect(function(child)
		if child:IsA("Model") then
			track(child, "яйцо появилось")
		end
	end)
	folder.ChildRemoved:Connect(function(child)
		if tracked[child] then
			scheduleSnapshot("яйцо перемещено/удалено")
		end
	end)
end

for _, instance in ipairs(Workspace:GetDescendants()) do
	if instance.Name == "WorldEggs" and (instance:IsA("Folder") or instance:IsA("Model")) then
		watchWorldEggs(instance)
	end
end

for _, instance in ipairs(game:GetDescendants()) do
	watchRemote(instance)
end
game.DescendantAdded:Connect(watchRemote)

for _, instance in ipairs(CollectionService:GetTagged(tagName)) do
	track(instance, "тег уже присутствует")
end

CollectionService:GetInstanceAddedSignal(tagName):Connect(function(instance)
	track(instance, "яйцо появилось")
end)
CollectionService:GetInstanceRemovedSignal(tagName):Connect(function(instance)
	if tracked[instance] then
		scheduleSnapshot("яйцо удалено из мира")
	end
end)

Workspace.DescendantAdded:Connect(function(instance)
	if instance.Name == "WorldEggs" and (instance:IsA("Folder") or instance:IsA("Model")) then
		watchWorldEggs(instance)
	elseif instance:IsA("Model") and CollectionService:HasTag(instance, tagName) then
		track(instance, "яйцо появилось")
	end
end)

scheduleSnapshot("загрузка")

task.spawn(function()
	while true do
		task.wait(300)
		printSnapshot("проверка ротации через 5 минут")
	end
end)
