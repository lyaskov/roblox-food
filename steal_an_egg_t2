-- Compact console-only diagnostics for Halloween world eggs.
-- Prints only when the detected snapshot changes, plus a 5-minute refresh.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Assets = require(ReplicatedStorage.Data.Assets)
local HalloweenPets = require(ReplicatedStorage.Data.HalloweenPets)
local HalloweenDimension = require(ReplicatedStorage.Shared.Util.HalloweenDimension)
require(ReplicatedStorage.Shared.Remotes)

local PREFIX = "[HalloweenEggs]"
local TAG = "HalloweenWorldEgg"
local tracked = {}
local watchedFolders = {}
local watchedRemotes = {}
local petIdByUid = {}
local lastSnapshot = nil
local scheduleSnapshot
local queued = false
local revision = 0
local lastReason = "startup"

-- Both mesh IDs were visually checked by the user against Hooded Gerbil.
local HOODED_GERBIL_MESHES = {
	["85596455133555"] = true,
	["70705556141109"] = true,
}

local petIdByAlias = {}
for petId, spec in pairs(HalloweenPets.Specs) do
	petIdByAlias[petId] = petId
	petIdByAlias[spec.DisplayName] = petId
	petIdByAlias[spec.EggModel] = petId
	petIdByAlias[spec.DisplayName .. " Egg"] = petId
	if spec.Source then petIdByAlias[spec.Source] = petId end
	if spec.EggSource then petIdByAlias[spec.EggSource] = petId end
	local asset = Assets.Directory[petId]
	if asset and asset.Egg then
		petIdByAlias[asset.Egg.DisplayName] = petId
		petIdByAlias[asset.Egg.ModelName] = petId
	end
end

local function getMeshIds(model)
	local ids = {}
	for _, item in ipairs(model:GetDescendants()) do
		if item:IsA("MeshPart") or item:IsA("SpecialMesh") then
			local id = item.MeshId:match("%d+")
			if id then ids[id] = true end
		end
	end
	return ids
end

local function getModelPetId(model)
	local candidates = { model }
	for _, item in ipairs(model:GetDescendants()) do
		table.insert(candidates, item)
	end
	for _, item in ipairs(candidates) do
		local id = petIdByAlias[item.Name]
		if id then return id, "model name" end
		for key, value in pairs(item:GetAttributes()) do
			if typeof(value) == "string" then
				id = petIdByAlias[value]
				if id then return id, "attribute " .. key end
			end
		end
		if item:IsA("StringValue") then
			id = petIdByAlias[item.Value]
			if id then return id, "StringValue" end
		end
	end
	return nil
end

local function getZone(model, petId)
	local current = model
	while current and current ~= Workspace do
		for _, key in ipairs({ "HalloweenEggZone", "Zone", "ZoneId", "AreaId" }) do
			local value = current:GetAttribute(key)
			if typeof(value) == "number" or (typeof(value) == "string" and value ~= "") then
				local n = tonumber(tostring(value):match("(%d+)$"))
				local zone = n and HalloweenDimension.Zones[n]
				return zone and string.format("Z%d %s", n, zone.DisplayName) or tostring(value)
			end
		end
		local n = tonumber(current.Name:match("^Zone%s*(%d+)$"))
		if n then
			local zone = HalloweenDimension.Zones[n]
			return zone and string.format("Z%d %s", n, zone.DisplayName) or ("Zone" .. n)
		end
		current = current.Parent
	end
	local spec = petId and HalloweenPets.Specs[petId]
	local zone = spec and spec.Zone and HalloweenDimension.Zones[spec.Zone]
	return zone and string.format("Z%d %s", spec.Zone, zone.DisplayName) or "Z?"
end

local function describe(model)
	local petId, source = getModelPetId(model)
	local uid = model:GetAttribute("HalloweenEggUid")
	if not petId and typeof(uid) == "string" then
		petId = petIdByUid[uid]
		if petId then source = "server UID record" end
	end

	local meshIds = getMeshIds(model)
	if not petId and meshIds["85596455133555"] and meshIds["70705556141109"] then
		petId = "Hooded Gerbil"
		source = "user-confirmed mesh pair"
	end

	if not petId and model.Name == "HalloweenEgg" and getZone(model) == "Z2 Haunted Swamp" then
		petId = "Hooded Gerbil"
		source = "zone guess (unconfirmed)"
	end

	local asset = petId and Assets.Directory[petId]
	local eggName = asset and asset.Egg and asset.Egg.DisplayName
	eggName = eggName or model.Name
	local meshSummary = ""
	if not petId then
		local ids = {}
		for id in pairs(meshIds) do table.insert(ids, id) end
		table.sort(ids)
		if #ids > 0 then meshSummary = " | meshes=" .. table.concat(ids, ",") end
	end

	return {
		uid = typeof(uid) == "string" and uid or "-",
		zone = getZone(model, petId),
		name = eggName,
		pet = petId or "?",
		source = source or "unidentified",
		meshes = meshSummary,
	}
end

local function printSnapshot(reason)
	local rows = {}
	for model in pairs(tracked) do
		if model.Parent and (CollectionService:HasTag(model, TAG)
			or typeof(model:GetAttribute("HalloweenEggUid")) == "string") then
			table.insert(rows, describe(model))
		end
	end
	table.sort(rows, function(a, b)
		if a.zone ~= b.zone then return a.zone < b.zone end
		if a.name ~= b.name then return a.name < b.name end
		return a.uid < b.uid
	end)

	local signatureParts = {}
	for _, row in ipairs(rows) do
		table.insert(signatureParts, table.concat({ row.zone, row.name, row.pet, row.source, row.uid, row.meshes }, "|"))
	end
	local signature = table.concat(signatureParts, "\n")
	if signature == lastSnapshot then return end
	lastSnapshot = signature

	print(string.format("%s %d eggs | %s", PREFIX, #rows, reason))
	if #rows == 0 then
		print(PREFIX .. " No Halloween eggs currently detected")
		return
	end
	for _, row in ipairs(rows) do
		print(string.format("%s %s | %s | %s | uid=%s | via=%s%s",
			PREFIX, row.zone, row.name, row.pet, row.uid, row.source, row.meshes))
	end
end

scheduleSnapshot = function(reason)
	lastReason = reason
	revision += 1
	if queued then return end
	queued = true
	task.spawn(function()
		local seenRevision = revision
		repeat
			task.wait(0.6)
			seenRevision = revision
			task.wait(0.25)
		until seenRevision == revision
		queued = false
		printSnapshot(lastReason)
	end)
end

local function watchModel(model, reason)
	if not model:IsA("Model") or tracked[model] then return end
	tracked[model] = true
	local function changed() scheduleSnapshot("world updated") end
	for _, key in ipairs({ "HalloweenEggUid", "HalloweenEggZone", "Zone", "ZoneId", "AreaId", "HalloweenEggPetId", "PetId", "AssetId", "HalloweenEggName" }) do
		model:GetAttributeChangedSignal(key):Connect(changed)
	end
	model.DescendantAdded:Connect(changed)
	model.DescendantRemoving:Connect(changed)
	model.AncestryChanged:Connect(changed)
	model.Destroying:Connect(function()
		tracked[model] = nil
		scheduleSnapshot("egg removed")
	end)
	scheduleSnapshot(reason)
end

local function watchWorldEggs(folder)
	if watchedFolders[folder] then return end
	watchedFolders[folder] = true
	for _, child in ipairs(folder:GetChildren()) do watchModel(child, "world scan") end
	folder.ChildAdded:Connect(function(child) watchModel(child, "egg appeared") end)
	folder.ChildRemoved:Connect(function() scheduleSnapshot("egg moved or removed") end)
end

local function indexServerEggs(value, depth, seen)
	if type(value) ~= "table" or depth > 6 or seen[value] then return false end
	seen[value] = true
	local changed = false
	local uid = value.Uid or value.UID
	local category = value.AssetCategory
	if typeof(uid) == "string" and typeof(category) == "string" and HalloweenPets.Specs[category]
		and petIdByUid[uid] ~= category then
		petIdByUid[uid] = category
		changed = true
	end
	for _, child in pairs(value) do
		if type(child) == "table" and indexServerEggs(child, depth + 1, seen) then changed = true end
	end
	seen[value] = nil
	return changed
end

local function watchRemote(instance)
	if not instance:IsA("RemoteEvent") or watchedRemotes[instance] then return end
	local fullName = instance:GetFullName():lower()
	if not string.find(fullName, "eggworld/fieldeggshifted", 1, true)
		and not string.find(fullName, "eggworld/fieldeggbatchshifted", 1, true) then return end
	watchedRemotes[instance] = true
	instance.OnClientEvent:Connect(function(...)
		local changed = false
		for _, value in ipairs(table.pack(...)) do
			if indexServerEggs(value, 0, {}) then changed = true end
		end
		if changed then scheduleSnapshot("server identity updated") end
	end)
end

for _, item in ipairs(Workspace:GetDescendants()) do
	if item.Name == "WorldEggs" and (item:IsA("Folder") or item:IsA("Model")) then watchWorldEggs(item) end
end
for _, item in ipairs(game:GetDescendants()) do watchRemote(item) end
game.DescendantAdded:Connect(watchRemote)

for _, model in ipairs(CollectionService:GetTagged(TAG)) do watchModel(model, "existing tagged egg") end
CollectionService:GetInstanceAddedSignal(TAG):Connect(function(model) watchModel(model, "egg appeared") end)
Workspace.DescendantAdded:Connect(function(item)
	if item.Name == "WorldEggs" and (item:IsA("Folder") or item:IsA("Model")) then
		watchWorldEggs(item)
	elseif item:IsA("Model") and CollectionService:HasTag(item, TAG) then
		watchModel(item, "egg appeared")
	end
end)

scheduleSnapshot("startup")
task.spawn(function()
	while true do
		task.wait(300)
		scheduleSnapshot("5-minute refresh")
	end
end)
