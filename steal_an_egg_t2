-- Prints live Halloween pet eggs grouped by zone on snapshot/update events.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local EggState = require(ReplicatedStorage.Client.EggState)
local HalloweenDimension = require(ReplicatedStorage.Shared.Util.HalloweenDimension)
local HalloweenPets = require(ReplicatedStorage.Data.HalloweenPets)
local Assets = require(ReplicatedStorage.Data.Assets)
local EggRecords = require(ReplicatedStorage.Shared.Util.EggRecords)

local function normalized(value)
	return string.lower((string.gsub(tostring(value or ""), "[^%w]", "")))
end

local function getZoneIndex(record, petSpec)
	local areaId = normalized(record.AreaId)
	for index, zone in ipairs(HalloweenDimension.Zones) do
		local zoneName = normalized(zone.DisplayName)
		if areaId == zoneName or string.find(areaId, zoneName, 1, true) then
			return index
		end
		if string.find(areaId, "zone" .. index, 1, true) then
			return index
		end
	end

	local position
	if typeof(record.BottomCFrame) == "CFrame" then
		position = record.BottomCFrame.Position
	elseif typeof(record.BoundsCFrame) == "CFrame" then
		position = record.BoundsCFrame.Position
	end

	local map = Workspace:FindFirstChild(HalloweenDimension.MapName)
	local zones = map and map:FindFirstChild("Zones")
	if position and zones then
		for _, part in ipairs(zones:GetChildren()) do
			local index = tonumber(string.match(part.Name, "^Zone(%d+)$"))
			if index and part:IsA("BasePart") then
				local localPosition = part.CFrame:PointToObjectSpace(position)
				if math.abs(localPosition.X) <= part.Size.X * 0.5
					and math.abs(localPosition.Z) <= part.Size.Z * 0.5 then
					return index
				end
			end
		end
	end

	return petSpec and petSpec.Zone
end

local function printSnapshot(snapshot)
	if type(snapshot) ~= "table" or type(snapshot.Records) ~= "table" then
		return
	end

	local eggsByZone = {}
	for zoneIndex in ipairs(HalloweenDimension.Zones) do
		eggsByZone[zoneIndex] = {}
	end

	for _, record in ipairs(snapshot.Records) do
		local assetId = record.AssetCategory
		local petSpec = HalloweenPets.Specs[assetId]

		local zoneIndex = getZoneIndex(record, petSpec)
		if not zoneIndex or not eggsByZone[zoneIndex] then
			continue
		end

		local ok, eggName = pcall(EggRecords.DisplayName, record)
		if not ok or type(eggName) ~= "string" or eggName == "" then
			local asset = Assets.Directory[assetId]
			eggName = asset and asset.Egg and asset.Egg.DisplayName or (petSpec and petSpec.EggModel) or assetId
		end
		table.insert(eggsByZone[zoneIndex], eggName)
	end

	for zoneIndex, zone in ipairs(HalloweenDimension.Zones) do
		local eggNames = eggsByZone[zoneIndex]
		table.sort(eggNames)
		print(("[HalloweenEggs] zone=%s; eggs=%d"):format(zone.DisplayName, #eggNames))

		for _, eggName in ipairs(eggNames) do
			print(("[HalloweenEggs] zone=%s; egg=%s"):format(
				zone.DisplayName,
				eggName
			))
		end
	end
end

local function printCurrentSnapshot()
	printSnapshot(EggState.ReadFieldEggs())
end

-- FieldRefreshed carries the complete field snapshot: initial load and global refresh.
EggState.FieldRefreshed:Connect(printSnapshot)

if EggState.HasFieldSnapshot() then
	printCurrentSnapshot()
else
	task.spawn(function()
		local ok, err = pcall(function()
			EggState.SyncFieldEggs()
		end)
		if not ok then
			warn("[HalloweenPets] Failed to load egg snapshot: " .. tostring(err))
		end
	end)
end
