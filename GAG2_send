print("========================================")
print("[FIXED] Starting direct UserId resolution...")
print("========================================")

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local TARGET_NAME = "PluvarionTV"
local NOTE = "Tomato seeds for you!"

local sharedModules = ReplicatedStorage:FindFirstChild("SharedModules")
local networkingModule = sharedModules and sharedModules:FindFirstChild("Networking")
local success, networking = pcall(require, networkingModule)

if not success or not networking then
	warn("[ERROR] Failed to load Networking!")
	return
end

local Mailbox = networking.Mailbox

---------------------------------------------------------------------------
-- 1. Функция получения UserId через официальный API Roblox (Без LookupPlayer)
---------------------------------------------------------------------------
local function getUserIdByName(username)
	-- Проверяем локально
	for _, p in ipairs(Players:GetPlayers()) do
		if string.lower(p.Name) == string.lower(username) then
			return p.UserId
		end
	end
	
	-- Если игрока нет на сервере, запрашиваем у Roblox API
	local ok, userId = pcall(function()
		return Players:GetUserIdFromNameAsync(username)
	end)
	
	if ok and userId then
		return userId
	end
	
	return nil
end

---------------------------------------------------------------------------
-- 2. Отправка почты по полученному UserId
---------------------------------------------------------------------------
local function sendTomatoMail()
	print("[DEBUG] Resolving UserId for:", TARGET_NAME)
	local targetUserId = getUserIdByName(TARGET_NAME)
	
	if not targetUserId then
		warn("[ERROR] Could not find UserId for player:", TARGET_NAME)
		return
	end
	
	print(string.format("[DEBUG] UserId resolved: %d (%s)", targetUserId, TARGET_NAME))
	
	-- Пробуем 2 варианта упакованного массива предметов
	-- ВАРИАНТ 1: Таблица с текстовым названием предмета
	local itemsVariant1 = {
		{
			Category = "Seeds",
			ItemKey = "Tomato Seed", -- На основе лога консоли "Tomato Seed"
			Count = 1,
		}
	}

	-- Подписываемся на результат
	pcall(function()
		Mailbox.SendBatch:Response(function(ok, msg)
			print("[RESPONSE] SendBatch Result: ok =", ok, "msg =", msg)
		end)
	end)

	print("[DEBUG] Firing SendBatch with UserId:", targetUserId)
	local ok, err = pcall(function()
		Mailbox.SendBatch:Fire(targetUserId, itemsVariant1, NOTE)
	end)

	if ok then
		print("[SUCCESS] SendBatch packet sent successfully!")
	else
		warn("[ERROR] SendBatch Fire failed:", err)
	end
end

---------------------------------------------------------------------------
-- Нажатие на клавишу 'K'
---------------------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.K then
		print("[KEYPRESS] Key K pressed - Triggering direct send!")
		sendTomatoMail()
	end
end)

print("[READY] Press 'K' to send Tomato Seed to Pluvarion!")

-- Авто-запуск через 2 секунды
task.spawn(function()
	task.wait(2)
	sendTomatoMail()
end)
