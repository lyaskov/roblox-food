-- TestMailSend: Полный клиентский скрипт отправки почты
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

-- Подключение сетевого модуля игры
local Networking = ReplicatedStorage.SharedModules:WaitForChild("Networking")
local networking = require(Networking)
local Mailbox = networking.Mailbox

-- 🎯 НАСТРОЙКИ
local TARGET_PLAYER_NAME = "PluvarionTV"
local TEST_NOTE = "Tomato seeds for you!"

---------------------------------------------------------------------------
-- Вспомогательные функции
---------------------------------------------------------------------------

-- Поиск игрока среди подключенных на текущем сервере
local function getPlayerByName(name)
	if name == "me" or name == "" then
		return player
	end

	for _, p in Players:GetPlayers() do
		if string.lower(p.Name) == string.lower(name) then
			return p
		end
	end
	return nil
end

---------------------------------------------------------------------------
-- Запрос содержимого почтового ящика
---------------------------------------------------------------------------
local function listMailbox()
	print("[TestMailSend] Запрос списка сообщений...")

	local listPacket = Mailbox.List

	pcall(function()
		listPacket:Response(function(...)
			print("[TestMailSend] [Response] Содержимое почты:", ...)
		end)
	end)

	local success, err = pcall(function()
		listPacket:Fire()
	end)

	if success then
		print("[TestMailSend] Запрос на список почты успешно отправлен.")
	else
		warn("[TestMailSend] Ошибка запроса списка почты:", err)
	end
end

---------------------------------------------------------------------------
-- Отправка письма с семенами томата
---------------------------------------------------------------------------
local function sendTestMail(targetUserId)
	if not targetUserId then
		warn("[TestMailSend] Ошибка: UserId получателя не указан!")
		return false
	end

	print("[TestMailSend] Отправка семян томата на UserId:", targetUserId)

	-- Структура предмета (Семена томата)
	local items = {
		{
			["Category"] = "Seeds",
			["ItemKey"] = "Tomato",
			["Count"] = 1,
		},
	}

	local batchPacket = Mailbox.SendBatch

	-- Регистрация коллбэка для получения ответа от сервера
	pcall(function()
		batchPacket:Response(function(ok, message)
			print("[TestMailSend] [Response] SendBatch ok =", ok, "message =", message)
			if ok then
				print("[TestMailSend] ✓ Почта успешно отправлена!")
			else
				warn("[TestMailSend] ✗ Сервер отклонил отправку:", message)
			end
		end)
	end)

	-- Отправка пакета на сервер
	local success, err = pcall(function()
		batchPacket:Fire(targetUserId, items, TEST_NOTE)
	end)

	if success then
		print("[TestMailSend] Пакет SendBatch успешно отправлен.")
		return true
	else
		warn("[TestMailSend] Ошибка вызова SendBatch:", err)
		return false
	end
end

---------------------------------------------------------------------------
-- Поиск UserId игрока (если его нет на текущем сервере)
---------------------------------------------------------------------------
local function lookupAndSend(playerName)
	print("[TestMailSend] Поиск UserId для игрока:", playerName)

	local lookupPacket = Mailbox.LookupPlayer

	pcall(function()
		lookupPacket:Response(function(userId, name)
			print("[TestMailSend] [Response] LookupPlayer: userId =", userId, "name =", name)
			if userId and userId > 0 then
				print("[TestMailSend] Игрок найден:", playerName, "-> UserId:", userId)
				sendTestMail(userId)
			else
				warn("[TestMailSend] Игрок не найден:", playerName)
			end
		end)
	end)

	local success, err = pcall(function()
		lookupPacket:Fire(playerName)
	end)

	if not success then
		warn("[TestMailSend] Ошибка отправки запроса LookupPlayer:", err)
	end
end

---------------------------------------------------------------------------
-- Слушатель обновлений почтового ящика от сервера
---------------------------------------------------------------------------
local function setupMailboxListener()
	pcall(function()
		Mailbox.Updated:Response(function(...)
			print("[TestMailSend] [Event] MailboxUpdated:", ...)
		end)
	end)
end

---------------------------------------------------------------------------
-- Функция запуска отправки (Локальный поиск -> Lookup -> Отправка)
---------------------------------------------------------------------------
local function executeSend()
	local targetPlayer = getPlayerByName(TARGET_PLAYER_NAME)

	if targetPlayer then
		print("[TestMailSend] Игрок найден на сервере:", targetPlayer.Name)
		sendTestMail(targetPlayer.UserId)
	else
		print("[TestMailSend] Игрок не найден на сервере. Запуск LookupPlayer...")
		lookupAndSend(TARGET_PLAYER_NAME)
	end
end

---------------------------------------------------------------------------
-- ИНИЦИАЛИЗАЦИЯ И РУЧНОЙ ЗАПУСК
---------------------------------------------------------------------------

-- 1. Регистрируем фоновые слушатели
setupMailboxListener()

-- 2. Автоматический запуск при выполнении скрипта (через 2 секунды)
task.spawn(function()
	task.wait(2)
	print("[TestMailSend] 🚀 АВТО-ЗАПУСК: Отправка семян томата игроку:", TARGET_PLAYER_NAME)
	executeSend()
end)

-- 3. Управление горячими клавишами (K - Отправить, L - Показать почту)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end

	-- Клавиша [ K ] -> Выполнить отправку
	if input.KeyCode == Enum.KeyCode.K then
		print("[HotKey K] Запуск отправки семян томата...")
		executeSend()
	end

	-- Клавиша [ L ] -> Запросить список писем
	if input.KeyCode == Enum.KeyCode.L then
		print("[HotKey L] Запрос списка почты...")
		listMailbox()
	end
end)

print("[TestMailSend] Скрипт загружен!")
print("  - Авто-запуск сработает через 2 сек.")
print("  - Нажмите 'K' для повторной отправки.")
print("  - Нажмите 'L' для получения списка сообщений.")
