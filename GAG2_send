-- =========================================================================
-- Итоговый рабочий скрипт отправки семян томата (Replica/Mailbox)
-- =========================================================================

print("========================================")
print("[TestMailSend] Инициализация отправки семян...")
print("========================================")

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

-- 🎯 НАСТРОЙКИ
local TARGET_NAME = "PluvarionTV"
local NOTE = "Tomato seeds for you!"

---------------------------------------------------------------------------
-- 1. Подключение к сетевому модулю
---------------------------------------------------------------------------
local sharedModules = ReplicatedStorage:FindFirstChild("SharedModules")
local networkingModule = sharedModules and sharedModules:FindFirstChild("Networking")

if not networkingModule then
	warn("[ERROR] Не удалось найти модуль Networking!")
	return
end

local success, networking = pcall(require, networkingModule)
if not success or not networking then
	warn("[ERROR] Не удалось загрузить модуль Networking:", networking)
	return
end

local Mailbox = networking.Mailbox
if not Mailbox then
	warn("[ERROR] Объект Mailbox не найден!")
	return
end

print("[TestMailSend] Сетевой модуль Mailbox успешно подключен!")

---------------------------------------------------------------------------
-- 2. Получение UserId через API Roblox
---------------------------------------------------------------------------
local function getUserIdByName(username)
	for _, p in ipairs(Players:GetPlayers()) do
		if string.lower(p.Name) == string.lower(username) then
			return p.UserId
		end
	end
	
	local ok, userId = pcall(function()
		return Players:GetUserIdFromNameAsync(username)
	end)
	
	return ok and userId or nil
end

---------------------------------------------------------------------------
-- 3. Функция отправки семян томата через Mailbox.SendBatch
---------------------------------------------------------------------------
local function sendTomatoMail()
	print("[DEBUG] Поиск UserId для игрока:", TARGET_NAME)
	local targetUserId = getUserIdByName(TARGET_NAME)
	
	if not targetUserId then
		warn("[ERROR] Не удалось получить UserId для игрока:", TARGET_NAME)
		return
	end
	
	print(string.format("[DEBUG] UserId определен: %d (%s)", targetUserId, TARGET_NAME))

	-- 🎯 Правильная структура предмета из ReplicaService: {"Inventory", "Seeds", "Tomato"}
	local items = {
		{
			Category = "Seeds",
			ItemKey = "Tomato", -- Точное имя ключа из Replica!
			Count = 1,
		}
	}

	print("[DEBUG] Вызов SendBatch с правильным ключом 'Tomato'...")
	
	-- Подписываемся на отклик сервера
	pcall(function()
		if Mailbox.SendBatch.Response then
			Mailbox.SendBatch:Response(function(ok, msg)
				print("\n================ [SERVER RESPONSE] ================")
				print("Результат отправки:", ok, "| Сообщение:", msg)
				print("===================================================\n")
			end)
		end
	end)

	-- Отправляем пакет
	local ok, err = pcall(function()
		Mailbox.SendBatch:Fire(targetUserId, items, NOTE)
	end)

	if ok then
		print("[SUCCESS] Пакет SendBatch отправлен на сервер! Проверьте уменьшились ли семена в инвентаре.")
	else
		warn("[ERROR] Ошибка отправки:", err)
	end
end

---------------------------------------------------------------------------
-- 4. Управление и Авто-запуск
---------------------------------------------------------------------------

UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.K then
		print("[KEYPRESS] Нажата клавиша 'K' -> Отправка семян...")
		sendTomatoMail()
	end
end)

print("[READY] Нажмите 'K' для отправки!")

task.spawn(function()
	task.wait(2)
	print("[AUTO-START] Автоматическая отправка...")
	sendTomatoMail()
end)
