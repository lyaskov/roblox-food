-- =========================================================================
-- Итоговый рабочий скрипт отправки почты (Mailbox.Send со строкой)
-- =========================================================================

print("========================================")
print("[TestMailSend] Инициализация Mailbox.Send...")
print("========================================")

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

-- 🎯 НАСТРОЙКИ
local TARGET_NAME = "PluvarionTV"
local NOTE = "Tomato seeds for you!"
local ITEM_NAME = "Tomato Seed" -- Прямое имя предмета строкой!

---------------------------------------------------------------------------
-- 1. Подключение к сетевому модулю
---------------------------------------------------------------------------
local sharedModules = ReplicatedStorage:FindFirstChild("SharedModules")
local networkingModule = sharedModules and sharedModules:FindFirstChild("Networking")

if not networkingModule then
	warn("[ERROR] Не удалось найти модуль Networking!")
	return
end

local success, networking = pcall(require, networkingModule)
if not success or not networking then
	warn("[ERROR] Не удалось загрузить модуль Networking:", networking)
	return
end

local Mailbox = networking.Mailbox
if not Mailbox then
	warn("[ERROR] Объект Mailbox не найден!")
	return
end

print("[TestMailSend] Сетевой модуль Mailbox успешно загружен!")

---------------------------------------------------------------------------
-- 2. Получение UserId
---------------------------------------------------------------------------
local function getUserIdByName(username)
	for _, p in ipairs(Players:GetPlayers()) do
		if string.lower(p.Name) == string.lower(username) then
			return p.UserId
		end
	end
	
	local ok, userId = pcall(function()
		return Players:GetUserIdFromNameAsync(username)
	end)
	
	if ok and userId then
		return userId
	end
	
	return nil
end

---------------------------------------------------------------------------
-- 3. Функция отправки (3 СТРОКОВЫХ / ЧИСЛОВЫХ АРГУМЕНТА, БЕЗ ТАБЛИЦ)
---------------------------------------------------------------------------
local function sendTomatoMail()
	print("[DEBUG] Поиск UserId для игрока:", TARGET_NAME)
	local targetUserId = getUserIdByName(TARGET_NAME)
	
	if not targetUserId then
		warn("[ERROR] Не удалось получить UserId для игрока:", TARGET_NAME)
		return
	end
	
	print(string.format("[DEBUG] UserId определен: %d (%s)", targetUserId, TARGET_NAME))

	-- ВАРИАНТ 1: Send(UserId, ITEM_NAME, NOTE)
	print("[DEBUG] Отправка: UserId, ITEM_NAME, NOTE...")
	local ok1, err1 = pcall(function()
		Mailbox.Send:Fire(targetUserId, ITEM_NAME, NOTE)
	end)

	if ok1 then
		print("[SUCCESS] Пакет Mailbox.Send(UserId, ITEM_NAME, NOTE) успешно отправлен!")
		return
	else
		warn("[FAIL] Вариант 1 отклонен:", err1)
	end

	-- ВАРИАНТ 2: Send(UserId, NOTE, ITEM_NAME)
	print("[DEBUG] Отправка: UserId, NOTE, ITEM_NAME...")
	local ok2, err2 = pcall(function()
		Mailbox.Send:Fire(targetUserId, NOTE, ITEM_NAME)
	end)

	if ok2 then
		print("[SUCCESS] Пакет Mailbox.Send(UserId, NOTE, ITEM_NAME) успешно отправлен!")
		return
	else
		warn("[FAIL] Вариант 2 отклонен:", err2)
	end
end

---------------------------------------------------------------------------
-- 4. Управление и Авто-запуск
---------------------------------------------------------------------------

UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.K then
		print("[KEYPRESS] Нажата клавиша 'K' -> Запуск...")
		sendTomatoMail()
	end
end)

print("[READY] Нажмите 'K' для отправки!")

task.spawn(function()
	task.wait(2)
	print("[AUTO-START] Запуск отправки...")
	sendTomatoMail()
end)
