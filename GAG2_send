-- TestMailSend: Исправленный клиентский скрипт
print("==================================================")
print("[TestMailSend] Старт выполнения скрипта...")

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

-- 🎯 НАСТРОЙКИ
local TARGET_PLAYER_NAME = "Pluvarion"
local TEST_NOTE = "Tomato seeds for you!"

---------------------------------------------------------------------------
-- БЕЗОПАСНЫЙ ПОИСК МОДУЛЯ СЕТИ (С Таймаутом)
---------------------------------------------------------------------------
local sharedModules = ReplicatedStorage:WaitForChild("SharedModules", 5)
if not sharedModules then
	warn("[TestMailSend] ОШИБКА: Папка 'SharedModules' не найдена в ReplicatedStorage!")
	return
end

local networkingInstance = sharedModules:WaitForChild("Networking", 5)
if not networkingInstance then
	warn("[TestMailSend] ОШИБКА: Модуль 'Networking' не найден внутри SharedModules!")
	return
end

local successReq, networking = pcall(require, networkingInstance)
if not successReq or not networking then
	warn("[TestMailSend] ОШИБКА: Не удалось выполнить require(Networking):", networking)
	return
end

local Mailbox = networking.Mailbox
if not Mailbox then
	warn("[TestMailSend] ОШИБКА: Объекты 'Mailbox' отсутствуют в сетевом модуле!")
	return
end

print("[TestMailSend] Сетевой модуль Mailbox успешно подключен!")

---------------------------------------------------------------------------
-- Вспомогательные функции
---------------------------------------------------------------------------
local function getPlayerByName(name)
	if name == "me" or name == "" then
		return player
	end

	for _, p in Players:GetPlayers() do
		if string.lower(p.Name) == string.lower(name) then
			return p
		end
	end
	return nil
end

local function listMailbox()
	print("[TestMailSend] Запрос списка сообщений...")
	local listPacket = Mailbox.List

	pcall(function()
		listPacket:Response(function(...)
			print("[TestMailSend] [Response] Содержимое почты:", ...)
		end)
	end)

	local success, err = pcall(function()
		listPacket:Fire()
	end)

	if success then
		print("[TestMailSend] Запрос на список почты отправлен.")
	else
		warn("[TestMailSend] Ошибка запроса списка почты:", err)
	end
end

local function sendTestMail(targetUserId)
	if not targetUserId then
		warn("[TestMailSend] Ошибка: UserId получателя не указан!")
		return false
	end

	print("[TestMailSend] Отправка семян томата на UserId:", targetUserId)

	local items = {
		{
			["Category"] = "Seeds",
			["ItemKey"] = "Tomato",
			["Count"] = 1,
		},
	}

	local batchPacket = Mailbox.SendBatch

	pcall(function()
		batchPacket:Response(function(ok, message)
			print("[TestMailSend] [Response] SendBatch ok =", ok, "message =", message)
			if ok then
				print("[TestMailSend] ✓ Почта успешно отправлена!")
			else
				warn("[TestMailSend] ✗ Сервер отклонил отправку:", message)
			end
		end)
	end)

	local success, err = pcall(function()
		batchPacket:Fire(targetUserId, items, TEST_NOTE)
	end)

	if success then
		print("[TestMailSend] Пакет SendBatch отправлен.")
		return true
	else
		warn("[TestMailSend] Ошибка вызова SendBatch:", err)
		return false
	end
end

local function lookupAndSend(playerName)
	print("[TestMailSend] Поиск UserId для игрока:", playerName)
	local lookupPacket = Mailbox.LookupPlayer

	pcall(function()
		lookupPacket:Response(function(userId, name)
			print("[TestMailSend] [Response] LookupPlayer: userId =", userId, "name =", name)
			if userId and userId > 0 then
				print("[TestMailSend] Игрок найден:", playerName, "-> UserId:", userId)
				sendTestMail(userId)
			else
				warn("[TestMailSend] Игрок не найден:", playerName)
			end
		end)
	end)

	local success, err = pcall(function()
		lookupPacket:Fire(playerName)
	end)

	if not success then
		warn("[TestMailSend] Ошибка отправки запроса LookupPlayer:", err)
	end
end

local function executeSend()
	local targetPlayer = getPlayerByName(TARGET_PLAYER_NAME)

	if targetPlayer then
		print("[TestMailSend] Игрок найден на сервере:", targetPlayer.Name)
		sendTestMail(targetPlayer.UserId)
	else
		print("[TestMailSend] Игрок не найден на сервере. Запуск LookupPlayer...")
		lookupAndSend(TARGET_PLAYER_NAME)
	end
end

---------------------------------------------------------------------------
-- ИНИЦИАЛИЗАЦИЯ
---------------------------------------------------------------------------
pcall(function()
	Mailbox.Updated:Response(function(...)
		print("[TestMailSend] [Event] MailboxUpdated:", ...)
	end)
end)

-- Авто-запуск через 2 секунды
task.spawn(function()
	task.wait(2)
	print("[TestMailSend] 🚀 АВТО-ЗАПУСК: Отправка семян томата...")
	executeSend()
end)

-- Горячие клавиши (K и L)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end

	if input.KeyCode == Enum.KeyCode.K then
		print("[HotKey K] Ручной запуск отправки...")
		executeSend()
	end

	if input.KeyCode == Enum.KeyCode.L then
		print("[HotKey L] Запрос списка почты...")
		listMailbox()
	end
end)

print("[TestMailSend] Скрипт успешно инициализирован!")
print("  - Нажмите клавишу 'K' для отправки")
print("  - Нажмите клавишу 'L' для проверки почтового ящика")
print("==================================================")
