local ITEM_COUNT = 3 -- Количество для отправки

---------------------------------------------------------------------------
-- 1. Сетевой модуль Mailbox
---------------------------------------------------------------------------
local sharedModules = ReplicatedStorage:FindFirstChild("SharedModules")
local networkingModule = sharedModules and sharedModules:FindFirstChild("Networking")
local success, networking = pcall(require, networkingModule)

if not success or not networking or not networking.Mailbox then
	warn("[ERROR] Не удалось загрузить модуль Mailbox!")
	return
end

local Mailbox = networking.Mailbox

---------------------------------------------------------------------------
-- 2. Получение UserId через API Roblox
---------------------------------------------------------------------------
local function getUserIdByName(username)
	for _, p in ipairs(Players:GetPlayers()) do
		if string.lower(p.Name) == string.lower(username) then
			return p.UserId
		end
	end
	
	local ok, userId = pcall(function()
		return Players:GetUserIdFromNameAsync(username)
	end)
	return ok and userId or nil
end

---------------------------------------------------------------------------
-- 3. Функция отправки предмета
---------------------------------------------------------------------------
local function sendMail()
	local targetUserId = getUserIdByName(TARGET_NAME)
	if not targetUserId then
		warn("[ERROR] Не удалось найти UserId для игрока:", TARGET_NAME)
		return
	end

	-- Формирование структуры предмета (Replica format)
	local items = {
		{
			Category = ITEM_CATEGORY,
			ItemKey = ITEM_KEY,
			Count = ITEM_COUNT,
		}
	}

	print(string.format("[DEBUG] Попытка отправки: %d x '%s' [%s] -> %s (ID: %d)", ITEM_COUNT, ITEM_KEY, ITEM_CATEGORY, TARGET_NAME, targetUserId))

	local ok, err = pcall(function()
		Mailbox.SendBatch:Fire(targetUserId, items, NOTE)
	end)

	if ok then
		print(string.format("[SUCCESS] Успешно отправлено: %d x '%s' для %s!", ITEM_COUNT, ITEM_KEY, TARGET_NAME))
	else
		warn("[ERROR] Ошибка вызова Mailbox.SendBatch:", err)
	end
end

---------------------------------------------------------------------------
-- 4. Назначение горячей клавиши 'K'
---------------------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.K then
		sendMail()
	end
end)

print("========================================")
print(string.format("[READY] Готово! Нажмите 'K' для отправки: [%s -> %s]", ITEM_CATEGORY, ITEM_KEY))
print("========================================")
