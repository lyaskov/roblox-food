local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

-- 🎯 НАСТРОЙКИ ПОЛУЧАТЕЛЯ
local TARGET_NAME = "Pluvarion"
local NOTE = "Carrot seeds for you!"

---------------------------------------------------------------------------
-- 📚 СПИСОК ВСЕХ ДОСТУПНЫХ КАТЕГОРИЙ ИЗ ИГРЫ:
-- "Pets", "Sprinklers", "WateringCans", "Mushrooms", "Gnomes", 
-- "Raccoons", "Crates", "SeedPacks", "Trowels", "Props", 
-- "Seeds", "HarvestedFruits", "EmptyPots"
---------------------------------------------------------------------------

-- 📦 ВЫБОР ПРЕДМЕТА ДЛЯ ОТПРАВКИ (выберите один из вариантов ниже):

-- 🔹 Примеры семян (Seeds):
local ITEM_CATEGORY = "Seeds"
local ITEM_KEY = "Carrot"          -- Томат (Успешно протестировано!)
