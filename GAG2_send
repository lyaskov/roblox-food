-- =========================================================================
-- Итоговый рабочий скрипт отправки почты (Mailbox.Send со строкой)
-- =========================================================================

print("========================================")
print("[TestMailSend] Инициализация Mailbox.Send...")
print("========================================")

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:FindFirstChildOfClass("PlayerGui")

-- 🎯 НАСТРОЙКИ
local TARGET_NAME = "PluvarionTV"
local NOTE = "Tomato seeds for you!"
local ITEM_NAME = "Tomato Seed" -- Прямое имя предмета строкой!
local MAILBOX_UI_NAME = "MailboxUI"
local ITEM_CATEGORY = "Seeds"
local ITEM_COUNT = 1

---------------------------------------------------------------------------
-- 1. Подключение к сетевому модулю
---------------------------------------------------------------------------
local sharedModules = ReplicatedStorage:FindFirstChild("SharedModules")
local networkingModule = sharedModules and sharedModules:FindFirstChild("Networking")

if not networkingModule then
	warn("[ERROR] Не удалось найти модуль Networking!")
	return
end

local success, networking = pcall(require, networkingModule)
if not success or not networking then
	warn("[ERROR] Не удалось загрузить модуль Networking:", networking)
	return
end

local Mailbox = networking.Mailbox
if not Mailbox then
	warn("[ERROR] Объект Mailbox не найден!")
	return
end

print("[TestMailSend] Сетевой модуль Mailbox успешно загружен!")

---------------------------------------------------------------------------
-- 2. Получение UserId
---------------------------------------------------------------------------
local function getUserIdByName(username)
	for _, p in ipairs(Players:GetPlayers()) do
		if string.lower(p.Name) == string.lower(username) then
			return p.UserId
		end
	end

	local ok, userId = pcall(function()
		return Players:GetUserIdFromNameAsync(username)
	end)

	if ok and userId then
		return userId
	end

	return nil
end

---------------------------------------------------------------------------
-- 3. Проверка UI и функция отправки
---------------------------------------------------------------------------
local function isMailboxReady()
	local hud = playerGui and playerGui:FindFirstChild("HUD")
	local mailboxUi = hud and hud:FindFirstChild(MAILBOX_UI_NAME)
	return mailboxUi ~= nil and mailboxUi:IsA("ScreenGui") and mailboxUi.Enabled
end

local function sendTomatoMail()
	if not isMailboxReady() then
		warn("[ERROR] MailboxUI не открыт. Сначала открой почту в игре, потом отправляй снова.")
		return
	end
	print("[DEBUG] Поиск UserId для игрока:", TARGET_NAME)
	local targetUserId = getUserIdByName(TARGET_NAME)

	if not targetUserId then
		warn("[ERROR] Не удалось получить UserId для игрока:", TARGET_NAME)
		return
	end

	print(string.format("[DEBUG] UserId определен: %d (%s)", targetUserId, TARGET_NAME))

	local mailbox = Mailbox
	if mailbox and mailbox.SendBatch and mailbox.SendBatch.Fire then
		local items = {
			{
				Category = ITEM_CATEGORY,
				ItemKey = ITEM_NAME,
				Count = ITEM_COUNT,
			},
		}

		print("[DEBUG] Отправка: SendBatch(UserId, itemsTable, NOTE)...")
		local ok, err = pcall(function()
			mailbox.SendBatch:Fire(targetUserId, items, NOTE)
		end)

		if ok then
			print("[SUCCESS] Пакет Mailbox.SendBatch успешно отправлен!")
			return
		else
			warn("[FAIL] SendBatch отклонен:", err)
		end
	else
		warn("[ERROR] Mailbox.SendBatch не найден")
	end
end

---------------------------------------------------------------------------
-- 4. Управление и Авто-запуск
---------------------------------------------------------------------------

UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.K then
		print("[KEYPRESS] Нажата клавиша 'K' -> Запуск...")
		sendTomatoMail()
	end
end)

print("[READY] Нажмите 'K' для отправки! Сначала открой MailboxUI, если он закрыт.")

task.spawn(function()
	task.wait(2)
	print("[AUTO-START] Запуск отправки...")
	sendTomatoMail()
end)
