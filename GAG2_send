-- =========================================================================
-- Исправленный скрипт отправки почты (Нативный формат таблиц)
-- =========================================================================

print("========================================")
print("[TestMailSend] Инициализация Mailbox.Send...")
print("========================================")

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

-- 🎯 НАСТРОЙКИ ПОЛУЧАТЕЛЯ И ТЕКСТА
local TARGET_NAME = "PluvarionTV"
local NOTE = "Tomato seeds for you!"

---------------------------------------------------------------------------
-- 1. Подключение к сетевому модулю игры
---------------------------------------------------------------------------
local sharedModules = ReplicatedStorage:FindFirstChild("SharedModules")
local networkingModule = sharedModules and sharedModules:FindFirstChild("Networking")

if not networkingModule then
	warn("[ERROR] Не удалось найти модуль Networking!")
	return
end

local success, networking = pcall(require, networkingModule)
if not success or not networking then
	warn("[ERROR] Не удалось загрузить модуль Networking:", networking)
	return
end

local Mailbox = networking.Mailbox
if not Mailbox then
	warn("[ERROR] Объект Mailbox не найден в сетевом модуле!")
	return
end

print("[TestMailSend] Сетевой модуль Mailbox успешно загружен!")

---------------------------------------------------------------------------
-- 2. Получение UserId через API Roblox
---------------------------------------------------------------------------
local function getUserIdByName(username)
	for _, p in ipairs(Players:GetPlayers()) do
		if string.lower(p.Name) == string.lower(username) then
			return p.UserId
		end
	end
	
	local ok, userId = pcall(function()
		return Players:GetUserIdFromNameAsync(username)
	end)
	
	if ok and userId then
		return userId
	end
	
	return nil
end

---------------------------------------------------------------------------
-- 3. Функция отправки через Mailbox.Send (С передачей нативной таблицы)
---------------------------------------------------------------------------
local function sendTomatoMail()
	print("[DEBUG] Поиск UserId для игрока:", TARGET_NAME)
	local targetUserId = getUserIdByName(TARGET_NAME)
	
	if not targetUserId then
		warn("[ERROR] Не удалось получить UserId для игрока:", TARGET_NAME)
		return
	end
	
	print(string.format("[DEBUG] UserId определен: %d (%s)", targetUserId, TARGET_NAME))
	
	-- Структура предмета (Передаем нативный массив, а не JSON)
	local rawItems = {
		{
			Category = "Seeds",
			ItemKey = "Tomato Seed",
			Count = 1,
		}
	}

	print("[DEBUG] Вызов Mailbox.Send:Fire() с оригинальной таблицей...")
	local ok, err = pcall(function()
		-- 🎯 ПРАВИЛЬНЫЕ АРГУМЕНТЫ: (1: UserId [Number], 2: Items [Table], 3: Note [String])
		Mailbox.Send:Fire(targetUserId, rawItems, NOTE)
	end)

	if ok then
		print("[SUCCESS] Пакет Mailbox.Send успешно отправлен!")
	else
		warn("[ERROR] Ошибка вызова Mailbox.Send:Fire():", err)
	end
end

---------------------------------------------------------------------------
-- 4. Управление и Авто-запуск
---------------------------------------------------------------------------

UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.K then
		print("[KEYPRESS] Нажата клавиша 'K' -> Вызов Mailbox.Send...")
		sendTomatoMail()
	end
end)

print("[READY] Нажмите 'K' для отправки!")

task.spawn(function()
	task.wait(2)
	print("[AUTO-START] Запуск отправки...")
	sendTomatoMail()
end)
