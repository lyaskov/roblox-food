local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Networking = require(ReplicatedStorage:WaitForChild("SharedModules"):WaitForChild("Networking"))

local function getFirstAvailableWildPetRef()
	local map = workspace:FindFirstChild("Map")
	if not map then
		return nil
	end

	local wildPetRefFolder = map:FindFirstChild("WildPetRef")
	if not wildPetRefFolder then
		return nil
	end

	for _, refPart in ipairs(wildPetRefFolder:GetChildren()) do
		if refPart:IsA("BasePart") then
			local ownerUserId = refPart:GetAttribute("OwnerUserId")
			if ownerUserId == 0 or ownerUserId == nil then
				return refPart
			end
		end
	end

	return nil
end

local refPart = getFirstAvailableWildPetRef()
if not refPart then
	warn("AutoBuyFirstWildPetDebug: no available wild pet ref found")
	return
end

local pets = Networking and Networking.Pets
if not pets then
	warn("AutoBuyFirstWildPetDebug: Networking.Pets missing")
	return
end

local wildPetTame = pets.WildPetTame
if not wildPetTame then
	warn("AutoBuyFirstWildPetDebug: WildPetTame missing")
	return
end

wildPetTame:Fire(refPart)
print("AutoBuyFirstWildPetDebug: fired WildPetTame for", refPart:GetFullName())
