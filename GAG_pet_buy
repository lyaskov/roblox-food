local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

-- Функция отключения столкновений (Noclip), чтобы проходить сквозь преграды
local function enableNoclip(character)
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end

local function forceBuyPet(petModel)
    if not petModel then return end
    
    local rootPart = petModel:FindFirstChild("RootPart") or petModel:FindFirstChildWhichIsA("BasePart")
    local buyPrompt = rootPart and rootPart:FindFirstChild("BuyPrompt")
    
    if not buyPrompt then
        buyPrompt = petModel:FindFirstChild("BuyPrompt", true)
    end
    
    if not buyPrompt then
        warn("BuyPrompt не найден в модели:", petModel.Name)
        return
    end

    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    
    if hrp then
        -- 1. Включаем Noclip, чтобы физика игры не стопорила нас о стены
        enableNoclip(character)

        -- 2. Телепортируем прямо к питомцу, приподняв на 1.5 студа вверх (чтобы не застрять в земле)
        local targetCFrame = rootPart.CFrame * CFrame.new(0, 1.5, 2)
        hrp.CFrame = CFrame.lookAt(targetCFrame.Position, rootPart.Position)
        
        -- 3. Разворачиваем камеру на питомца
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, rootPart.Position)
        
        -- Даем серверу 0.2 сек, чтобы он зарегистрировал новую позицию игрока
        task.wait(0.2)
    end

    -- 4. Обход ограничений Prompt
    buyPrompt.RequiresLineOfSight = false
    buyPrompt.MaxActivationDistance = 9999
    
    -- 5. Покупка
    if fireproximityprompt then
        fireproximityprompt(buyPrompt, 0)
        fireproximityprompt(buyPrompt)
    else
        buyPrompt:InputHoldBegin()
        task.wait(buyPrompt.HoldDuration > 0 and buyPrompt.HoldDuration or 0.1)
        buyPrompt:InputHoldEnd()
    end

    print("[BUY] Покупка успешно отправлена на:", petModel.Name)
end

