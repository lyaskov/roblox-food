local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Networking = require(ReplicatedStorage:WaitForChild("SharedModules"):WaitForChild("Networking"))

local function getFirstAvailableWildPetRef()
	local map = workspace:FindFirstChild("Map")
	if not map then
		return nil
	end

	local wildPetRefFolder = map:FindFirstChild("WildPetRef")
	if not wildPetRefFolder then
		return nil
	end

	for _, refPart in ipairs(wildPetRefFolder:GetChildren()) do
		if refPart:IsA("BasePart") then
			local ownerUserId = refPart:GetAttribute("OwnerUserId")
			if ownerUserId == 0 or ownerUserId == nil then
				return refPart
			end
		end
	end

	return nil
end

local function tryBuy()
	local refPart = getFirstAvailableWildPetRef()
	if not refPart then
		warn("AutoBuyFirstWildPetDebug: no available wild pet ref found")
		return
	end

	if Networking and Networking.Pets and Networking.Pets.WildPetTame then
		Networking.Pets.WildPetTame:Fire(refPart)
		print("AutoBuyFirstWildPetDebug: fired WildPetTame for", refPart:GetFullName())
	else
		warn("AutoBuyFirstWildPetDebug: WildPetTame remote not found")
	end
end

local resultConnection
local wildPetTameResult = Networking and Networking.Pets and Networking.Pets.WildPetTameResult
if wildPetTameResult and wildPetTameResult.OnClientEvent then
	resultConnection = wildPetTameResult.OnClientEvent:Connect(function(refPart, timestamp)
		print("AutoBuyFirstWildPetDebug: WildPetTameResult", refPart and refPart:GetFullName(), timestamp)
		if resultConnection then
			resultConnection:Disconnect()
		end
	end)
end

tryBuy()
