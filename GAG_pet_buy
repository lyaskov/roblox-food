local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LogService = game:GetService("LogService")

print("--------------------------------------------------")
print("🔍 СКАНЕР АКТИВИРОВАН! Совершите покупку вручную...")
print("--------------------------------------------------")

-- Используем hookmetamethod (самый безопасный метод без блокировки функций)
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if not checkcaller() and (method == "FireServer" or method == "InvokeServer") then
        local remoteName = tostring(self)
        
        -- Выводим ВСЕ вызовы на сервер во время покупки
        print("\n[СЕТЕВОЙ ВЫЗОВ DETECTED]")
        print("Метод:", method)
        print("Путь:", self:GetFullName())
        
        -- Генерируем готовый Lua-код для вашей покупки
        local argsString = ""
        for i, arg in ipairs(args) do
            local val = type(arg) == "string" and ('"' .. tostring(arg) .. '"') or tostring(arg)
            argsString = argsString .. string.format("\n    [%d] = %s,", i, val)
        end
        
        print("👉 ГОТОВЫЙ КОД ДЛЯ СКРИПТА:")
        if method == "FireServer" then
            print(string.format('%s:FireServer(%s\n)', self:GetFullName(), argsString))
        else
            print(string.format('%s:InvokeServer(%s\n)', self:GetFullName(), argsString))
        end
        print("--------------------------------------------------")
    end

    return oldNamecall(self, ...)
end))
