local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

local DELAY_BETWEEN_BUYS = 1.0 -- Задержка между покупками для стабильности

-- Функция безопасного Noclip (только для частей тела, чтобы не мешали)
local function enableNoclip(character)
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            -- Спускаем CanCollide, но не трогаем Ground-проверки
            part.CanCollide = false
        end
    end
end

-- Функция покупки конкретного питомца с защитой от Void
local function buyPet(petModel)
    if not petModel or not petModel.Parent then return false end
    
    local rootPart = petModel:FindFirstChild("RootPart") or petModel:FindFirstChildWhichIsA("BasePart")
    local buyPrompt = rootPart and rootPart:FindFirstChild("BuyPrompt")
    
    if not buyPrompt then
        buyPrompt = petModel:FindFirstChild("BuyPrompt", true)
    end
    
    if not buyPrompt then return false end

    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    
    if hrp then
        -- 1. ГЛАВНЫЙ ФИКС: Якорим (замораживаем) персонажа в воздухе, чтобы он НЕ УПАЛ
        hrp.Anchored = true
        
        -- 2. Включаем Noclip
        enableNoclip(character)

        -- 3. Телепортируем и разворачиваем камеру
        -- Приподнимаем персонажа на 3 студа над питомцем, чтобы он точно был в зоне видимости
        local targetCFrame = rootPart.CFrame * CFrame.new(0, 3, 0)
        hrp.CFrame = CFrame.lookAt(targetCFrame.Position, rootPart.Position)
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, rootPart.Position)
        
        -- Даем серверу время "увидеть" игрока на новом месте (гравитация пока отключена)
        task.wait(0.3)
    end

    -- 4. Снимаем ограничения с Prompt
    buyPrompt.RequiresLineOfSight = false
    buyPrompt.MaxActivationDistance = 9999
    
    -- 5. Активация покупки
    if fireproximityprompt then
        fireproximityprompt(buyPrompt, 0) -- Мгновенная покупка
        fireproximityprompt(buyPrompt)
    else
        -- Запасной способ для стандартного Roblox
        buyPrompt:InputHoldBegin()
        task.wait(buyPrompt.HoldDuration > 0 and buyPrompt.HoldDuration or 0.1)
        buyPrompt:InputHoldEnd()
    end
    print("[AUTOBuy] Покупка отправлена на:", petModel.Name)

    -- Ждем завершения транзакции
    task.wait(0.3)

    -- 6. Размораживаем персонажа, чтобы он упал на землю и мог двигаться
    if hrp then
        hrp.Anchored = false
    end
    
    return true
end

-- Главная функция авто-фарма
local function buyAllWildPets()
    local spawnsFolder = Workspace.Map:FindFirstChild("WildPetSpawns")
    if not spawnsFolder then 
        warn("[AUTOBuy] Не найдена папка WildPetSpawns!")
        return 
    end

    local petsList = spawnsFolder:GetChildren()
    print("[AUTOBuy] Найдено питомцев на карте: " .. #petsList)

    for i, pet in ipairs(petsList) do
        print(string.format("[AUTOBuy] [%d/%d] Перемещение к %s...", i, #petsList, pet.Name))
        
        buyPet(pet)
        
        -- Ждем перед следующим перемещением (ПЕРСОНАЖ ОСТАЕТСЯ НА МЕСТЕ)
        task.wait(DELAY_BETWEEN_BUYS)
    end
    
    print("[AUTOBuy] Авто-фарм завершен!")
end

-- Запуск цикла один раз
buyAllWildPets()
