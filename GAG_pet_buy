local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

local DELAY_BETWEEN_BUYS = 0.8 -- Задержка между покупками

-- Безопасное отключение коллизий (только для тела, ступни не проваливаются)
local function safeNoclip(character)
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "Terrain" then
            -- Отключаем коллизию у торса и головы, но оставляем на мгновение для телепорта
            part.CanCollide = false
        end
    end
end

local function buyPet(petModel)
    if not petModel or not petModel.Parent then return false end
    
    local rootPart = petModel:FindFirstChild("RootPart") or petModel:FindFirstChildWhichIsA("BasePart")
    local buyPrompt = rootPart and rootPart:FindFirstChild("BuyPrompt")
    
    if not buyPrompt then
        buyPrompt = petModel:FindFirstChild("BuyPrompt", true)
    end
    
    if not buyPrompt then return false end

    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    
    if hrp then
        -- 1. Включаем безопасный Noclip
        safeNoclip(character)

        -- 2. Телепортируем прямо к питомцу (на высоту 2 студа над ним)
        -- Персонаж ТЕЛЕПОРТИРУЕТСЯ И ОСТАЕТСЯ ЗДЕСЬ
        local targetCFrame = rootPart.CFrame * CFrame.new(0, 2, 0)
        hrp.CFrame = CFrame.lookAt(targetCFrame.Position, rootPart.Position)
        
        -- 3. Направляем камеру на питомца
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, rootPart.Position)
        
        -- Ждем, пока сервер подтвердит координаты
        task.wait(0.25)
    end

    -- 4. Настройка Prompt
    buyPrompt.RequiresLineOfSight = false
    buyPrompt.MaxActivationDistance = 9999
    
    -- 5. Активация покупки
    if fireproximityprompt then
        fireproximityprompt(buyPrompt, 0)
        fireproximityprompt(buyPrompt)
    else
        buyPrompt:InputHoldBegin()
        task.wait(buyPrompt.HoldDuration > 0 and buyPrompt.HoldDuration or 0.1)
        buyPrompt:InputHoldEnd()
    end

    print("[BUY] Покупка отправлена на:", petModel.Name)
    return true
end

-- Авто-обход всей карты
local function buyAllWildPets()
    local spawnsFolder = Workspace.Map:FindFirstChild("WildPetSpawns")
    if not spawnsFolder then return end

    local petsList = spawnsFolder:GetChildren()
    print("[AUTOBuy] Питомцев на карте: " .. #petsList)

    for i, pet in ipairs(petsList) do
        buyPet(pet)
        -- Игрок остается возле последнего питомца!
        task.wait(DELAY_BETWEEN_BUYS)
    end
end

buyAllWildPets()
