local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

-- Задержка между покупками питомцев (в секундах)
local DELAY_BETWEEN_BUYS = 5

-- Функция откючения коллизий (Noclip)
local function enableNoclip(character)
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end

-- Функция покупки конкретного питомца
local function buyPet(petModel)
    if not petModel or not petModel.Parent then return false end
    
    local rootPart = petModel:FindFirstChild("RootPart") or petModel:FindFirstChildWhichIsA("BasePart")
    local buyPrompt = rootPart and rootPart:FindFirstChild("BuyPrompt")
    
    if not buyPrompt then
        buyPrompt = petModel:FindFirstChild("BuyPrompt", true)
    end
    
    if not buyPrompt then
        return false
    end

    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    
    if hrp then
        -- 1. Отключаем коллизии, чтобы проходить сквозь стены и текстуры
        enableNoclip(character)

        -- 2. Телепорт чуть выше и перед питомцем
        local targetCFrame = rootPart.CFrame * CFrame.new(0, 1.5, 2)
        hrp.CFrame = CFrame.lookAt(targetCFrame.Position, rootPart.Position)
        
        -- 3. Наводим камеру
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, rootPart.Position)
        
        -- Даем серверу время зарегистрировать новую позицию
        task.wait(1)
    end

    -- 4. Снимаем ограничения с Prompt
    buyPrompt.RequiresLineOfSight = false
    buyPrompt.MaxActivationDistance = 9999
    
    -- 5. Активируем покупку
    if fireproximityprompt then
        fireproximityprompt(buyPrompt, 0)
        fireproximityprompt(buyPrompt)
    else
        buyPrompt:InputHoldBegin()
        task.wait(buyPrompt.HoldDuration > 0 and buyPrompt.HoldDuration or 0.1)
        buyPrompt:InputHoldEnd()
    end

    print("[AUTOBuy] Попытка покупки:", petModel.Name)
    return true
end

-- Главная функция обхода всей карты
local function buyAllWildPets()
    local spawnsFolder = Workspace.Map:FindFirstChild("WildPetSpawns")
    
    if not spawnsFolder then
        warn("[AUTOBuy] Папка WildPetSpawns не найдена в Workspace.Map!")
        return
    end

    local petsList = spawnsFolder:GetChildren()
    print("[AUTOBuy] Найдено питомцев на карте: " .. #petsList)

    for i, pet in ipairs(petsList) do
        print(string.format("[AUTOBuy] [%d/%d] Покупка %s...", i, #petsList, pet.Name))
        
        buyPet(pet)
        
        -- Пауза между покупками для стабильности
        task.wait(DELAY_BETWEEN_BUYS)
    end
    
    print("[AUTOBuy] Обход карты завершен!")
end

-- Запуск цикла покупки
buyAllWildPets()
