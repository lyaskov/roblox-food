local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

-- НАСТРОЙКИ:
local MIN_TELEPORT_TIME = 5 -- МИНИМАЛЬНОЕ время полёта к каждому питомцу (не менее 5 сек)
local TELEPORT_SPEED = 80   -- Скорость для дальних расстояний (студов в секунду)
local DELAY_BETWEEN_BUYS = 1.0 -- Пауза после покупки каждого питомца

local MIN_LOOP_WAIT_MINUTES = 1 -- Минимальная пауза между обходами карты (в минутах)
local MAX_LOOP_WAIT_MINUTES = 5 -- Максимальная пауза между обходами карты (в минутах)

-- Создаем невидимую платформу под ноги
local safePlatform = Workspace:FindFirstChild("SafePetPlatform") or Instance.new("Part")
safePlatform.Name = "SafePetPlatform"
safePlatform.Size = Vector3.new(10, 1, 10)
safePlatform.Anchored = true
safePlatform.CanCollide = true
safePlatform.Transparency = 1
safePlatform.Parent = Workspace

-- Функция отключения коллизий на время полёта
local function setNoclip(character, enabled)
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not enabled
        end
    end
end

-- Функция плавного телепорта (НЕ МЕНЕЕ 5 секунд)
local function safeBypassTeleport(targetCFrame)
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local travelTime = math.max(MIN_TELEPORT_TIME, distance / TELEPORT_SPEED)

    print(string.format("[AUTOBuy] Расстояние: %.1fm. Время полёта: %.2f сек...", distance, travelTime))

    setNoclip(character, true)

    local tweenInfo = TweenInfo.new(travelTime, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    
    tween:Play()
    tween.Completed:Wait()

    setNoclip(character, false)
    return true
end

-- Функция покупки одного питомца
local function buyPet(petModel)
    if not petModel or not petModel.Parent then return false end
    
    local rootPart = petModel:FindFirstChild("RootPart") or petModel:FindFirstChildWhichIsA("BasePart")
    local buyPrompt = rootPart and rootPart:FindFirstChild("BuyPrompt", true)
    
    if not buyPrompt or not rootPart then return false end

    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    
    if hrp then
        local petPosition = rootPart.Position
        
        safePlatform.CFrame = CFrame.new(petPosition.X, petPosition.Y - 1, petPosition.Z)
        local targetCFrame = CFrame.new(petPosition.X, petPosition.Y + 2.5, petPosition.Z)
        
        safeBypassTeleport(targetCFrame)
        
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, petPosition)
        task.wait(0.3)
    end

    buyPrompt.RequiresLineOfSight = false
    buyPrompt.MaxActivationDistance = 9999
    
    if fireproximityprompt then
        fireproximityprompt(buyPrompt, 0)
        fireproximityprompt(buyPrompt)
    else
        buyPrompt:InputHoldBegin()
        task.wait(buyPrompt.HoldDuration > 0 and buyPrompt.HoldDuration or 0.1)
        buyPrompt:InputHoldEnd()
    end

    print("[AUTOBuy] Куплен:", petModel.Name)
    return true
end

-- Один круг обхода всех питомцев
local function buyAllWildPets()
    local spawnsFolder = Workspace.Map:FindFirstChild("WildPetSpawns")
    if not spawnsFolder then 
        warn("[AUTOBuy] Папка WildPetSpawns не найдена!")
        return 
    end

    local petsList = spawnsFolder:GetChildren()
    print("[AUTOBuy] --- НАЧАЛО ОБХОДА. Питомцев на карте: " .. #petsList .. " ---")

    for i, pet in ipairs(petsList) do
        buyPet(pet)
        task.wait(DELAY_BETWEEN_BUYS)
    end
    
    print("[AUTOBuy] --- ОБХОД ЗАВЕРШЕН ---")
end

-- БЕСКОНЕЧНЫЙ ЦИКЛ С РАНДОМНОЙ ПАУЗОЙ ОТ 1 ДО 5 МИНУТ
task.spawn(function()
    print("[AUTOBuy] Авто-ферма запущена!")
    
    while true do
        -- Выполняем круг покупки всех питомцев
        buyAllWildPets()
        
        -- Вычисляем рандомную задержку в секундах (от 60 до 300 сек)
        local minSec = MIN_LOOP_WAIT_MINUTES * 60
        local maxSec = MAX_LOOP_WAIT_MINUTES * 60
        local randomWait = math.random(minSec, maxSec)
        
        local minutes = math.floor(randomWait / 60)
        local seconds = randomWait % 60
        
        print(string.format("[AUTOBuy] Ожидание следующей проверки: %d мин. %d сек...", minutes, seconds))
        
        -- Ожидаем выбранное время перед следующим обходом
        task.wait(randomWait)
    end
end)
