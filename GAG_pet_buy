local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Networking = require(ReplicatedStorage:WaitForChild("SharedModules"):WaitForChild("Networking"))
local WildPetTame = Networking.Pets.WildPetTame
local WildPetTameResult = Networking.Pets.WildPetTameResult

local tameCooldown = {}

local function getPrice(refPart)
	local price = refPart:GetAttribute("Price")
	if type(price) ~= "number" then
		return nil
	end
	return price
end

local function isValidWildPetRef(refPart)
	if typeof(refPart) ~= "Instance" then
		return false
	end
	if not refPart:IsA("BasePart") then
		return false
	end
	local map = workspace:FindFirstChild("Map")
	if not map then
		return false
	end
	local wildPetRefFolder = map:FindFirstChild("WildPetRef")
	if not wildPetRefFolder then
		return false
	end
	return refPart:IsDescendantOf(wildPetRefFolder)
end

local function canPurchase(player, refPart)
	local ownerUserId = refPart:GetAttribute("OwnerUserId")
	if ownerUserId == player.UserId then
		return false, "Already owned"
	end

	local price = getPrice(refPart)
	if not price then
		return false, "No price"
	end

	local currency = player:GetAttribute("Sheckles")
	if type(currency) ~= "number" then
		currency = player:GetAttribute("Money")
	end
	if type(currency) ~= "number" then
		return false, "No currency stat"
	end
	if currency < price then
		return false, "Not enough currency"
	end

	return true
end

WildPetTame.OnServerEvent:Connect(function(player, refPart)
	print("[WildPetTameHandler] request", player and player.Name, refPart and refPart:GetFullName())
	if not player or not player.Parent then
		print("[WildPetTameHandler] reject: no player")
		return
	end

	if not isValidWildPetRef(refPart) then
		print("[WildPetTameHandler] reject: invalid ref")
		return
	end

	local lastTime = tameCooldown[player]
	local now = os.clock()
	if lastTime and now - lastTime < 1 then
		print("[WildPetTameHandler] reject: cooldown")
		return
	end
	tameCooldown[player] = now

	local ok, reason = canPurchase(player, refPart)
	if not ok then
		print("[WildPetTameHandler] reject:", reason)
		WildPetTameResult:FireClient(player, refPart, 0)
		return
	end

	print("[WildPetTameHandler] success before owner update", refPart:GetAttribute("OwnerUserId"), refPart:GetAttribute("Price"))
	refPart:SetAttribute("OwnerUserId", player.UserId)
	WildPetTameResult:FireClient(player, refPart, now)
	print("[WildPetTameHandler] success", player.Name, refPart:GetFullName())
end)

Players.PlayerRemoving:Connect(function(player)
	tameCooldown[player] = nil
end)
