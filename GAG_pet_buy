local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

local DELAY_BETWEEN_BUYS = 1.0

-- Создаем одну глобальную безопасную платформу
local safePlatform = Instance.new("Part")
safePlatform.Name = "SafePetPlatform"
safePlatform.Size = Vector3.new(10, 1, 10)
safePlatform.Anchored = true
safePlatform.CanCollide = true
safePlatform.Transparency = 1 -- Полностью невидимая (поставьте 0.5, если хотите её видеть)
safePlatform.Parent = Workspace

local function buyPet(petModel)
    if not petModel or not petModel.Parent then return false end
    
    local rootPart = petModel:FindFirstChild("RootPart") or petModel:FindFirstChildWhichIsA("BasePart")
    local buyPrompt = rootPart and rootPart:FindFirstChild("BuyPrompt")
    
    if not buyPrompt then
        buyPrompt = petModel:FindFirstChild("BuyPrompt", true)
    end
    
    if not buyPrompt then return false end

    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    
    if hrp then
        -- 1. Перемещаем невидимую платформу в позицию питомца
        local petPosition = rootPart.Position
        safePlatform.CFrame = CFrame.new(petPosition.X, petPosition.Y - 1, petPosition.Z)
        
        -- 2. Замораживаем игрока перед телепортом
        hrp.Anchored = true
        
        -- 3. Телепортируем игрока ровно НА невидимую платформу
        local targetCFrame = CFrame.new(petPosition.X, petPosition.Y + 2.5, petPosition.Z)
        hrp.CFrame = CFrame.lookAt(targetCFrame.Position, petPosition)
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, petPosition)
        
        task.wait(0.2)
        
        -- 4. Снимаем якорь, персонаж стоит НА невидимой платформе
        hrp.Anchored = false
        task.wait(0.1)
    end

    -- 5. Обход условий и активация покупки
    buyPrompt.RequiresLineOfSight = false
    buyPrompt.MaxActivationDistance = 9999
    
    if fireproximityprompt then
        fireproximityprompt(buyPrompt, 0)
        fireproximityprompt(buyPrompt)
    else
        buyPrompt:InputHoldBegin()
        task.wait(buyPrompt.HoldDuration > 0 and buyPrompt.HoldDuration or 0.1)
        buyPrompt:InputHoldEnd()
    end

    print("[AUTOBuy] Куплен:", petModel.Name)
    return true
end

-- Авто-обход
local function buyAllWildPets()
    local spawnsFolder = Workspace.Map:FindFirstChild("WildPetSpawns")
    if not spawnsFolder then 
        warn("[AUTOBuy] Не найдена папка WildPetSpawns!")
        return 
    end

    local petsList = spawnsFolder:GetChildren()
    print("[AUTOBuy] Найдено питомцев на карте: " .. #petsList)

    for i, pet in ipairs(petsList) do
        buyPet(pet)
        task.wait(DELAY_BETWEEN_BUYS)
    end
    
    print("[AUTOBuy] Готово! Игрок стоит на невидимой платформе у последнего питомца.")
end

buyAllWildPets()
