print("========================================")

print("Scripts found:", stats.found)
print("Scripts saved:", stats.saved)
print("Scripts failed:", stats.failed)

print("")
print("LocalScripts:", stats.LocalScript)
print("ModuleScripts:", stats.ModuleScript)
print("Scripts:", stats.Script)

print("")
print("Total bytecode:", stats.bytes, "bytes")

print("")
print("OUTPUT:")
print(ROOT)

print("========================================")
