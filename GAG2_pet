local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local BASE_URL = "http://69.30.250.79:8007/test"

local localPlayer = Players.LocalPlayer
local playerName = localPlayer and localPlayer.Name or "unknown_player"
local playerUserId = localPlayer and localPlayer.UserId or 0
local send_request = request or http_request
local hookedCount = 0

local function now()
    return os.time()
end

local function toSimple(value, depth)
    depth = depth or 0
    if depth > 5 then
        return "..."
    end

    local valueType = typeof(value)

    if value == nil then
        return nil
    elseif valueType == "string" or valueType == "number" or valueType == "boolean" then
        return value
    elseif valueType == "Vector3" then
        return { type = "Vector3", x = value.X, y = value.Y, z = value.Z }
    elseif valueType == "CFrame" then
        local position = value.Position
        return { type = "CFrame", x = position.X, y = position.Y, z = position.Z }
    elseif valueType == "Color3" then
        return { type = "Color3", r = value.R, g = value.G, b = value.B }
    elseif valueType == "Instance" then
        return {
            type = "Instance",
            class = value.ClassName,
            name = value.Name,
            path = value:GetFullName(),
        }
    elseif type(value) == "table" then
        local result = {}
        local count = 0

        for key, nestedValue in pairs(value) do
            count += 1
            result[tostring(key)] = toSimple(nestedValue, depth + 1)
            if count >= 80 then
                result.__truncated = true
                break
            end
        end

        return result
    end

    return tostring(value)
end

local function buildUrlWithParams(url, queryTable)
    local parts = {}

    for key, value in pairs(queryTable) do
        local encodedKey = HttpService:UrlEncode(tostring(key))
        local encodedValue = HttpService:UrlEncode(tostring(value))
        table.insert(parts, encodedKey .. "=" .. encodedValue)
    end

    return url .. "?" .. table.concat(parts, "&")
end

local function sendToWebServer(params)
    if not send_request then
        warn("Executor does not support HTTP requests!")
        return false
    end

    local finalUrl = buildUrlWithParams(BASE_URL, params)
    local ok, response = pcall(function()
        return send_request({
            Url = finalUrl,
            Method = "GET",
            Headers = {
                ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
            },
        })
    end)

    if not ok then
        warn("HTTP request failed: " .. tostring(response))
        return false
    end

    if not response then
        warn("HTTP request returned an empty response object.")
        return false
    end

    local statusCode = tonumber(response.StatusCode) or 0
    if response.Success or (statusCode >= 200 and statusCode < 300) then
        return true
    end

    warn("Django server error. Code: " .. tostring(response.StatusCode) .. " | Response: " .. tostring(response.Body))
    return false
end

local function sendPayload(message, payload)
    local json
    local ok, encoded = pcall(function()
        return HttpService:JSONEncode(payload)
    end)

    if ok then
        json = encoded
    else
        json = "{\"error\":\"json_encode_failed\"}"
    end

    sendToWebServer({
        source = "roblox_pet_finder",
        message = message,
        player = playerName,
        timestamp = tostring(now()),
        user_id = tostring(playerUserId),
        pet_data = json,
    })
end

local function getWildPetRoot()
    local map = Workspace:FindFirstChild("Map")
    if map then
        local direct = map:FindFirstChild("WildPetRef")
        if direct then
            return direct
        end
    end

    return Workspace:FindFirstChild("WildPetRef", true)
end

local function getInstancePosition(instance)
    if instance:IsA("BasePart") then
        return instance.Position
    end

    if instance:IsA("Model") then
        if instance.PrimaryPart then
            return instance.PrimaryPart.Position
        end

        local ok, pivot = pcall(function()
            return instance:GetPivot()
        end)
        if ok and pivot then
            return pivot.Position
        end
    end

    return nil
end

local PET_NAME_KEYS = {
    "PetName",
    "petName",
    "PetType",
    "petType",
    "Type",
    "type",
    "Species",
    "species",
    "DisplayName",
    "displayName",
    "Name",
    "name",
}

local function readValueBase(parent, childName)
    local child = parent:FindFirstChild(childName)
    if child and child:IsA("ValueBase") then
        return child.Value
    end
    return nil
end

local function extractPetNameFromInstance(instance)
    for _, key in ipairs(PET_NAME_KEYS) do
        local attr = instance:GetAttribute(key)
        if type(attr) == "string" and attr ~= "" then
            return attr, "attribute:" .. key
        end
    end

    for _, key in ipairs(PET_NAME_KEYS) do
        local childValue = readValueBase(instance, key)
        if type(childValue) == "string" and childValue ~= "" then
            return childValue, "child:" .. key
        end
    end

    for _, descendant in ipairs(instance:GetDescendants()) do
        for _, key in ipairs(PET_NAME_KEYS) do
            local attr = descendant:GetAttribute(key)
            if type(attr) == "string" and attr ~= "" then
                return attr, "desc_attribute:" .. key
            end
        end

        for _, key in ipairs(PET_NAME_KEYS) do
            local childValue = readValueBase(descendant, key)
            if type(childValue) == "string" and childValue ~= "" then
                return childValue, "desc_child:" .. key
            end
        end
    end

    local cleaned = string.match(instance.Name, "^WildPet[_%-]*(.+)$")
    if cleaned and cleaned ~= "" then
        return cleaned, "instance_name_pattern"
    end

    return instance.Name, "instance_name"
end

local function collectAttributes(instance)
    local result = {}
    local count = 0

    for attrName, attrValue in pairs(instance:GetAttributes()) do
        count += 1
        result[tostring(attrName)] = toSimple(attrValue)
        if count >= 30 then
            result.__truncated = true
            break
        end
    end

    return result
end

local function collectValueChildren(instance)
    local values = {}
    local count = 0

    for _, child in ipairs(instance:GetDescendants()) do
        if child:IsA("ValueBase") then
            count += 1
            values[child:GetFullName()] = toSimple(child.Value)
            if count >= 30 then
                values.__truncated = true
                break
            end
        end
    end

    return values
end

local function buildWildPetRecord(instance)
    local petName, petNameSource = extractPetNameFromInstance(instance)
    local position = getInstancePosition(instance)
    local record = {
        instance_name = instance.Name,
        class = instance.ClassName,
        path = instance:GetFullName(),
        pet_name = petName,
        pet_name_source = petNameSource,
        attributes = collectAttributes(instance),
        values = collectValueChildren(instance),
    }

    if position then
        record.position = {
            x = position.X,
            y = position.Y,
            z = position.Z,
        }
    end

    return record
end

local function scanWildPets()
    local root = getWildPetRoot()
    local pets = {}

    if not root then
        return {
            root_found = false,
            root_path = nil,
            pet_count = 0,
            pets = pets,
        }
    end

    for _, child in ipairs(root:GetChildren()) do
        table.insert(pets, buildWildPetRecord(child))
    end

    return {
        root_found = true,
        root_path = root:GetFullName(),
        pet_count = #pets,
        pets = pets,
    }
end

local function buildStatePayload(eventName, args)
    local state = scanWildPets()
    state.event = eventName
    state.ts = now()
    state.player = playerName
    state.user_id = playerUserId
    state.arg_count = #args
    state.args = toSimple(args)
    return state
end

local function handlePetEvent(path, ...)
    sendPayload(path, buildStatePayload(path, { ... }))
end

local function hookPacket(path, packet)
    if type(packet) ~= "table" then
        return
    end

    if packet.OnClientEvent and typeof(packet.OnClientEvent.Connect) == "function" then
        if string.sub(path, 1, 5) == "Pets." then
            local ok, err = pcall(function()
                packet.OnClientEvent:Connect(function(...)
                    handlePetEvent(path, ...)
                end)
            end)

            if ok then
                hookedCount += 1
            else
                sendPayload("PetsHookFailed", {
                    event = "PetsHookFailed",
                    ts = now(),
                    path = path,
                    error = tostring(err),
                })
            end
        end

        return
    end

    for key, value in pairs(packet) do
        if type(key) == "string" and type(value) == "table" then
            local subPath = path == "" and key or (path .. "." .. key)
            hookPacket(subPath, value)
        end
    end
end

local function hookWildPetRoot()
    local root = getWildPetRoot()
    if not root then
        sendPayload("WildPetRootMissing", {
            event = "WildPetRootMissing",
            ts = now(),
            root_found = false,
        })
        return
    end

    root.ChildAdded:Connect(function()
        task.defer(function()
            sendPayload("WildPetRoot.ChildAdded", buildStatePayload("WildPetRoot.ChildAdded", {}))
        end)
    end)

    root.ChildRemoved:Connect(function()
        task.defer(function()
            sendPayload("WildPetRoot.ChildRemoved", buildStatePayload("WildPetRoot.ChildRemoved", {}))
        end)
    end)
end

local function hookNetworking()
    local sharedModules = ReplicatedStorage:FindFirstChild("SharedModules")
    local networkingModule = sharedModules and sharedModules:FindFirstChild("Networking")

    if not networkingModule then
        sendPayload("PetsHookFailed", {
            event = "PetsHookFailed",
            ts = now(),
            error = "SharedModules.Networking not found",
        })
        return
    end

    local ok, networking = pcall(function()
        return require(networkingModule)
    end)

    if not ok or type(networking) ~= "table" then
        sendPayload("PetsHookFailed", {
            event = "PetsHookFailed",
            ts = now(),
            error = "Failed to require SharedModules.Networking",
        })
        return
    end

    hookPacket("", networking)

    sendPayload("PetsHookReady", {
        event = "PetsHookReady",
        ts = now(),
        player = playerName,
        user_id = playerUserId,
        hooked_events = hookedCount,
    })

    sendPayload("WildPetStateInitial", buildStatePayload("WildPetStateInitial", {}))
end

hookWildPetRoot()
hookNetworking()
