local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BASE_URL = "http://69.30.250.79:8007/test"

local localPlayer = Players.LocalPlayer
local playerName = localPlayer and localPlayer.Name or "unknown_player"
local playerUserId = localPlayer and localPlayer.UserId or 0
local send_request = request or http_request
local hookedCount = 0
local sentReady = false

local ALLOW_PET_EVENTS = {
    ["Pets.SnapPetsBroadcast"] = true,
    ["Pets.WildPetTame"] = true,
    ["Pets.WildPetTameResult"] = true,
    ["Pets.WildPetCollected"] = true,
}

local function now()
    return os.time()
end

local function toSimple(value, depth)
    depth = depth or 0
    if depth > 5 then
        return "..."
    end

    local valueType = typeof(value)

    if value == nil then
        return nil
    elseif valueType == "string" or valueType == "number" or valueType == "boolean" then
        return value
    elseif valueType == "Vector3" then
        return { type = "Vector3", x = value.X, y = value.Y, z = value.Z }
    elseif valueType == "CFrame" then
        local position = value.Position
        return { type = "CFrame", x = position.X, y = position.Y, z = position.Z }
    elseif valueType == "Color3" then
        return { type = "Color3", r = value.R, g = value.G, b = value.B }
    elseif valueType == "Instance" then
        return {
            type = "Instance",
            class = value.ClassName,
            name = value.Name,
            path = value:GetFullName(),
        }
    elseif type(value) == "table" then
        local result = {}
        local count = 0

        for key, nestedValue in pairs(value) do
            count += 1
            result[tostring(key)] = toSimple(nestedValue, depth + 1)
            if count >= 80 then
                result.__truncated = true
                break
            end
        end

        return result
    end

    return tostring(value)
end

local function buildUrlWithParams(url, queryTable)
    local parts = {}

    for key, value in pairs(queryTable) do
        local encodedKey = HttpService:UrlEncode(tostring(key))
        local encodedValue = HttpService:UrlEncode(tostring(value))
        table.insert(parts, encodedKey .. "=" .. encodedValue)
    end

    return url .. "?" .. table.concat(parts, "&")
end

local function sendToWebServer(params)
    if not send_request then
        warn("Executor does not support HTTP requests!")
        return false
    end

    local finalUrl = buildUrlWithParams(BASE_URL, params)
    local ok, response = pcall(function()
        return send_request({
            Url = finalUrl,
            Method = "GET",
            Headers = {
                ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
            },
        })
    end)

    if not ok then
        warn("HTTP request failed: " .. tostring(response))
        return false
    end

    if not response then
        warn("HTTP request returned an empty response object.")
        return false
    end

    local statusCode = tonumber(response.StatusCode) or 0
    if response.Success or (statusCode >= 200 and statusCode < 300) then
        return true
    end

    warn("Django server error. Code: " .. tostring(response.StatusCode) .. " | Response: " .. tostring(response.Body))
    return false
end

local function sendPetPayload(message, petPayload)
    local petDataJson
    local ok, encoded = pcall(function()
        return HttpService:JSONEncode(petPayload)
    end)

    if ok then
        petDataJson = encoded
    else
        petDataJson = "{\"error\":\"json_encode_failed\"}"
    end

    sendToWebServer({
        source = "roblox_pet_finder",
        message = message,
        player = playerName,
        timestamp = tostring(now()),
        user_id = tostring(playerUserId),
        pet_data = petDataJson,
    })
end

local function argsToPayload(path, args)
    local payload = {
        event = path,
        ts = now(),
        player = playerName,
        user_id = playerUserId,
        argc = #args,
        args = {},
    }

    for index, value in ipairs(args) do
        payload.args[index] = toSimple(value)
    end

    return payload
end

local function sendReadyOnce()
    if sentReady then
        return
    end

    sentReady = true
    sendPetPayload("PetsHookReady", {
        event = "PetsHookReady",
        ts = now(),
        player = playerName,
        user_id = playerUserId,
        hooked_events = hookedCount,
    })
end

local function handlePetEvent(path, ...)
    local args = { ... }
    sendPetPayload(path, argsToPayload(path, args))
end

local function shouldHook(path)
    return ALLOW_PET_EVENTS[path] == true
end

local function hookPacket(path, packet)
    if type(packet) ~= "table" then
        return
    end

    if packet.OnClientEvent and typeof(packet.OnClientEvent.Connect) == "function" then
        if shouldHook(path) then
            local ok, err = pcall(function()
                packet.OnClientEvent:Connect(function(...)
                    handlePetEvent(path, ...)
                end)
            end)

            if ok then
                hookedCount += 1
            else
                sendPetPayload("PetsHookFailed", {
                    event = "PetsHookFailed",
                    ts = now(),
                    path = path,
                    error = tostring(err),
                })
            end
        end

        return
    end

    for key, value in pairs(packet) do
        if type(key) == "string" and type(value) == "table" then
            local subPath = path == "" and key or (path .. "." .. key)
            hookPacket(subPath, value)
        end
    end
end

local function hookNetworking()
    local sharedModules = ReplicatedStorage:FindFirstChild("SharedModules")
    local networkingModule = sharedModules and sharedModules:FindFirstChild("Networking")

    if not networkingModule then
        sendPetPayload("PetsHookFailed", {
            event = "PetsHookFailed",
            ts = now(),
            error = "SharedModules.Networking not found",
        })
        return
    end

    local ok, networking = pcall(function()
        return require(networkingModule)
    end)

    if not ok or type(networking) ~= "table" then
        sendPetPayload("PetsHookFailed", {
            event = "PetsHookFailed",
            ts = now(),
            error = "Failed to require SharedModules.Networking",
        })
        return
    end

    hookPacket("", networking)
    sendReadyOnce()
end

hookNetworking()
