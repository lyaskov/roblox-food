local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BASE_URL = "http://69.30.250.79:8007/test"

local localPlayer = Players.LocalPlayer
local playerName = localPlayer and localPlayer.Name or "unknown_player"
local playerUserId = localPlayer and localPlayer.UserId or 0
local send_request = request or http_request
local hookedCount = 0
local sentReady = false
local currentPets = {}

local ALLOW_PET_EVENTS = {
    ["Pets.SnapPetsBroadcast"] = true,
    ["Pets.WildPetTame"] = true,
    ["Pets.WildPetTameResult"] = true,
    ["Pets.WildPetCollected"] = true,
}

local function now()
    return os.time()
end

local function toSimple(value, depth)
    depth = depth or 0
    if depth > 5 then
        return "..."
    end

    local valueType = typeof(value)

    if value == nil then
        return nil
    elseif valueType == "string" or valueType == "number" or valueType == "boolean" then
        return value
    elseif valueType == "Vector3" then
        return { type = "Vector3", x = value.X, y = value.Y, z = value.Z }
    elseif valueType == "CFrame" then
        local position = value.Position
        return { type = "CFrame", x = position.X, y = position.Y, z = position.Z }
    elseif valueType == "Color3" then
        return { type = "Color3", r = value.R, g = value.G, b = value.B }
    elseif valueType == "Instance" then
        return {
            type = "Instance",
            class = value.ClassName,
            name = value.Name,
            path = value:GetFullName(),
        }
    elseif type(value) == "table" then
        local result = {}
        local count = 0

        for key, nestedValue in pairs(value) do
            count += 1
            result[tostring(key)] = toSimple(nestedValue, depth + 1)
            if count >= 80 then
                result.__truncated = true
                break
            end
        end

        return result
    end

    return tostring(value)
end

local function buildUrlWithParams(url, queryTable)
    local parts = {}

    for key, value in pairs(queryTable) do
        local encodedKey = HttpService:UrlEncode(tostring(key))
        local encodedValue = HttpService:UrlEncode(tostring(value))
        table.insert(parts, encodedKey .. "=" .. encodedValue)
    end

    return url .. "?" .. table.concat(parts, "&")
end

local function sendToWebServer(params)
    if not send_request then
        warn("Executor does not support HTTP requests!")
        return false
    end

    local finalUrl = buildUrlWithParams(BASE_URL, params)
    local ok, response = pcall(function()
        return send_request({
            Url = finalUrl,
            Method = "GET",
            Headers = {
                ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
            },
        })
    end)

    if not ok then
        warn("HTTP request failed: " .. tostring(response))
        return false
    end

    if not response then
        warn("HTTP request returned an empty response object.")
        return false
    end

    local statusCode = tonumber(response.StatusCode) or 0
    if response.Success or (statusCode >= 200 and statusCode < 300) then
        return true
    end

    warn("Django server error. Code: " .. tostring(response.StatusCode) .. " | Response: " .. tostring(response.Body))
    return false
end

local function sendPetPayload(message, petPayload)
    local petDataJson
    local ok, encoded = pcall(function()
        return HttpService:JSONEncode(petPayload)
    end)

    if ok then
        petDataJson = encoded
    else
        petDataJson = "{\"error\":\"json_encode_failed\"}"
    end

    sendToWebServer({
        source = "roblox_pet_finder",
        message = message,
        player = playerName,
        timestamp = tostring(now()),
        user_id = tostring(playerUserId),
        pet_data = petDataJson,
    })
end

local function cloneTable(source)
    local result = {}
    for key, value in pairs(source) do
        result[key] = value
    end
    return result
end

local function addPetRecord(results, seenKeys, petName, ownerName, extra)
    petName = petName and tostring(petName) or nil
    ownerName = ownerName and tostring(ownerName) or nil

    if not petName or petName == "" then
        return
    end

    local key = (ownerName or "?") .. "|" .. petName
    if seenKeys[key] then
        return
    end

    seenKeys[key] = true

    local record = {
        name = petName,
        owner = ownerName,
    }

    if type(extra) == "table" then
        for extraKey, extraValue in pairs(extra) do
            record[extraKey] = extraValue
        end
    end

    table.insert(results, record)
end

local function extractOwnerName(value)
    if value == nil then
        return nil
    end

    if typeof(value) == "Instance" and value:IsA("Player") then
        return value.Name
    end

    if type(value) == "table" then
        if value.Name and value.ClassName == "Player" then
            return tostring(value.Name)
        end

        if value.name and value.class == "Player" then
            return tostring(value.name)
        end

        if value.player then
            return extractOwnerName(value.player)
        end

        if value.owner then
            return extractOwnerName(value.owner)
        end
    end

    return nil
end

local PET_NAME_KEYS = {
    "PetName",
    "petName",
    "PetType",
    "petType",
    "Type",
    "type",
    "Name",
    "name",
    "Species",
    "species",
}

local OWNER_KEYS = {
    "Player",
    "player",
    "Owner",
    "owner",
    "Collector",
    "collector",
}

local function extractPetsFromValue(value, results, seenKeys, contextOwner, depth)
    depth = depth or 0
    if depth > 6 or value == nil then
        return
    end

    local valueType = typeof(value)

    if valueType == "Instance" then
        return
    end

    if type(value) ~= "table" then
        return
    end

    local ownerName = contextOwner

    for _, ownerKey in ipairs(OWNER_KEYS) do
        if value[ownerKey] ~= nil then
            ownerName = extractOwnerName(value[ownerKey]) or ownerName
            if ownerName then
                break
            end
        end
    end

    local petName = nil
    for _, petKey in ipairs(PET_NAME_KEYS) do
        local candidate = value[petKey]
        if type(candidate) == "string" and candidate ~= "" then
            petName = candidate
            break
        end
    end

    if petName then
        local extra = {}

        if value.Rarity ~= nil then extra.rarity = tostring(value.Rarity) end
        if value.rarity ~= nil then extra.rarity = tostring(value.rarity) end
        if value.Level ~= nil then extra.level = tonumber(value.Level) or value.Level end
        if value.level ~= nil then extra.level = tonumber(value.level) or value.level end
        if value.Id ~= nil then extra.id = tostring(value.Id) end
        if value.id ~= nil then extra.id = tostring(value.id) end

        addPetRecord(results, seenKeys, petName, ownerName, extra)
    end

    for _, nestedValue in pairs(value) do
        extractPetsFromValue(nestedValue, results, seenKeys, ownerName, depth + 1)
    end
end

local function buildCurrentPetsSummary(eventName, rawArgs)
    local pets = {}
    local seenKeys = {}

    if eventName == "Pets.WildPetCollected" or eventName == "Pets.WildPetTame" or eventName == "Pets.WildPetTameResult" then
        local ownerName = extractOwnerName(rawArgs[1])
        local petName = rawArgs[2]
        if type(petName) == "string" then
            addPetRecord(pets, seenKeys, petName, ownerName)
        end
    end

    for _, arg in ipairs(rawArgs) do
        extractPetsFromValue(arg, pets, seenKeys, nil, 0)
    end

    return pets
end

local function replaceCurrentPets(pets)
    currentPets = {}

    for index, pet in ipairs(pets) do
        currentPets[index] = cloneTable(pet)
    end
end

local function appendCurrentPets(pets)
    local seenKeys = {}

    for _, existingPet in ipairs(currentPets) do
        local key = tostring(existingPet.owner or "?") .. "|" .. tostring(existingPet.name or "?")
        seenKeys[key] = true
    end

    for _, pet in ipairs(pets) do
        local key = tostring(pet.owner or "?") .. "|" .. tostring(pet.name or "?")
        if not seenKeys[key] then
            seenKeys[key] = true
            table.insert(currentPets, cloneTable(pet))
        end
    end
end

local function buildStatePayload(path, args)
    local detectedPets = buildCurrentPetsSummary(path, args)

    if path == "Pets.SnapPetsBroadcast" then
        replaceCurrentPets(detectedPets)
    elseif #detectedPets > 0 then
        appendCurrentPets(detectedPets)
    end

    return {
        event = path,
        ts = now(),
        player = playerName,
        user_id = playerUserId,
        arg_count = #args,
        pets_detected_in_event = detectedPets,
        pet_count = #currentPets,
        pets = currentPets,
        args = toSimple(args),
    }
end

local function argsToPayload(path, args)
    local payload = {
        event = path,
        ts = now(),
        player = playerName,
        user_id = playerUserId,
        argc = #args,
        args = {},
    }

    for index, value in ipairs(args) do
        payload.args[index] = toSimple(value)
    end

    return payload
end

local function sendReadyOnce()
    if sentReady then
        return
    end

    sentReady = true
    sendPetPayload("PetsHookReady", {
        event = "PetsHookReady",
        ts = now(),
        player = playerName,
        user_id = playerUserId,
        hooked_events = hookedCount,
    })
end

local function handlePetEvent(path, ...)
    local args = { ... }
    sendPetPayload(path, buildStatePayload(path, args))
end

local function shouldHook(path)
    return ALLOW_PET_EVENTS[path] == true
end

local function hookPacket(path, packet)
    if type(packet) ~= "table" then
        return
    end

    if packet.OnClientEvent and typeof(packet.OnClientEvent.Connect) == "function" then
        if shouldHook(path) then
            local ok, err = pcall(function()
                packet.OnClientEvent:Connect(function(...)
                    handlePetEvent(path, ...)
                end)
            end)

            if ok then
                hookedCount += 1
            else
                sendPetPayload("PetsHookFailed", {
                    event = "PetsHookFailed",
                    ts = now(),
                    path = path,
                    error = tostring(err),
                })
            end
        end

        return
    end

    for key, value in pairs(packet) do
        if type(key) == "string" and type(value) == "table" then
            local subPath = path == "" and key or (path .. "." .. key)
            hookPacket(subPath, value)
        end
    end
end

local function hookNetworking()
    local sharedModules = ReplicatedStorage:FindFirstChild("SharedModules")
    local networkingModule = sharedModules and sharedModules:FindFirstChild("Networking")

    if not networkingModule then
        sendPetPayload("PetsHookFailed", {
            event = "PetsHookFailed",
            ts = now(),
            error = "SharedModules.Networking not found",
        })
        return
    end

    local ok, networking = pcall(function()
        return require(networkingModule)
    end)

    if not ok or type(networking) ~= "table" then
        sendPetPayload("PetsHookFailed", {
            event = "PetsHookFailed",
            ts = now(),
            error = "Failed to require SharedModules.Networking",
        })
        return
    end

    hookPacket("", networking)
    sendReadyOnce()
end

hookNetworking()
