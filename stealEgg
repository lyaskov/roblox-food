local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local EggState = require(ReplicatedStorage.Client.EggState)

local INGEST_API_URL = "https://craftsman-pregnant-cupid.ngrok-free.dev/api/ingest/eggs/"
local DEBUG_INGEST = true
local httpFunc = request or http_request or (syn and syn.request)

local function debugLog(message)
	if not DEBUG_INGEST then
		return
	end

	warn("[DebugEggs] " .. tostring(message))
end

local function jsonClone(value)
	local ok, encoded = pcall(function()
		return HttpService:JSONEncode(value)
	end)
	if not ok then
		return value
	end

	local ok2, decoded = pcall(function()
		return HttpService:JSONDecode(encoded)
	end)
	if ok2 then
		return decoded
	end

	return value
end

local function sendSnapshot(label, snapshot)
	if not httpFunc then
		debugLog("HTTP sender is not available in this executor")
		return
	end

	local body = {
		label = label,
		snapshot = jsonClone(snapshot),
		sent_at_unix = os.time(),
	}

	local okEncode, encodedBody = pcall(function()
		return HttpService:JSONEncode(body)
	end)
	if not okEncode then
		debugLog("JSON encode failed for " .. tostring(label))
		return
	end

	local okRequest, response = pcall(function()
		return httpFunc({
			Url = INGEST_API_URL,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json",
			},
			Body = encodedBody,
		})
	end)

	if not okRequest then
		debugLog("HTTP request failed for " .. tostring(label) .. ": " .. tostring(response))
		return
	end

	local statusCode = response and tonumber(response.StatusCode) or 0
	if statusCode < 200 or statusCode >= 300 then
		debugLog(
			"HTTP status failed for " .. tostring(label) ..
			", status=" .. tostring(statusCode) ..
			", body=" .. tostring(response and response.Body)
		)
		return
	end

	debugLog("Snapshot sent: " .. tostring(label) .. ", status=" .. tostring(statusCode))
end

local function dumpAvailableEggs(label, snapshot)
	if typeof(snapshot) ~= "table" then
		warn("[DebugEggs] " .. label .. " | snapshot is not a table")
		return
	end

	local dump = {
		label = label,
		totalOwnerRows = #snapshot,
		rows = {}
	}

	for i = 1, #snapshot do
		local ownerRow = snapshot[i]
		local rowDump = {
			index = i,
			type = typeof(ownerRow)
		}

		if typeof(ownerRow) == "table" then
			rowDump.ownerUserId = ownerRow.OwnerUserId
			rowDump.records = {}
			if typeof(ownerRow.Records) == "table" then
				for uid, record in ownerRow.Records do
					rowDump.records[#rowDump.records + 1] = {
						uid = uid,
						data = jsonClone(record)
					}
				end
			end
		end

		dump.rows[#dump.rows + 1] = rowDump
	end

	print("\n========== [DebugEggs RAW] ==========")
	print(HttpService:JSONEncode(jsonClone(dump)))
	print("====================================")

	sendSnapshot(label, dump)
end

local ok, err = pcall(function()
	EggState.FieldRefreshed:Connect(function(snapshot)
		dumpAvailableEggs("FieldRefreshed", snapshot)
	end)

	EggState.SnapshotRefreshed:Connect(function(snapshot)
		dumpAvailableEggs("SnapshotRefreshed", snapshot)
	end)

	local snapshot = EggState.SyncFieldEggs()
	dumpAvailableEggs("Initial SyncFieldEggs", snapshot)
end)

if not ok then
	warn("[DebugEggs] Failed to initialize: " .. tostring(err))
end
