local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EggState = require(ReplicatedStorage.Client.EggState)

local HttpService = game:GetService("HttpService")

local function stringify(value)
	local valueType = typeof(value)
	if valueType == "string" then
		return string.format("%q", value)
	elseif valueType == "number" or valueType == "boolean" then
		return tostring(value)
	elseif valueType == "nil" then
		return "nil"
	elseif valueType == "table" then
		local ok, encoded = pcall(function()
			return HttpService:JSONEncode(value)
		end)
		return ok and encoded or "<table>"
	else
		return "<" .. valueType .. ">"
	end
end

local function dumpAvailableEggs(label, snapshot)
	if typeof(snapshot) ~= "table" then
		warn("[DebugEggs] " .. label .. " | snapshot is not a table")
		return
	end

	print("\n========== [DebugEggs RAW] ==========")
	print(("[DebugEggs] label=%s totalOwnerRows=%d"):format(label, #snapshot))

	for i = 1, #snapshot do
		local ownerRow = snapshot[i]
		if typeof(ownerRow) ~= "table" then
			print(("[Row %d] type=%s value=%s"):format(i, typeof(ownerRow), stringify(ownerRow)))
		else
			local ownerUserId = tostring(ownerRow.OwnerUserId or "unknown")
			local records = ownerRow.Records
			local recordCount = typeof(records) == "table" and #records or 0
			print(("[Row %d] ownerUserId=%s recordCount=%d"):format(i, ownerUserId, recordCount))

			if typeof(records) == "table" then
				for uid, record in records do
					if typeof(record) == "table" then
						print(("  [uid=%s] %s"):format(tostring(uid), stringify(record)))
					else
						print(("  [uid=%s] type=%s value=%s"):format(tostring(uid), typeof(record), stringify(record)))
					end
				end
			end
		end
	end

	print("====================================")
end

local ok, err = pcall(function()
	EggState.FieldRefreshed:Connect(function(snapshot)
		dumpAvailableEggs("FieldRefreshed", snapshot)
	end)

	EggState.SnapshotRefreshed:Connect(function(snapshot)
		dumpAvailableEggs("SnapshotRefreshed", snapshot)
	end)

	local snapshot = EggState.SyncFieldEggs()
	dumpAvailableEggs("Initial SyncFieldEggs", snapshot)
end)

if not ok then
	warn("[DebugEggs] Failed to initialize: " .. tostring(err))
end
