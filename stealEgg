local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local AreaEggTypes = require(ReplicatedStorage.Shared.Types.AreaEggs)
local AreaEggState = require(ReplicatedStorage.Client.EggState)

local function stateName(state)
	return tostring(state or "nil")
end

local function dumpGuardAreas(label, snapshot)
	if typeof(snapshot) ~= "table" then
		warn("[DebugEggs] " .. label .. " | snapshot is not a table")
		return
	end

	local records = snapshot.Records
	if typeof(records) ~= "table" then
		warn("[DebugEggs] " .. label .. " | snapshot.Records is not a table")
		return
	end

	print("\n========== [DebugEggs GuardAreas] ==========")
	print(("[DebugEggs] label=%s recordCount=%d serverTime=%s"):format(label, #records, tostring(snapshot.ServerTime)))

	local activeCount = 0
	for i = 1, #records do
		local record = records[i]
		if typeof(record) == "table" then
			local areaId = record.AreaId or "<no AreaId>"
			local nestId = record.NestId or "<no NestId>"
			local state = record.State
			local category = record.AssetCategory or "<no AssetCategory>"
			local shouldShow = state == nil or state == AreaEggTypes.States.Slot or state == AreaEggTypes.States.Carried or state == AreaEggTypes.States.Dropped or state == AreaEggTypes.States.GuardCarried

			if shouldShow then
				activeCount += 1
				print(("[GuardEgg %d] uid=%s areaId=%s nestId=%s state=%s category=%s version=%s droppedAt=%s carrierUserId=%s"):format(
					activeCount,
					tostring(record.Uid),
					tostring(areaId),
					tostring(nestId),
					stateName(state),
					tostring(category),
					tostring(record.Version),
					tostring(record.DroppedAt),
					tostring(record.CarrierUserId)
				))
			end
		end
	end

	print(("[DebugEggs] GuardAreas active count=%d"):format(activeCount))
	print("====================================")
end

local ok, err = pcall(function()
	AreaEggState.FieldRefreshed:Connect(function(snapshot)
		dumpGuardAreas("FieldRefreshed", snapshot)
	end)

	AreaEggState.FieldShifted:Connect(function(record)
		print(("\n[DebugEggs] FieldShifted uid=%s category=%s state=%s areaId=%s nestId=%s"):format(
			tostring(record and record.Uid),
			tostring(record and record.AssetCategory),
			stateName(record and record.State),
			tostring(record and record.AreaId),
			tostring(record and record.NestId)
		))
	end)

	AreaEggState.FieldGone:Connect(function(uid)
		print(("[DebugEggs] FieldGone uid=%s"):format(tostring(uid)))
	end)

	local snapshot = AreaEggState.SyncFieldEggs()
	dumpGuardAreas("Initial SyncFieldEggs", snapshot)
end)

if not ok then
	warn("[DebugEggs] Failed to initialize: " .. tostring(err))
end
