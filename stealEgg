local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local EggState = require(ReplicatedStorage.Client.EggState)
local Rift = require(ReplicatedStorage.Data.Rift)
local RiftFlags = require(ReplicatedStorage.Shared.Flags.RiftFlags)
local Areas = require(ReplicatedStorage.Data.Areas)

local INGEST_API_URL = "https://craftsman-pregnant-cupid.ngrok-free.dev/api/ingest/eggs/"
local RIFT_INGEST_API_URL = "https://craftsman-pregnant-cupid.ngrok-free.dev/api/ingest/rift/"
local DEBUG_INGEST = true
local httpFunc = request or http_request or (syn and syn.request)

local function debugLog(message)
	if not DEBUG_INGEST then
		return
	end

	warn("[DebugEggsRawJson] " .. tostring(message))
end

local function countRecords(records)
	if typeof(records) ~= "table" then
		return 0
	end

	local count = 0
	for _key, _value in pairs(records) do
		count += 1
	end

	return count
end

local function toJsonSafe(value, depth, seen)
	depth = depth or 0
	seen = seen or {}

	if depth > 8 then
		return "..."
	end

	local valueType = typeof(value)
	if value == nil or valueType == "string" or valueType == "number" or valueType == "boolean" then
		return value
	end

	if valueType == "Vector3" then
		return {
			type = "Vector3",
			x = value.X,
			y = value.Y,
			z = value.Z,
		}
	end

	if valueType == "CFrame" then
		local position = value.Position
		return {
			type = "CFrame",
			x = position.X,
			y = position.Y,
			z = position.Z,
		}
	end

	if valueType == "Color3" then
		return {
			type = "Color3",
			r = value.R,
			g = value.G,
			b = value.B,
		}
	end

	if valueType == "Instance" then
		return {
			type = "Instance",
			class = value.ClassName,
			name = value.Name,
			path = value:GetFullName(),
		}
	end

	if type(value) == "table" then
		if seen[value] then
			return "<cycle>"
		end

		seen[value] = true

		local result = {}
		local count = 0
		for key, nestedValue in pairs(value) do
			local keyString = tostring(key)
			if keyString ~= "BoundsSize" and keyString ~= "BoundsCFrame" and keyString ~= "BottomCFrame" then
			count += 1
				result[keyString] = toJsonSafe(nestedValue, depth + 1, seen)
				if count >= 200 then
					result.__truncated = true
					break
				end
			end
		end

		seen[value] = nil
		return result
	end

	return tostring(value)
end

local function sendRawSnapshot(label, snapshot)
	if not httpFunc then
		debugLog("HTTP sender is not available in this executor")
		return
	end

	local records = snapshot and snapshot.Records
	local recordCount = countRecords(records)
	if recordCount < 10 then
		debugLog("Skip send for " .. tostring(label) .. ": recordCount=" .. tostring(recordCount))
		return
	end

	local payload = {
		label = label,
		snapshot = toJsonSafe(snapshot),
		sent_at_unix = os.time(),
	}

	local okEncode, encodedBody = pcall(function()
		return HttpService:JSONEncode(payload)
	end)

	if not okEncode then
		debugLog("Failed to encode payload for " .. tostring(label))
		return
	end

	local okRequest, response = pcall(function()
		return httpFunc({
			Url = INGEST_API_URL,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json",
			},
			Body = encodedBody,
		})
	end)

	if not okRequest then
		debugLog("HTTP request failed for " .. tostring(label) .. ": " .. tostring(response))
		return
	end

	local statusCode = response and tonumber(response.StatusCode) or 0
	if statusCode < 200 or statusCode >= 300 then
		debugLog(
			"HTTP status failed for " .. tostring(label) ..
			", status=" .. tostring(statusCode) ..
			", body=" .. tostring(response and response.Body)
		)
		return
	end

	debugLog("Raw snapshot sent: " .. tostring(label) .. ", status=" .. tostring(statusCode))
end

local function buildRiftPetPayload(bannerId, pet)
	local assetId = pet and pet.AssetId

	return {
		asset_id = tostring(assetId or ""),
		weight = assetId and Rift.GetPetWeight(bannerId, assetId) or nil,
		raw_pet = toJsonSafe(pet),
	}
end

local function buildRiftBannerPayload(bannerId)
	local fromBiome, toBiome = Rift.GetBannerRange(bannerId)
	local banner = Rift.GetBanner(bannerId)
	local pets = {}

	if banner and banner.Pets then
		for _, pet in ipairs(banner.Pets) do
			table.insert(pets, buildRiftPetPayload(bannerId, pet))
		end
	end

	return {
		banner_id = tostring(bannerId or ""),
		display_name = tostring(Rift.GetBannerDisplayName(bannerId) or ""),
		weight = Rift.GetBannerWeight(bannerId),
		from_biome = tostring(fromBiome or ""),
		to_biome = tostring(toBiome or ""),
		pets = pets,
		raw_banner = toJsonSafe(banner),
	}
end

local function buildRiftPayload()
	local currentPeriod = Rift.CurrentPeriod()
	local currentBannerId = Rift.CurrentBannerId()
	local currentBanner = buildRiftBannerPayload(currentBannerId)
	local spawnAreaId = RiftFlags.SpawnAreaId:Get()
	local spawnAreaName = ""

	if spawnAreaId and spawnAreaId ~= "" then
		local areaData = Areas.Directory[spawnAreaId]
		if areaData then
			spawnAreaName = tostring(areaData.DisplayName or spawnAreaId)
		else
			spawnAreaName = tostring(spawnAreaId)
		end
	end

	local allBanners = {}
	for _, bannerId in ipairs(Rift.BannerIds()) do
		table.insert(allBanners, buildRiftBannerPayload(bannerId))
	end

	return {
		current_period = currentPeriod,
		current_banner_id = tostring(currentBannerId or ""),
		current_banner_display_name = tostring(Rift.GetBannerDisplayName(currentBannerId) or ""),
		rotation_seconds = Rift.RotationSeconds(),
		seconds_until_rotation = Rift.SecondsUntilRotation(),
		from_biome = currentBanner.from_biome,
		to_biome = currentBanner.to_biome,
		spawn_area_id = tostring(spawnAreaId or ""),
		spawn_area_display_name = spawnAreaName,
		current_banner_weight = currentBanner.weight,
		current_banner_pets = currentBanner.pets,
		all_banners = allBanners,
	}
end

local function sendRiftInfo(label)
	if not httpFunc then
		debugLog("HTTP sender is not available in this executor")
		return
	end

	local okBuild, riftPayload = pcall(buildRiftPayload)
	if not okBuild then
		debugLog("Failed to build rift payload for " .. tostring(label) .. ": " .. tostring(riftPayload))
		return
	end

	local payload = {
		label = label,
		rift = riftPayload,
		sent_at_unix = os.time(),
	}

	local okEncode, encodedBody = pcall(function()
		return HttpService:JSONEncode(payload)
	end)

	if not okEncode then
		debugLog("Failed to encode rift payload for " .. tostring(label))
		return
	end

	local okRequest, response = pcall(function()
		return httpFunc({
			Url = RIFT_INGEST_API_URL,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json",
			},
			Body = encodedBody,
		})
	end)

	if not okRequest then
		debugLog("HTTP request failed for rift " .. tostring(label) .. ": " .. tostring(response))
		return
	end

	local statusCode = response and tonumber(response.StatusCode) or 0
	if statusCode < 200 or statusCode >= 300 then
		debugLog(
			"HTTP status failed for rift " .. tostring(label) ..
			", status=" .. tostring(statusCode) ..
			", body=" .. tostring(response and response.Body)
		)
		return
	end

	debugLog("Rift info sent: " .. tostring(label) .. ", status=" .. tostring(statusCode))
end

local function printRawSnapshot(label, snapshot)
	if typeof(snapshot) ~= "table" then
		warn("[DebugEggsRawJson] " .. label .. " | snapshot is not a table")
		return
	end

	local records = snapshot.Records
	local recordCount = countRecords(records)
	if recordCount < 10 then
		debugLog("Skip dump for " .. tostring(label) .. ": recordCount=" .. tostring(recordCount))
		return
	end

	local payload = {
		label = label,
		snapshot = toJsonSafe(snapshot),
	}

	local ok, encoded = pcall(function()
		return HttpService:JSONEncode(payload)
	end)

	if not ok then
		warn("[DebugEggsRawJson] Failed to encode " .. label)
		return
	end

	print("\n========== [DebugEggs RAW JSON] ==========")
	print(encoded)
	print("=========================================")

	sendRawSnapshot(label, snapshot)
end

local ok, err = pcall(function()
	EggState.FieldRefreshed:Connect(function(snapshot)
		printRawSnapshot("FieldRefreshed", snapshot)
	end)

	local snapshot = EggState.SyncFieldEggs()
	printRawSnapshot("Initial SyncFieldEggs", snapshot)

	sendRiftInfo("RiftInfo")

	local lastRiftPeriod = Rift.CurrentPeriod()
	local lastSpawnAreaId = RiftFlags.SpawnAreaId:Get()
	task.spawn(function()
		while true do
			task.wait(1)
			local newRiftPeriod = Rift.CurrentPeriod()
			if newRiftPeriod ~= lastRiftPeriod then
				lastRiftPeriod = newRiftPeriod
				sendRiftInfo("RiftRotation")
			end

			local newSpawnAreaId = RiftFlags.SpawnAreaId:Get()
			if newSpawnAreaId ~= lastSpawnAreaId then
				lastSpawnAreaId = newSpawnAreaId
				sendRiftInfo("RiftInfo")
			end
		end
	end)
end)

if not ok then
	warn("[DebugEggsRawJson] Failed to initialize: " .. tostring(err))
end
